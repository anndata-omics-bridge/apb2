[importlinter]
root_packages =
    apb2
    anndata_proteomics
include_external_packages = True

[importlinter:contract:declarative-side-stays-declarative]
name = models and documents never touch the computational stack or the legacy package
type = forbidden
source_modules =
    apb2.vendor_parse_rules.model
    apb2.vendor_parse_rules.documents
forbidden_modules =
    pandas
    numpy
    anndata
    anndata_proteomics

[importlinter:contract:anndata-is-a-storage-adapter]
name = the parse strategy never imports a storage backend
type = forbidden
source_modules =
    apb2.parse_quant
forbidden_modules =
    anndata

[importlinter:contract:strategies-never-read-the-configuration]
name = the parse strategies import no schema package, directly or transitively
type = forbidden
# TODO item 9. Every strategy in parse_quant takes ordinary typed values, so neither the
# rule nor the search-parameter evidence can reach it: configure_parse.py translates one into
# the other, and parse_strategy.py is the only module that depends on all three sides.
source_modules =
    apb2.parse_quant
forbidden_modules =
    apb2.vendor_parse_rules
    apb2.vendor_params

[importlinter:contract:declarations-do-not-know-the-strategy]
name = the schema packages never import the parse strategy
type = forbidden
source_modules =
    apb2.vendor_parse_rules
    apb2.vendor_params
forbidden_modules =
    apb2.parse_quant

[importlinter:contract:no-legacy-parser-coupling]
name = apb2 never imports apb's parser machinery
type = forbidden
allow_indirect_imports = True
source_modules =
    apb2
forbidden_modules =
    anndata_proteomics.converters
    anndata_proteomics.vendor_quant_rules
    anndata_proteomics.modifications
    anndata_proteomics.workflows
    anndata_proteomics.adapters
    anndata_proteomics.scripts
