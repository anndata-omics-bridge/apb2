[importlinter]
root_packages =
    apb2
    anndata_proteomics
include_external_packages = True

[importlinter:contract:no-apb-oracle-coupling]
name = production apb2 never imports the external APB parity oracle
type = forbidden
allow_indirect_imports = True
source_modules =
    apb2
forbidden_modules =
    anndata_proteomics

# --------------------------------------------------------------------------- Parser V2
#
# Directory nesting is the import rule, not decoration. A module directly in a package may
# import its children; a child may not import its parent. Sibling dependencies must follow
# the declared DAG, and each child may directly target at most one sibling. Parent modules
# compose children when a responsibility genuinely crosses child boundaries.

[importlinter:contract:parserv2-directory-nesting-is-the-import-rule]
name = parserV2 children follow the declared inward dependency graph
type = layers
exhaustive = True
containers =
    apb2.parserV2
layers =
    conversion_facade
    detect_document
    compile
    parse_rule_facade
    parse_quant | vendor_params | vendor_parse_rules

[importlinter:contract:vendor-parameter-directory-nesting-is-the-import-rule]
name = vendor parameter dispatch descends into its parser package
type = layers
exhaustive = True
containers =
    apb2.parserV2.vendor_params
layers =
    registry
    parsers

[importlinter:contract:vendor-parameter-parsers-descend-into-shared-values]
name = vendor parameter parsers depend only on their shared inward child
type = layers
exhaustive = True
containers =
    apb2.parserV2.vendor_params.parsers
layers =
    alphadia | alphapept | diann | fragpipe | maxquant | metamorpheus | msaid | peaks | sage | spectronaut | wombat
    shared

[importlinter:contract:shared-vendor-parameter-code-is-inward-only]
name = shared vendor parameter parsing descends into model and UniMod values
type = layers
exhaustive = True
containers =
    apb2.parserV2.vendor_params.parsers.shared
layers =
    common
    model | unimod

[importlinter:contract:rule-schema-is-an-inward-child]
name = the rule schema never imports its parent document or loader
type = forbidden
source_modules =
    apb2.parserV2.vendor_parse_rules.schema
forbidden_modules =
    apb2.parserV2.vendor_parse_rules.document
    apb2.parserV2.vendor_parse_rules.loader

[importlinter:contract:parse-quant-directory-nesting-is-the-import-rule]
name = parse_quant modules descend through io into data, with parameters independent
type = layers
exhaustive = True
containers =
    apb2.parserV2.parse_quant
layers =
    (parser) | (decomposition) | (duplicates)
    contracts
    axis_columns | modifications | fragments | delimited_input | parquet_input
    errors
    io
    data | parameters

[importlinter:contract:parse-quant-inward-children-never-import-upward]
name = data and parameters never import a module directly above them
type = forbidden
source_modules =
    apb2.parserV2.parse_quant.data
    apb2.parserV2.parse_quant.parameters
forbidden_modules =
    apb2.parserV2.parse_rule_facade
    apb2.parserV2.compile
    apb2.parserV2.parse_quant.contracts

[importlinter:contract:result-io-depends-on-no-second-child]
name = result io depends on data and never on parameters
type = forbidden
source_modules =
    apb2.parserV2.parse_quant.io
forbidden_modules =
    apb2.parserV2.parse_quant.parameters

[importlinter:contract:parse-quant-computation-holds-no-storage-backend]
name = parsing computation imports no Pydantic, pandas, NumPy, AnnData, or Arrow
type = forbidden
source_modules =
    apb2.parserV2.parse_quant.data
    apb2.parserV2.parse_quant.parameters
    apb2.parserV2.parse_quant.contracts
    apb2.parserV2.parse_quant.errors
forbidden_modules =
    pydantic
    pandas
    numpy
    anndata
    mudata
    pyarrow
    duckdb

[importlinter:contract:result-adapters-see-only-parsed-results]
name = result adapters know data values, io support, and their own backend
type = forbidden
source_modules =
    apb2.parserV2.parse_quant.io.anndata_reader
    apb2.parserV2.parse_quant.io.anndata_writer
    apb2.parserV2.parse_quant.io.parquet_reader
    apb2.parserV2.parse_quant.io.parquet_writer
    apb2.parserV2.parse_quant.io.duckdb
forbidden_modules =
    apb2.parserV2.parse_quant.parser
    apb2.parserV2.parse_quant.contracts
    apb2.parserV2.parse_quant.decomposition
    apb2.parserV2.parse_quant.duplicates
    apb2.parserV2.parse_quant.axis_columns
    apb2.parserV2.parse_quant.modifications
    apb2.parserV2.parse_quant.fragments
    apb2.parserV2.parse_quant.delimited_input
    apb2.parserV2.parse_quant.parquet_input
    apb2.parserV2.parse_quant.data.raw
    apb2.parserV2.parse_quant.data.source
    apb2.parserV2.parse_quant.parameters

[importlinter:contract:readers-see-only-a-source-table]
name = an input adapter knows the source table, its parameters, and its own backend
type = forbidden
source_modules =
    apb2.parserV2.parse_quant.delimited_input
    apb2.parserV2.parse_quant.parquet_input
forbidden_modules =
    apb2.parserV2.parse_quant.parser
    apb2.parserV2.parse_quant.contracts
    apb2.parserV2.parse_quant.decomposition
    apb2.parserV2.parse_quant.duplicates
    apb2.parserV2.parse_quant.axis_columns
    apb2.parserV2.parse_quant.modifications
    apb2.parserV2.parse_quant.fragments
    apb2.parserV2.parse_quant.data.raw
    apb2.parserV2.parse_quant.data.parsed
