repos:
  - repo: local
    hooks:
      - id: ruff-check
        name: Ruff lint
        entry: .venv/bin/ruff check --fix
        language: system
        types: [python]
      - id: ruff-format
        name: Ruff format
        entry: .venv/bin/ruff format
        language: system
        types: [python]
      - id: pyright
        name: Pyright strict
        entry: .venv/bin/pyright
        language: system
        pass_filenames: false
      - id: deptry
        name: Dependency declarations
        entry: .venv/bin/deptry .
        language: system
        pass_filenames: false
      - id: pytest
        name: Pytest
        entry: .venv/bin/pytest -q
        language: system
        pass_filenames: false
        stages: [pre-push]
