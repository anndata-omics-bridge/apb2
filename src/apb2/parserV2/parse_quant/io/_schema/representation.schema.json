{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Aligned": {
      "additionalProperties": false,
      "description": "The schemas of the aligned tables.",
      "properties": {
        "obsm": {
          "items": {
            "$ref": "#/$defs/NamedTable"
          },
          "title": "Obsm",
          "type": "array"
        },
        "varm": {
          "items": {
            "$ref": "#/$defs/NamedTable"
          },
          "title": "Varm",
          "type": "array"
        },
        "obsp": {
          "items": {
            "$ref": "#/$defs/NamedTable"
          },
          "title": "Obsp",
          "type": "array"
        },
        "varp": {
          "items": {
            "$ref": "#/$defs/NamedTable"
          },
          "title": "Varp",
          "type": "array"
        }
      },
      "required": [
        "obsm",
        "varm",
        "obsp",
        "varp"
      ],
      "title": "Aligned",
      "type": "object"
    },
    "AnnotationTable": {
      "additionalProperties": false,
      "description": "An annotation table's schema and metadata.",
      "properties": {
        "row_count": {
          "$ref": "#/$defs/Count"
        },
        "key_columns": {
          "items": {
            "type": "string"
          },
          "title": "Key Columns",
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "title": "Columns",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "row_count",
        "key_columns",
        "columns",
        "name",
        "metadata"
      ],
      "title": "AnnotationTable",
      "type": "object"
    },
    "ApbPart": {
      "additionalProperties": {
        "anyOf": [
          {
            "$ref": "#/$defs/ProducerRecord"
          },
          {
            "$ref": "#/$defs/NonObject"
          }
        ]
      },
      "description": "A level ``apb`` part: APB2's own entries and one record per producer.",
      "properties": {
        "hierarchy": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Hierarchy",
          "type": "object"
        },
        "roles": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Roles",
          "type": "object"
        },
        "layer_descriptors": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Layer Descriptors",
          "type": "object"
        },
        "annotation_tables": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Annotation Tables",
          "type": "object"
        },
        "feature_relations": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Feature Relations",
          "type": "object"
        }
      },
      "title": "ApbPart",
      "type": "object"
    },
    "ApbRoot": {
      "additionalProperties": false,
      "description": "The container's own ``apb`` part.",
      "properties": {
        "apb": {
          "$ref": "#/$defs/RootApbPart"
        }
      },
      "required": [
        "apb"
      ],
      "title": "ApbRoot",
      "type": "object"
    },
    "Artifact": {
      "additionalProperties": false,
      "description": "The scientific artifact this document describes.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "physical_format": {
          "enum": [
            "h5ad",
            "h5mu",
            "parquet",
            "duckdb"
          ],
          "title": "Physical Format",
          "type": "string"
        },
        "size_bytes": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "name",
        "physical_format",
        "size_bytes"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "CategoricalLayer": {
      "additionalProperties": false,
      "description": "A factor layer: category count and known versus missing cells, never statistics.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "role": {
          "enum": [
            "measurement",
            "auxiliary"
          ],
          "title": "Role",
          "type": "string"
        },
        "primary": {
          "title": "Primary",
          "type": "boolean"
        },
        "storage_slot": {
          "enum": [
            "X",
            "layers"
          ],
          "title": "Storage Slot",
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/Shape"
        },
        "unit": {
          "$ref": "#/$defs/JsonScalar"
        },
        "scale": {
          "$ref": "#/$defs/JsonScalar"
        },
        "value_kind": {
          "const": "categorical",
          "title": "Value Kind",
          "type": "string"
        },
        "dtype": {
          "const": "categorical",
          "title": "Dtype",
          "type": "string"
        },
        "category_count": {
          "$ref": "#/$defs/Count"
        },
        "counts": {
          "$ref": "#/$defs/CategoryCounts"
        }
      },
      "required": [
        "name",
        "role",
        "primary",
        "storage_slot",
        "shape",
        "unit",
        "scale",
        "value_kind",
        "dtype",
        "category_count",
        "counts"
      ],
      "title": "CategoricalLayer",
      "type": "object"
    },
    "CategoryCounts": {
      "additionalProperties": false,
      "description": "Cells holding a declared category, and the rest.",
      "properties": {
        "total_count": {
          "$ref": "#/$defs/Count"
        },
        "known_count": {
          "$ref": "#/$defs/Count"
        },
        "missing_or_unknown_count": {
          "$ref": "#/$defs/Count"
        }
      },
      "required": [
        "total_count",
        "known_count",
        "missing_or_unknown_count"
      ],
      "title": "CategoryCounts",
      "type": "object"
    },
    "CheckedEntry": {
      "additionalProperties": false,
      "description": "A summary entry that was checked: fine or needing attention.",
      "properties": {
        "name": {
          "$ref": "#/$defs/Name"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/JsonScalar"
        },
        "unit": {
          "title": "Unit",
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "attention"
          ],
          "title": "Status",
          "type": "string"
        },
        "layer": {
          "title": "Layer",
          "type": "string"
        }
      },
      "required": [
        "name",
        "label",
        "value",
        "unit",
        "status"
      ],
      "title": "CheckedEntry",
      "type": "object"
    },
    "Column": {
      "additionalProperties": false,
      "description": "One table column: its name, null count and Polars dtype.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "null_count": {
          "$ref": "#/$defs/Count"
        },
        "dtype": {
          "title": "Dtype",
          "type": "string"
        }
      },
      "required": [
        "name",
        "null_count",
        "dtype"
      ],
      "title": "Column",
      "type": "object"
    },
    "Count": {
      "minimum": 0,
      "type": "integer"
    },
    "DetailReference": {
      "additionalProperties": false,
      "description": "Where a record's detailed result is stored in the scientific artifact.",
      "properties": {
        "slot": {
          "enum": [
            "varm",
            "layers",
            "annotation_tables",
            "feature_relations"
          ],
          "title": "Slot",
          "type": "string"
        },
        "name": {
          "$ref": "#/$defs/Name"
        }
      },
      "required": [
        "slot",
        "name"
      ],
      "title": "DetailReference",
      "type": "object"
    },
    "FeatureRelation": {
      "additionalProperties": false,
      "description": "A relation from an annotation table to a level's features.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "annotation_table": {
          "title": "Annotation Table",
          "type": "string"
        },
        "target_level": {
          "title": "Target Level",
          "type": "string"
        },
        "coordinates": {
          "$ref": "#/$defs/Table"
        },
        "metadata": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "name",
        "annotation_table",
        "target_level",
        "coordinates",
        "metadata"
      ],
      "title": "FeatureRelation",
      "type": "object"
    },
    "JsonScalar": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "JsonValue": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        },
        {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "object"
        }
      ]
    },
    "Layer": {
      "discriminator": {
        "mapping": {
          "categorical": "#/$defs/CategoricalLayer",
          "quantitative": "#/$defs/QuantitativeLayer"
        },
        "propertyName": "value_kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/QuantitativeLayer"
        },
        {
          "$ref": "#/$defs/CategoricalLayer"
        }
      ]
    },
    "Level": {
      "additionalProperties": false,
      "description": "One quantification level: axes, layers, aligned tables and its ``apb`` part.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "dimensions": {
          "$ref": "#/$defs/Shape"
        },
        "primary_layer": {
          "title": "Primary Layer",
          "type": "string"
        },
        "observations": {
          "$ref": "#/$defs/Observations"
        },
        "obs": {
          "$ref": "#/$defs/Table"
        },
        "var": {
          "$ref": "#/$defs/Table"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "title": "Layers",
          "type": "array"
        },
        "aligned": {
          "$ref": "#/$defs/Aligned"
        },
        "apb": {
          "$ref": "#/$defs/ApbPart"
        }
      },
      "required": [
        "name",
        "dimensions",
        "primary_layer",
        "observations",
        "obs",
        "var",
        "layers",
        "aligned",
        "apb"
      ],
      "title": "Level",
      "type": "object"
    },
    "MassTolerance": {
      "additionalProperties": false,
      "description": "Mass tolerance centered at the theoretical mass.\n\nMass tolerances are physically symmetric: a vendor saying\n``[-20 ppm, 20 ppm]`` and a vendor saying ``20 ppm`` mean the same\nthing \u2014 a \u00b1 half-width around the theoretical peak. APB stores\nonly that half-width as ``value`` plus a ``unit``. Asymmetric\nranges are rejected where they are read; we have not seen a tool\nthat actually means ``[-10 ppm, +30 ppm]`` in earnest.",
      "properties": {
        "value": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "ppm",
                "Da"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "mode": {
          "enum": [
            "absolute",
            "automatic"
          ],
          "title": "Mode",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        }
      },
      "required": [
        "mode"
      ],
      "title": "MassTolerance",
      "type": "object"
    },
    "ModType": {
      "description": "Whether a modification was searched as fixed, variable, or unknown.",
      "enum": [
        "fixed",
        "variable",
        "unknown"
      ],
      "title": "ModType",
      "type": "string"
    },
    "Name": {
      "minLength": 1,
      "type": "string"
    },
    "NamedRecord": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "description": "A record one level below its producer, such as ``catalog.identification_confidence``.",
      "properties": {
        "summary": {
          "items": {
            "$ref": "#/$defs/SummaryEntry"
          },
          "title": "Summary",
          "type": "array"
        },
        "details": {
          "items": {
            "$ref": "#/$defs/DetailReference"
          },
          "title": "Details",
          "type": "array"
        }
      },
      "title": "NamedRecord",
      "type": "object"
    },
    "NamedTable": {
      "additionalProperties": false,
      "description": "An aligned ``obsm``, ``varm``, ``obsp`` or ``varp`` table.",
      "properties": {
        "row_count": {
          "$ref": "#/$defs/Count"
        },
        "key_columns": {
          "items": {
            "type": "string"
          },
          "title": "Key Columns",
          "type": "array"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/Column"
          },
          "title": "Columns",
          "type": "array"
        },
        "name": {
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "row_count",
        "key_columns",
        "columns",
        "name"
      ],
      "title": "NamedTable",
      "type": "object"
    },
    "NonObject": {
      "anyOf": [
        {
          "$ref": "#/$defs/JsonScalar"
        },
        {
          "items": {
            "$ref": "#/$defs/JsonValue"
          },
          "type": "array"
        }
      ]
    },
    "Observation": {
      "additionalProperties": false,
      "description": "One observation identity, referred to by index from layer summaries.",
      "properties": {
        "index": {
          "$ref": "#/$defs/Count"
        },
        "key": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonScalar"
          },
          "title": "Key",
          "type": "object"
        },
        "label": {
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "index",
        "key",
        "label"
      ],
      "title": "Observation",
      "type": "object"
    },
    "ObservationStatistics": {
      "additionalProperties": false,
      "description": "The statistics of one observation's values.",
      "properties": {
        "observation_index": {
          "$ref": "#/$defs/Count"
        },
        "statistics": {
          "$ref": "#/$defs/Statistics"
        }
      },
      "required": [
        "observation_index",
        "statistics"
      ],
      "title": "ObservationStatistics",
      "type": "object"
    },
    "ObservationSummaries": {
      "additionalProperties": false,
      "description": "Per-observation statistics for at most 100 observations.",
      "properties": {
        "total_count": {
          "$ref": "#/$defs/Count"
        },
        "emitted_count": {
          "$ref": "#/$defs/Count"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/ObservationStatistics"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "total_count",
        "emitted_count",
        "truncated",
        "items"
      ],
      "title": "ObservationSummaries",
      "type": "object"
    },
    "Observations": {
      "additionalProperties": false,
      "description": "At most 100 observation identities.",
      "properties": {
        "total_count": {
          "$ref": "#/$defs/Count"
        },
        "emitted_count": {
          "$ref": "#/$defs/Count"
        },
        "truncated": {
          "title": "Truncated",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/Observation"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "total_count",
        "emitted_count",
        "truncated",
        "items"
      ],
      "title": "Observations",
      "type": "object"
    },
    "Parameters": {
      "additionalProperties": false,
      "description": "Proteomics search-parameter record with typed fields.",
      "properties": {
        "software_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software Name"
        },
        "software_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Software Version"
        },
        "quantification_software": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantification Software"
        },
        "quantification_software_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quantification Software Version"
        },
        "acquisition_method": {
          "default": "unknown",
          "enum": [
            "DDA",
            "DIA",
            "unknown"
          ],
          "title": "Acquisition Method",
          "type": "string"
        },
        "search_engine": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Engine"
        },
        "search_engine_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Search Engine Version"
        },
        "ident_fdr_psm": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ident_fdr_peptide": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "ident_fdr_protein": {
          "anyOf": [
            {
              "$ref": "#/$defs/Probability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enable_match_between_runs": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enable Match Between Runs"
        },
        "precursor_mass_tolerance": {
          "anyOf": [
            {
              "$ref": "#/$defs/MassTolerance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "fragment_mass_tolerance": {
          "anyOf": [
            {
              "$ref": "#/$defs/MassTolerance"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enzyme": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Enzyme"
        },
        "semi_enzymatic": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semi Enzymatic"
        },
        "allowed_miscleavages": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Allowed Miscleavages"
        },
        "min_peptide_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Peptide Length"
        },
        "max_peptide_length": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Peptide Length"
        },
        "fixed_mods": {
          "items": {
            "$ref": "#/$defs/SearchedModification"
          },
          "title": "Fixed Mods",
          "type": "array"
        },
        "variable_mods": {
          "items": {
            "$ref": "#/$defs/SearchedModification"
          },
          "title": "Variable Mods",
          "type": "array"
        },
        "max_mods": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Mods"
        },
        "min_precursor_charge": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Precursor Charge"
        },
        "max_precursor_charge": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Precursor Charge"
        },
        "min_precursor_mz": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Precursor Mz"
        },
        "max_precursor_mz": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Precursor Mz"
        },
        "min_fragment_mz": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
