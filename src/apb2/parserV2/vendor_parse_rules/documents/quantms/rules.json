{
  "schema_version": "0.10",
  "file_version": "3",
  "software_name": "quantms",
  "software_version_pattern": "^v?1\\..*",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "sample_annotation": {"matching": {"mode": "exact", "normalize": "mass_spec_basename"}},
  "tables": [
    {
      "input": {"shape": "long", "extensions": [".csv"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "obs": {"type": "string", "required": false},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "axis": {"obs_keys": ["Raw_File"]},
        "measurements": {"repeated_cells": {"mode": "error"}},
        "columns": {
          "obs": [
            {"name": "Raw_File", "source": "Reference", "required": true},
            {"name": "Condition", "source": "Condition"},
            {"name": "Bio_Replicate", "source": "BioReplicate"},
            {"name": "Run", "source": "Run"}
          ]
        },
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "token_regex",
            "token_pattern": "^\\((?P<nterm>[^)]+)\\)|\\((?P<residue>[^)]+)\\)",
            "token_position": "after_residue"
          }
        },
        "modification_maps": {
          "basic_modification_map": {
            "Carbamidomethyl": "UNIMOD:4",
            "Oxidation": "UNIMOD:35",
            "Acetyl": "UNIMOD:1"
          }
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Modified_Sequence", "source": "PeptideSequence"},
              {"name": "Charge", "source": "PrecursorCharge", "type": "integer"},
              {
                "name": "Protein",
                "source": "ProteinName",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Modified_Sequence"],
                "case_sensitive": false,
                "unknown_policy": "preserve",
                "how": "proforma_sequence"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Modified_Sequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Charge"],
                "how": "proforma_ion"
              },
              {
                "name": "apb_Decoy",
                "inputs": ["Protein"],
                "how": "decoy",
                "prefix": "DECOY_",
                "separator": ";"
              },
              {"name": "apb_Contaminant", "how": "unmarked"}
            ]
          }
        }
      }
    }
  ]
}
