{
  "schema_version": "0.11",
  "file_version": "4",
  "software_name": "quantms",
  "software_version_pattern": "^v?1\\..*",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "sample_annotation": {"matching": {"mode": "exact", "normalize": "mass_spec_basename"}},
  "tables": [
    {
      "input": {"shape": "long", "extensions": [".csv"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "obs": {"type": "string", "required": false},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"obs_keys": ["Reference"], "var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Intensity",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              }
            ]
          },
          "columns": {
            "obs": [
              {"name": "Reference", "source": "Reference", "required": true},
              {"name": "Condition", "source": "Condition"},
              {"name": "BioReplicate", "source": "BioReplicate"},
              {"name": "Run", "source": "Run"}
            ],
            "var": [
              {"name": "PeptideSequence", "source": "PeptideSequence"},
              {"name": "PrecursorCharge", "source": "PrecursorCharge", "type": "integer"},
              {
                "name": "ProteinName",
                "source": "ProteinName",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": ["PeptideSequence"],
                "how": "proforma_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["PeptideSequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "PrecursorCharge"],
                "how": "proforma_ion"
              },
              {
                "name": "apb_Decoy",
                "inputs": ["ProteinName"],
                "how": "decoy",
                "prefix": "DECOY_",
                "separator": ";"
              },
              {"name": "apb_Contaminant", "how": "unmarked"}
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "^\\((?P<nterm>[^)]+)\\)|\\((?P<residue>[^)]+)\\)",
              "token_position": "after_residue"
            }
          },
          "modification_map": {
            "Carbamidomethyl": "UNIMOD:4",
            "Oxidation": "UNIMOD:35",
            "Acetyl": "UNIMOD:1"
          }
        }
      }
    }
  ]
}
