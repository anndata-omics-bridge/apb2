{
  "schema_version": "0.4",
  "file_version": "2",
  "software_name": "MaxQuant",
  "software_version_pattern": "^(1\\.5|1\\.6|2\\.)",
  "input": {
    "shape": "long",
    "extensions": [
      ".txt"
    ],
    "file_name": "evidence.txt"
  },
  "base": {
    "axis": {
      "obs_keys": [
        "Raw_File"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "aggregate"
      }
    },
    "columns": {
      "obs": [
        {
          "name": "Raw_File",
          "source": "Raw file"
        },
        {
          "name": "Experiment",
          "source": "Experiment",
          "required": false
        },
        {
          "name": "Fraction",
          "source": "Fraction",
          "required": false
        }
      ]
    },
    "modifications": {
      "source_column": "Modified sequence",
      "parser": "token_regex",
      "token_pattern": "\\(([^()]*(?:\\([^()]*\\)[^()]*)*)\\)",
      "token_position": "after_residue",
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "ac",
          "accession": "UNIMOD:1"
        },
        {
          "token": "ox",
          "accession": "UNIMOD:35"
        },
        {
          "token": "Acetyl (Protein N-term)",
          "accession": "UNIMOD:1"
        },
        {
          "token": "Oxidation (M)",
          "accession": "UNIMOD:35"
        },
        {
          "token": "Carbamidomethyl (C)",
          "accession": "UNIMOD:4"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity",
        "layers": [
          {
            "name": "Intensity",
            "source": "Intensity"
          },
          {
            "name": "MS_MS_Count",
            "source": "MS/MS count"
          },
          {
            "name": "Retention_Time",
            "source": "Retention time"
          },
          {
            "name": "Score",
            "source": "Score"
          },
          {
            "name": "PEP",
            "source": "PEP"
          }
        ]
      },
      "columns": {
        "var": [
          {
            "name": "Sequence",
            "source": "Sequence"
          },
          {
            "name": "Modified_Sequence",
            "source": "Modified sequence"
          },
          {
            "name": "Modifications",
            "source": "Modifications"
          },
          {
            "name": "Charge",
            "source": "Charge",
            "type": "integer"
          },
          {
            "name": "Mass",
            "source": "Mass",
            "type": "number"
          },
          {
            "name": "Proteins",
            "source": "Proteins",
            "roles": [
              "protein_assignment",
              "fasta_accessions"
            ],
            "inputs": [
              "Proteins",
              "Leading_Proteins",
              "Leading_Proteins_Legacy"
            ],
            "how": "coalesce"
          },
          {
            "name": "Leading_Proteins",
            "source": "Leading proteins",
            "required": false
          },
          {
            "name": "Leading_Razor_Protein",
            "source": "Leading razor protein",
            "required": false
          },
          {
            "name": "Leading_Proteins_Legacy",
            "source": "Leading Proteins",
            "required": false
          },
          {
            "name": "Leading_Razor_Protein_Legacy",
            "source": "Leading Razor Protein",
            "required": false
          },
          {
            "name": "ProForma_peptidoform",
            "inputs": [
              "Modified_Sequence"
            ],
            "how": "proforma_sequence"
          },
          {
            "name": "ProForma_peptide",
            "inputs": [
              "Modified_Sequence"
            ],
            "how": "stripped_sequence"
          },
          {
            "name": "ProForma_ion",
            "inputs": [
              "ProForma_peptidoform",
              "Charge"
            ],
            "how": "proforma_ion"
          }
        ]
      }
    }
  }
}
