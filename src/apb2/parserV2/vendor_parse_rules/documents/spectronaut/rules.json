{
  "schema_version": "0.3",
  "file_version": "2",
  "software_name": "Spectronaut",
  "software_version_pattern": "^(19|20)\\..*",
  "input": {
    "shape": "long",
    "extensions": [
      ".tsv"
    ],
    "delimiter": {
      "mode": "detect",
      "candidates": [
        "\t",
        ";",
        ","
      ]
    },
    "numbers": {
      "mode": "detect",
      "decimal_candidates": [
        ".",
        ","
      ],
      "thousands_candidates": [
        ",",
        ".",
        " "
      ]
    }
  },
  "base": {
    "axis": {
      "obs_keys": [
        "R_FileName"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    },
    "modifications": {
      "source_column": "EG.ModifiedSequence",
      "parser": "token_regex",
      "token_pattern": "\\[([^\\[\\]]+)\\]",
      "token_position": "after_residue",
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "Acetyl (Protein N-term)",
          "accession": "UNIMOD:1"
        },
        {
          "token": "Oxidation (M)",
          "accession": "UNIMOD:35"
        },
        {
          "token": "Carbamidomethyl (C)",
          "accession": "UNIMOD:4"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "FG_Quantity",
        "layers": [
          {
            "name": "FG_Quantity",
            "source": "FG.Quantity"
          },
          {
            "name": "EG_MaxChannelQvalue",
            "source": "EG.MaxChannelQvalue"
          },
          {
            "name": "EG_MinChannelQvalue",
            "source": "EG.MinChannelQvalue"
          },
          {
            "name": "EG_PEP",
            "source": "EG.PEP"
          },
          {
            "name": "EG_Qvalue",
            "source": "EG.Qvalue",
            "required": true
          },
          {
            "name": "EG_IsUserPeak",
            "source": "EG.IsUserPeak"
          },
          {
            "name": "FG_PrecMzCalibrated",
            "source": "FG.PrecMzCalibrated"
          },
          {
            "name": "FG_CScore",
            "source": "FG.CScore"
          },
          {
            "name": "FG_Qvalue",
            "source": "FG.Qvalue",
            "required": true
          },
          {
            "name": "EG_ApexRT",
            "source": "EG.ApexRT"
          },
          {
            "name": "EG_iRTEmpirical",
            "source": "EG.iRTEmpirical"
          },
          {
            "name": "EG_RTPredicted",
            "source": "EG.RTPredicted"
          },
          {
            "name": "EG_IsImputed",
            "source": "EG.IsImputed"
          },
          {
            "name": "EG_ReferenceQuantity_Settings",
            "source": "EG.ReferenceQuantity (Settings)"
          },
          {
            "name": "EG_TargetQuantity_Settings",
            "source": "EG.TargetQuantity (Settings)"
          },
          {
            "name": "EG_TotalQuantity_Settings",
            "source": "EG.TotalQuantity (Settings)"
          },
          {
            "name": "EG_UsedForPeptideQuantity",
            "source": "EG.UsedForPeptideQuantity"
          },
          {
            "name": "EG_UsedForProteinGroupQuantity",
            "source": "EG.UsedForProteinGroupQuantity"
          },
          {
            "name": "EG_Cscore",
            "source": "EG.Cscore"
          },
          {
            "name": "EG_NormalizedCscore",
            "source": "EG.NormalizedCscore"
          }
        ]
      },
      "columns": {
        "obs": {
          "select": {
            "E_Errors": "E.Errors",
            "E_LFQMethod": "E.LFQMethod",
            "E_Warnings": "E.Warnings",
            "R_FileName": "R.FileName",
            "R_Condition": "R.Condition",
            "R_Fraction": "R.Fraction",
            "R_Replicate": "R.Replicate",
            "R_Label": "R.Label"
          }
        },
        "var": {
          "select": {
            "PG_GroupLabel": "PG.GroupLabel",
            "PG_ProteinAccessions": "PG.ProteinAccessions",
            "PG_ProteinGroups": "PG.ProteinGroups",
            "PEP_GroupingKey": "PEP.GroupingKey",
            "PEP_GroupingKeyType": "PEP.GroupingKeyType",
            "PEP_StrippedSequence": "PEP.StrippedSequence",
            "EG_ModifiedSequence": "EG.ModifiedSequence",
            "EG_ModifiedPeptide": "EG.ModifiedPeptide",
            "EG_IntPIMID": "EG.IntPIMID",
            "EG_UserGroup": "EG.UserGroup",
            "EG_Workflow": "EG.Workflow",
            "EG_IsDecoy": "EG.IsDecoy",
            "EG_iRTPredicted": "EG.iRTPredicted",
            "EG_AvgProfileQvalue": "EG.AvgProfileQvalue",
            "EG_MaxProfileQvalue": "EG.MaxProfileQvalue",
            "EG_MinProfileQvalue": "EG.MinProfileQvalue",
            "EG_PercentileQvalue": "EG.PercentileQvalue",
            "FG_Charge": "FG.Charge",
            "FG_IntMID": "FG.IntMID",
            "FG_LabeledSequence": "FG.LabeledSequence",
            "FG_Mass": "FG.Mass",
            "FG_PrecMz": "FG.PrecMz",
            "FG_XICDBID": "FG.XICDBID"
          },
          "types": {
            "EG_IsDecoy": "boolean",
            "EG_iRTPredicted": "number",
            "EG_AvgProfileQvalue": "number",
            "EG_MaxProfileQvalue": "number",
            "EG_MinProfileQvalue": "number",
            "EG_PercentileQvalue": "number",
            "FG_Charge": "integer",
            "FG_Mass": "number",
            "FG_PrecMz": "number"
          },
          "computed": [
            {
              "name": "ProForma_peptidoform",
              "inputs": [
                "EG_ModifiedSequence"
              ],
              "how": "proforma_sequence"
            },
            {
              "name": "ProForma_peptide",
              "inputs": [
                "EG_ModifiedSequence"
              ],
              "how": "stripped_sequence"
            },
            {
              "name": "ProForma_ion",
              "inputs": [
                "ProForma_peptidoform",
                "FG_Charge"
              ],
              "how": "proforma_ion"
            }
          ]
        }
      },
      "column_roles": {
        "protein_assignment": "PG_ProteinGroups",
        "fasta_accessions": "PG_ProteinAccessions"
      }
    },
    "fragment": {
      "axis": {
        "var_keys": [
          "EG_PrecursorId",
          "F_FrgIon",
          "F_Charge",
          "F_FrgLossType",
          "F_FrgType",
          "F_FrgNum"
        ]
      },
      "measurements": {
        "primary_layer": "F_PeakArea",
        "layers": [
          {
            "name": "F_PeakArea",
            "source": "F.PeakArea"
          },
          {
            "name": "F_FrgMz",
            "source": "F.FrgMz"
          },
          {
            "name": "F_TheoreticalMz",
            "source": "F.TheoreticalMz"
          }
        ]
      },
      "columns": {
        "obs": {
          "select": {
            "R_FileName": "R.FileName",
            "R_Condition": "R.Condition"
          }
        },
        "var": {
          "select": {
            "PG_ProteinGroups": "PG.ProteinGroups",
            "PG_ProteinAccessions": "PG.ProteinAccessions",
            "PEP_StrippedSequence": "PEP.StrippedSequence",
            "EG_ModifiedSequence": "EG.ModifiedSequence",
            "EG_PrecursorId": "EG.PrecursorId",
            "FG_Charge": "FG.Charge",
            "F_FrgIon": "F.FrgIon",
            "F_Charge": "F.Charge",
            "F_FrgLossType": "F.FrgLossType",
            "F_FrgType": "F.FrgType",
            "F_FrgNum": "F.FrgNum",
            "F_FrgMz": "F.FrgMz",
            "F_TheoreticalMz": "F.TheoreticalMz"
          },
          "types": {
            "FG_Charge": "integer",
            "F_Charge": "integer",
            "F_FrgNum": "integer",
            "F_FrgMz": "number",
            "F_TheoreticalMz": "number"
          },
          "computed": [
            {
              "name": "ProForma_peptidoform",
              "inputs": [
                "EG_ModifiedSequence"
              ],
              "how": "proforma_sequence"
            },
            {
              "name": "ProForma_peptide",
              "inputs": [
                "EG_ModifiedSequence"
              ],
              "how": "stripped_sequence"
            },
            {
              "name": "ProForma_ion",
              "inputs": [
                "ProForma_peptidoform",
                "FG_Charge"
              ],
              "how": "proforma_ion"
            }
          ]
        }
      },
      "column_roles": {
        "protein_assignment": "PG_ProteinGroups",
        "fasta_accessions": "PG_ProteinAccessions"
      }
    },
    "protein": {
      "axis": {
        "var_keys": [
          "PG_ProteinGroups"
        ]
      },
      "measurements": {
        "primary_layer": "PG_Quantity",
        "duplicates": {
          "mode": "keep_first"
        },
        "layers": [
          {
            "name": "PG_Quantity",
            "source": "PG.Quantity"
          },
          {
            "name": "PG_Cscore_Run_Wise",
            "source": "PG.Cscore (Run-Wise)"
          },
          {
            "name": "PG_PEP_Run_Wise",
            "source": "PG.PEP (Run-Wise)"
          },
          {
            "name": "PG_PValue_Run_Wise",
            "source": "PG.PValue (Run-Wise)"
          },
          {
            "name": "PG_QValue_Run_Wise",
            "source": "PG.QValue (Run-Wise)"
          },
          {
            "name": "PG_RunEvidenceCount",
            "source": "PG.RunEvidenceCount"
          }
        ]
      },
      "columns": {
        "obs": {
          "select": {
            "E_Errors": "E.Errors",
            "E_LFQMethod": "E.LFQMethod",
            "E_Warnings": "E.Warnings",
            "R_FileName": "R.FileName",
            "R_Condition": "R.Condition",
            "R_Fraction": "R.Fraction",
            "R_Replicate": "R.Replicate",
            "R_Label": "R.Label"
          }
        },
        "var": {
          "select": {
            "PG_GroupLabel": "PG.GroupLabel",
            "PG_ProteinAccessions": "PG.ProteinAccessions",
            "PG_ProteinGroups": "PG.ProteinGroups",
            "PG_Cscore": "PG.Cscore",
            "PG_PEP": "PG.PEP",
            "PG_Pvalue": "PG.Pvalue",
            "PG_Qvalue": "PG.Qvalue"
          },
          "types": {
            "PG_Cscore": "number",
            "PG_PEP": "number",
            "PG_Pvalue": "number",
            "PG_Qvalue": "number"
          }
        }
      },
      "column_roles": {
        "protein_assignment": "PG_ProteinGroups",
        "fasta_accessions": "PG_ProteinAccessions"
      }
    }
  }
}
