{
  "schema_version": "0.11",
  "file_version": "5",
  "software_name": "Spectronaut",
  "software_version_pattern": "^15\\..*",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "tables": [
    {
      "input": {
        "shape": "long",
        "extensions": [".tsv"],
        "delimiter": {"mode": "detect", "candidates": ["\t", ";", ","]},
        "numbers": {
          "mode": "detect",
          "decimal_candidates": [".", ","],
          "thousands_candidates": [",", ".", " "]
        },
        "encoding": {"mode": "detect", "candidates": ["utf8", "windows-1252"]},
        "without_parameter_file": {
          "forbidden_columns": ["E.Errors", "EG.LibraryQvalue"],
          "acquisition_method": {"otherwise": "unknown"}
        }
      },
      "base": {
        "defaults": {
          "var": {"type": "string", "required": false, "per_feature": "first"},
          "obs": {"type": "string", "required": false},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "axis": {"obs_keys": ["Run"]},
        "columns": {
          "obs": [
            {"name": "R_Label", "source": "R.Label"},
            {"name": "R_FileName", "source": "R.FileName"},
            {"name": "Run", "inputs": ["R_Label", "R_FileName"], "how": "coalesce"}
          ],
          "var": [
            {
              "name": "PG_ProteinGroups",
              "source": "PG.ProteinGroups",
              "required": true,
              "roles": ["protein_assignment", "fasta_accessions"]
            },
            {"name": "PG_Genes", "source": "PG.Genes"},
            {"name": "EG_IsDecoy", "source": "EG.IsDecoy", "type": "boolean"},
            {"name": "apb_Decoy", "inputs": ["EG_IsDecoy"], "how": "decoy", "equals": "true"},
            {"name": "apb_Contaminant", "how": "unmarked"}
          ]
        },
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "token_regex",
            "token_pattern": "^\\[(?P<nterm>[^\\[\\]]+)\\]|\\[(?P<residue>[^\\[\\]]+)\\]",
            "token_position": "after_residue"
          }
        },
        "modification_map": {
          "Acetyl (Protein N-term)": "UNIMOD:1",
          "Oxidation (M)": "UNIMOD:35",
          "Carbamidomethyl (C)": "UNIMOD:4",
          "Deamidation (NQ)": "UNIMOD:7"
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "FG_Quantity",
            "repeated_cells": {"mode": "same"},
            "layers": [
              {
                "name": "FG_Quantity",
                "source": "FG.Quantity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "EG_Qvalue", "source": "EG.Qvalue", "required": true},
              {"name": "EG_PEP", "source": "EG.PEP"},
              {"name": "EG_Pvalue", "source": "EG.Pvalue"},
              {"name": "EG_Cscore", "source": "EG.Cscore"},
              {"name": "EG_ApexRT", "source": "EG.ApexRT"},
              {"name": "EG_StartRT", "source": "EG.StartRT"},
              {"name": "EG_EndRT", "source": "EG.EndRT"},
              {"name": "EG_FWHM", "source": "EG.FWHM"},
              {"name": "EG_PeakWidth", "source": "EG.PeakWidth"},
              {"name": "EG_StartiRT", "source": "EG.StartiRT"},
              {"name": "EG_EndiRT", "source": "EG.EndiRT"},
              {"name": "EG_FWHM_iRT", "source": "EG.FWHM (iRT)"},
              {
                "name": "EG_MeanApexRT",
                "source": "EG.MeanApexRT",
                "note": "A layer: differs between runs for the same precursor"
              },
              {"name": "EG_iRTEmpirical", "source": "EG.iRTEmpirical"},
              {"name": "EG_RTPredicted", "source": "EG.RTPredicted"},
              {"name": "EG_IsImputed", "source": "EG.IsImputed"},
              {
                "name": "EG_TargetQuantity_Settings",
                "source": "EG.TargetQuantity (Settings)",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "EG_TotalQuantity_Settings",
                "source": "EG.TotalQuantity (Settings)",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "EG_UsedForPeptideQuantity", "source": "EG.UsedForPeptideQuantity"},
              {
                "name": "EG_UsedForProteinGroupQuantity",
                "source": "EG.UsedForProteinGroupQuantity"
              },
              {
                "name": "FG_MS1RawQuantity",
                "source": "FG.MS1RawQuantity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "FG_MS2RawQuantity",
                "source": "FG.MS2RawQuantity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "FG_SignalToNoise", "source": "FG.SignalToNoise"},
              {"name": "FG_ShapeQualityScore", "source": "FG.ShapeQualityScore"}
            ]
          },
          "columns": {
            "var": [
              {"name": "EG_ModifiedSequence", "source": "EG.ModifiedSequence", "required": true},
              {"name": "FG_Charge", "source": "FG.Charge", "type": "integer", "required": true},
              {"name": "PG_Organisms", "source": "PG.Organisms"},
              {"name": "PEP_StrippedSequence", "source": "PEP.StrippedSequence"},
              {"name": "PEP_IsProteotypic", "source": "PEP.IsProteotypic", "type": "boolean"},
              {
                "name": "PEP_IsProteinGroupSpecific",
                "source": "PEP.IsProteinGroupSpecific",
                "type": "boolean"
              },
              {"name": "PEP_NrOfMissedCleavages", "source": "PEP.NrOfMissedCleavages"},
              {"name": "EG_iRTPredicted", "source": "EG.iRTPredicted", "type": "number"},
              {"name": "EG_AvgProfileQvalue", "source": "EG.AvgProfileQvalue", "type": "number"},
              {"name": "EG_MaxProfileQvalue", "source": "EG.MaxProfileQvalue", "type": "number"},
              {"name": "EG_MinProfileQvalue", "source": "EG.MinProfileQvalue", "type": "number"},
              {"name": "EG_PercentileQvalue", "source": "EG.PercentileQvalue", "type": "number"},
              {"name": "FG_Id", "source": "FG.Id"},
              {"name": "FG_PrecMz", "source": "FG.PrecMz", "type": "number"},
              {"name": "FG_FragmentCount", "source": "FG.FragmentCount"},
              {
                "name": "ProForma_peptidoform",
                "inputs": ["EG_ModifiedSequence"],
                "how": "proforma_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["EG_ModifiedSequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "FG_Charge"],
                "how": "proforma_ion"
              }
            ]
          }
        },
        "peptidoform_fragment": {
          "axis": {"var_keys": ["FG_Id", "F_FrgIon", "F_Charge", "F_FrgLossType"]},
          "measurements": {
            "primary_layer": "F_PeakArea",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {
                "name": "F_PeakArea",
                "source": "F.PeakArea",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "F_PeakHeight",
                "source": "F.PeakHeight",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "F_InterferenceScore", "source": "F.InterferenceScore"}
            ]
          },
          "columns": {
            "var": [
              {"name": "EG_ModifiedSequence", "source": "EG.ModifiedSequence", "required": true},
              {"name": "FG_Id", "source": "FG.Id", "required": true},
              {"name": "FG_Charge", "source": "FG.Charge", "type": "integer", "required": true},
              {"name": "F_FrgIon", "source": "F.FrgIon", "required": true},
              {"name": "F_Charge", "source": "F.Charge", "type": "integer", "required": true},
              {"name": "F_FrgLossType", "source": "F.FrgLossType", "required": true},
              {"name": "PEP_StrippedSequence", "source": "PEP.StrippedSequence"},
              {"name": "F_Rank", "source": "F.Rank"},
              {"name": "F_ExcludedFromQuantification", "source": "F.ExcludedFromQuantification"},
              {
                "name": "ProForma_peptidoform",
                "inputs": ["EG_ModifiedSequence"],
                "how": "proforma_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["EG_ModifiedSequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "FG_Charge"],
                "how": "proforma_ion"
              }
            ]
          }
        },
        "protein": {
          "axis": {"var_keys": ["PG_ProteinGroups"]},
          "measurements": {
            "primary_layer": "PG_Quantity",
            "repeated_cells": {"mode": "same"},
            "layers": [
              {
                "name": "PG_Quantity",
                "source": "PG.Quantity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              }
            ]
          },
          "columns": {"var": [{"name": "PG_Organisms", "source": "PG.Organisms"}]}
        }
      }
    }
  ]
}
