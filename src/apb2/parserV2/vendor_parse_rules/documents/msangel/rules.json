{
  "hierarchy": "lfq",
  "schema_version": "0.9",
  "file_version": "2",
  "software_name": "MSAngel",
  "software_version_pattern": "^2\\..*",
  "tables": [
    {
      "input": {
        "shape": "wide",
        "extensions": [
          ".txt",
          ".xlsx"
        ]
      },
      "prepare": {
        "how": "msangel"
      },
      "base": {
        "axis": {
          "obs_keys": [
            "sample"
          ]
        },
        "measurements": {
          "duplicates": {
            "mode": "keep_first"
          }
        },
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "embedded_site_list",
            "delimiter": ";",
            "entry_pattern": "^(?P<token>.+?)\\s+\\((?P<site>[^)]+)\\)$",
            "site_base": 1
          },
          "plain_sequence": {
            "parser": "plain_sequence"
          }
        },
        "modification_maps": {
          "basic_modification_map": [
            {
              "token": "Carbamidomethyl",
              "accession": "UNIMOD:4"
            },
            {
              "token": "Oxidation",
              "accession": "UNIMOD:35"
            },
            {
              "token": "Acetyl",
              "accession": "UNIMOD:1"
            }
          ]
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {
            "var_keys": [
              "ProForma_ion"
            ]
          },
          "measurements": {
            "primary_layer": "Abundance",
            "layers": [
              {
                "name": "Abundance",
                "source": "^peptidoform_ion\\.abundance_(?:DDA_)?(?P<sample>.+)$",
                "roles": [
                  "abundance"
                ],
                "missing_values": [
                  "<=0"
                ]
              },
              {
                "name": "Raw_Abundance",
                "source": "^peptidoform_ion\\.raw_abundance_(?:DDA_)?(?P<sample>.+)$",
                "required": true,
                "roles": [
                  "abundance"
                ],
                "missing_values": [
                  "<=0"
                ]
              },
              {
                "name": "Best_Score",
                "source": "^peptidoform_ion\\.best_score_(?:DDA_)?(?P<sample>.+)$"
              },
              {
                "name": "PSM_Count",
                "source": "^peptidoform_ion\\.psm_count_(?:DDA_)?(?P<sample>.+)$",
                "type": "integer"
              },
              {
                "name": "Elution_Time",
                "source": "^peptidoform_ion\\.elution_time_(?:DDA_)?(?P<sample>.+)$"
              },
              {
                "name": "Corrected_Time",
                "source": "^peptidoform_ion\\.corrected_time_(?:DDA_)?(?P<sample>.+)$"
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Sequence",
                "source": "peptidoform_ion.sequence"
              },
              {
                "name": "Modifications",
                "source": "peptidoform_ion.modifications"
              },
              {
                "name": "Charge",
                "source": "peptidoform_ion.master_quant_peptide_ion_charge",
                "type": "integer"
              },
              {
                "name": "Protein_Set_Score",
                "source": "peptidoform_ion.protein_set_score",
                "type": "number",
                "duplicates": {
                  "mode": "max"
                },
                "note": "Proline's score of the protein set a row lists the ion under; a shared peptide has one row per set, and the ion keeps its best set's score"
              },
              {
                "name": "Master_Ion_Elution_Time",
                "source": "peptidoform_ion.master_quant_peptide_ion_elution_time",
                "type": "number",
                "required": false,
                "note": "The master ion's elution time on the aligned time scale, one value per ion: it lies within seconds of the median of the per-run corrected_time values"
              },
              {
                "name": "Master_Elution_Time",
                "source": "peptidoform_ion.master_elution_time",
                "type": "number",
                "required": false,
                "note": "One value per ion, minutes from Master_Ion_Elution_Time and close to the earliest run's elution_time; Proline does not document which time it is"
              },
              {
                "name": "Same_Set_Proteins",
                "source": "peptidoform_ion.samesets_accessions",
                "roles": [
                  "protein_assignment"
                ],
                "duplicates": {
                  "mode": "keep_best",
                  "by": "Protein_Set_Score"
                },
                "note": "The ion's protein set: of the sets a shared peptide is listed under, the one with the highest protein_set_score; the same string identifies the set on every sheet"
              },
              {
                "name": "Subset_Proteins",
                "source": "peptidoform_ion.subsets_accessions",
                "required": false,
                "duplicates": {
                  "mode": "keep_best",
                  "by": "Protein_Set_Score"
                },
                "note": "Subset proteins of the ion's protein set that contain this peptide, from the same row; differs between the peptides of one set"
              },
              {
                "name": "Proteins",
                "inputs": [
                  "Same_Set_Proteins",
                  "Subset_Proteins"
                ],
                "separator": ";",
                "how": "join_nonempty",
                "roles": [
                  "fasta_accessions"
                ],
                "note": "Accessions of the ion's protein set that contain this peptide"
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": [
                  "Sequence",
                  "Modifications"
                ],
                "how": "proforma_sequence",
                "syntax": "vendor_sequence",
                "modification_map": "basic_modification_map",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": [
                  "Sequence"
                ],
                "how": "stripped_sequence",
                "syntax": "plain_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": [
                  "ProForma_peptidoform",
                  "Charge"
                ],
                "how": "proforma_ion"
              },
              {
                "name": "apb_Decoy",
                "how": "decoy"
              },
              {
                "name": "apb_Contaminant",
                "how": "contaminant"
              }
            ]
          }
        },
        "protein": {
          "axis": {
            "var_keys": [
              "Same_Set_Proteins"
            ]
          },
          "measurements": {
            "primary_layer": "Abundance",
            "layers": [
              {
                "name": "Abundance",
                "source": "^protein\\.abundance_(?:DDA_)?(?P<sample>.+)$",
                "roles": [
                  "abundance"
                ],
                "missing_values": [
                  "<=0"
                ]
              },
              {
                "name": "Raw_Abundance",
                "source": "^protein\\.raw_abundance_(?:DDA_)?(?P<sample>.+)$",
                "roles": [
                  "abundance"
                ],
                "missing_values": [
                  "<=0"
                ]
              },
              {
                "name": "PSM_Count",
                "source": "^protein\\.psm_count_(?:DDA_)?(?P<sample>.+)$",
                "type": "integer"
              },
              {
                "name": "Peptides_Count",
                "source": "^protein\\.peptides_count_(?:DDA_)?(?P<sample>.+)$",
                "type": "integer"
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Same_Set_Proteins",
                "source": "protein.samesets_accessions",
                "roles": [
                  "protein_assignment"
                ],
                "note": "Identifies the protein set one-to-one; the peptidoform-ion level assigns each ion this string"
              },
              {
                "name": "Subset_Proteins",
                "source": "protein.subsets_accessions",
                "required": false
              },
              {
                "name": "Proteins",
                "inputs": [
                  "Same_Set_Proteins",
                  "Subset_Proteins"
                ],
                "separator": ";",
                "how": "join_nonempty",
                "roles": [
                  "fasta_accessions"
                ],
                "note": "Every member of the protein set: its same-set and subset proteins"
              },
              {
                "name": "Protein_Set_Id",
                "source": "protein.protein_set_id",
                "type": "integer"
              },
              {
                "name": "Accession",
                "source": "protein.accession"
              },
              {
                "name": "Gene_Name",
                "source": "protein.gene_name",
                "required": false
              },
              {
                "name": "Description",
                "source": "protein.description",
                "required": false
              },
              {
                "name": "Protein_Set_Score",
                "source": "protein.protein_set_score",
                "type": "number"
              },
              {
                "name": "apb_Decoy",
                "how": "decoy"
              },
              {
                "name": "apb_Contaminant",
                "how": "contaminant"
              }
            ]
          }
        }
      }
    }
  ]
}
