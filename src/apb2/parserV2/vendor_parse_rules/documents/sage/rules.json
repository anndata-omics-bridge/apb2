{
  "schema_version": "0.11",
  "file_version": "5",
  "software_name": "Sage",
  "software_version_pattern": "^0\\.",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "tables": [
    {
      "input": {"shape": "wide", "extensions": [".tsv"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "axis": {"obs_keys": ["sample"]},
        "measurements": {
          "repeated_cells": {"mode": "error"},
          "layers": [
            {
              "name": "Intensity",
              "source": "^(?P<sample>.+)\\.(?:mzML|mzml|mzML\\.gz|mzml\\.gz|mgf|raw|d)$",
              "roles": ["abundance"],
              "missing_values": ["<=0"]
            }
          ]
        },
        "columns": {
          "var": [
            {"name": "peptide", "source": "peptide"},
            {
              "name": "proteins",
              "source": "proteins",
              "roles": ["protein_assignment", "fasta_accessions"]
            },
            {"name": "q_value", "source": "q_value", "type": "number"},
            {"name": "score", "source": "score", "type": "number"},
            {"name": "spectral_angle", "source": "spectral_angle", "type": "number"},
            {
              "name": "ProForma_peptidoform",
              "inputs": ["peptide"],
              "how": "proforma_sequence",
              "case_sensitive": false,
              "unknown_policy": "preserve"
            },
            {"name": "ProForma_peptide", "inputs": ["peptide"], "how": "stripped_sequence"},
            {
              "name": "apb_Decoy",
              "inputs": ["proteins"],
              "how": "decoy",
              "prefix": "rev_",
              "separator": ";"
            },
            {"name": "apb_Contaminant", "how": "unmarked"}
          ]
        },
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "token_regex",
            "token_pattern": "^\\[(?P<nterm>[^\\]]+)\\]-|-\\[(?P<cterm>[^\\]]+)\\]$|\\[(?P<residue>[^\\]]+)\\]",
            "token_position": "after_residue"
          }
        },
        "modification_map": {
          "+57.021465": "UNIMOD:4",
          "+15.994915": "UNIMOD:35",
          "+42.010567": "UNIMOD:1",
          "+42": "UNIMOD:1"
        }
      },
      "levels": {
        "peptidoform_ion": {
          "requires_search_parameters": {"combine_charge_states": false},
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {"primary_layer": "Intensity"},
          "columns": {
            "var": [
              {"name": "charge", "source": "charge", "type": "integer"},
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "charge"],
                "how": "proforma_ion"
              }
            ]
          }
        },
        "peptidoform": {
          "requires_search_parameters": {"combine_charge_states": true},
          "axis": {"var_keys": ["ProForma_peptidoform"]},
          "measurements": {"primary_layer": "Intensity"}
        }
      }
    }
  ]
}
