{
  "schema_version": "0.4",
  "file_version": "2",
  "software_name": "Sage",
  "software_version_pattern": "^0\\.",
  "input": {
    "shape": "wide",
    "extensions": [
      ".tsv"
    ]
  },
  "base": {
    "axis": {
      "obs_keys": [
        "sample"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      },
      "layers": [
        {
          "name": "Intensity",
          "source": "^(?P<sample>.+)\\.(?:mzML|mzml|mzML\\.gz|mzml\\.gz|mgf|raw|d)$",
          "roles": [
            "abundance"
          ],
          "missing_values": [
            0
          ]
        }
      ]
    },
    "columns": {
      "var": [
        {
          "name": "Peptide",
          "source": "peptide"
        },
        {
          "name": "Proteins",
          "source": "proteins",
          "roles": [
            "protein_assignment",
            "fasta_accessions"
          ]
        },
        {
          "name": "Q_Value",
          "source": "q_value",
          "type": "number"
        },
        {
          "name": "Score",
          "source": "score",
          "type": "number"
        },
        {
          "name": "Spectral_Angle",
          "source": "spectral_angle",
          "type": "number"
        },
        {
          "name": "ProForma_peptidoform",
          "inputs": [
            "Peptide"
          ],
          "how": "proforma_sequence"
        },
        {
          "name": "ProForma_peptide",
          "inputs": [
            "Peptide"
          ],
          "how": "stripped_sequence"
        }
      ]
    },
    "modifications": {
      "source_column": "peptide",
      "parser": "token_regex",
      "token_pattern": "\\[([^\\]]+)\\]",
      "token_position": "after_residue",
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "+57.021465",
          "accession": "UNIMOD:4"
        },
        {
          "token": "+15.994915",
          "accession": "UNIMOD:35"
        },
        {
          "token": "+42.010567",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "requires_search_parameters": {
        "combine_charge_states": false
      },
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity"
      },
      "columns": {
        "var": [
          {
            "name": "Charge",
            "source": "charge",
            "type": "integer"
          },
          {
            "name": "ProForma_ion",
            "inputs": [
              "ProForma_peptidoform",
              "Charge"
            ],
            "how": "proforma_ion"
          }
        ]
      }
    },
    "peptidoform": {
      "requires_search_parameters": {
        "combine_charge_states": true
      },
      "axis": {
        "var_keys": [
          "ProForma_peptidoform"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity"
      }
    }
  }
}
