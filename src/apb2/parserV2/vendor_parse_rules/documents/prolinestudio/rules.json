{
  "schema_version": "0.11",
  "file_version": "4",
  "software_name": "ProlineStudio",
  "software_version_pattern": "^2\\..*",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "sample_annotation": {"matching": {"mode": "exact", "normalize": "mass_spec_basename"}},
  "tables": [
    {
      "input": {
        "shape": "wide",
        "extensions": [".txt", ".xlsx"],
        "sheet_name": "Quantified peptide ions"
      },
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "sample_pattern": "(?P<sample>.+)"
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"obs_keys": ["sample"], "var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "abundance",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {
                "name": "abundance",
                "source": "abundance_{sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "best_score", "source": "best_score_{sample}"},
              {"name": "psm_count", "source": "psm_count_{sample}", "type": "integer"},
              {"name": "elution_time", "source": "elution_time_{sample}"},
              {"name": "corrected_time", "source": "corrected_time_{sample}"}
            ]
          },
          "rank_rows": {"by": "protein_set_score", "best": "highest"},
          "columns": {
            "var": [
              {"name": "sequence", "source": "sequence"},
              {"name": "modifications", "source": "modifications"},
              {
                "name": "master_quant_peptide_ion_charge",
                "source": "master_quant_peptide_ion_charge",
                "type": "integer"
              },
              {
                "name": "protein_set_score",
                "source": "protein_set_score",
                "type": "number",
                "per_feature": "max"
              },
              {
                "name": "samesets_accessions",
                "source": "samesets_accessions",
                "roles": ["protein_assignment"],
                "per_feature": "best_row"
              },
              {
                "name": "subsets_accessions",
                "source": "subsets_accessions",
                "required": false,
                "per_feature": "best_row"
              },
              {
                "name": "quant_is_valid_for_protein_set",
                "source": "quant_is_valid_for_protein_set",
                "type": "boolean",
                "per_feature": "best_row"
              },
              {
                "name": "master_quant_peptide_ion_elution_time",
                "source": "master_quant_peptide_ion_elution_time",
                "type": "number",
                "required": false
              },
              {
                "name": "master_elution_time",
                "source": "master_elution_time",
                "type": "number",
                "required": false
              },
              {
                "name": "Proteins",
                "inputs": ["samesets_accessions", "subsets_accessions"],
                "how": "join_nonempty",
                "separator": ";",
                "roles": ["fasta_accessions"]
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": ["sequence", "modifications"],
                "how": "proforma_sequence",
                "syntax": "vendor_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["sequence"],
                "how": "stripped_sequence",
                "syntax": "plain_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "master_quant_peptide_ion_charge"],
                "how": "proforma_ion"
              },
              {"name": "apb_Decoy", "how": "unmarked"},
              {"name": "apb_Contaminant", "how": "unmarked"}
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "embedded_site_list",
              "delimiter": ";",
              "entry_pattern": "^(?P<token>.+?)\\s+\\((?P<site>[^)]+)\\)$",
              "site_base": 1
            },
            "plain_sequence": {"parser": "plain_sequence"}
          },
          "modification_map": {
            "Carbamidomethyl": "UNIMOD:4",
            "Oxidation": "UNIMOD:35",
            "Acetyl": "UNIMOD:1"
          }
        }
      }
    }
  ]
}
