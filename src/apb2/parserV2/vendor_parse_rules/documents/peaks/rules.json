{
  "schema_version": "0.11",
  "file_version": "5",
  "software_name": "PEAKS",
  "software_version_pattern": "^13(?:\\.|\\s|$)",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "sample_annotation": {
    "matching": {
      "mode": "fuzzy",
      "cutoff": 0.6,
      "margin": 0.01,
      "near_miss_limit": 3,
      "normalize": "mass_spec_basename"
    }
  },
  "tables": [
    {
      "input": {"shape": "wide", "extensions": [".csv"]},
      "base": {
        "defaults": {
          "var": {"type": "number", "required": true, "per_feature": "first"},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "sample_pattern": "(?P<sample>.+?)(?:\\.raw|_raw)?"
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"obs_keys": ["sample"], "var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Normalized_Area",
            "sample_layer": "m_z",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {
                "name": "Normalized_Area",
                "source": "{sample} Normalized Area",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "m_z", "source": "{sample} m/z", "missing_tokens": ["-"]},
              {"name": "RT_mean", "source": "{sample} RT mean", "missing_tokens": ["-"]},
              {
                "name": "AScore",
                "source": "{sample} AScore",
                "value_pattern": {"mode": "regex", "pattern": ":(-?\\d+(?:\\.\\d+)?)(?:;|$)"}
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Peptide", "source": "Peptide", "type": "string"},
              {"name": "z", "source": "z", "type": "integer"},
              {"name": "m_z", "source": "m/z"},
              {
                "name": "RT_mean",
                "source": "RT mean",
                "required": false,
                "note": "Across all samples; the layer of the same name holds each sample's value"
              },
              {"name": "RT_range", "source": "RT range", "type": "string"},
              {"name": "Quality", "source": "Quality"},
              {"name": "Significance", "source": "Significance"},
              {"name": "neg10LgP", "source": "-10LgP"},
              {"name": "Avg_Area", "source": "Avg. Area"},
              {
                "name": "Accession",
                "source": "Accession",
                "type": "string",
                "roles": ["protein_assignment", "fasta_accessions"],
                "separator": ":"
              },
              {"name": "apb_Decoy", "how": "unmarked"},
              {"name": "apb_Contaminant", "how": "unmarked"},
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Peptide"],
                "how": "proforma_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {"name": "ProForma_peptide", "inputs": ["Peptide"], "how": "stripped_sequence"},
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "z"],
                "how": "proforma_ion"
              }
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "(?:(?<=^[A-Z])|(?<=^C\\(\\+57\\.02\\)))\\((?P<nterm>\\+42\\.01|\\+42\\.0106)\\)|\\((?P<residue>[^()]+)\\)",
              "token_position": "after_residue"
            }
          },
          "modification_map": {
            "+15.99": "UNIMOD:35",
            "+57.02": "UNIMOD:4",
            "+42.01": "UNIMOD:1",
            "+15.9949": "UNIMOD:35",
            "+57.02146": "UNIMOD:4",
            "+42.0106": "UNIMOD:1"
          }
        }
      }
    }
  ]
}
