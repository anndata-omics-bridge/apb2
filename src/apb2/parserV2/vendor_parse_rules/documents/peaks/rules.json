{
  "schema_version": "0.10",
  "file_version": "4",
  "software_name": "PEAKS",
  "software_version_pattern": "^13(?:\\.|\\s|$)",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "sample_annotation": {
    "matching": {
      "mode": "fuzzy",
      "cutoff": 0.6,
      "margin": 0.01,
      "near_miss_limit": 3,
      "normalize": "mass_spec_basename"
    }
  },
  "tables": [
    {
      "input": {"shape": "wide", "extensions": [".csv"]},
      "base": {
        "defaults": {
          "var": {"type": "number", "required": true, "per_feature": "first"},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "sample_pattern": "(?P<sample>.+?)(?:\\.raw|_raw)?",
        "axis": {"obs_keys": ["sample"]},
        "measurements": {"repeated_cells": {"mode": "error"}},
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "token_regex",
            "token_pattern": "(?:(?<=^[A-Z])|(?<=^C\\(\\+57\\.02\\)))\\((?P<nterm>\\+42\\.01|\\+42\\.0106)\\)|\\((?P<residue>[^()]+)\\)",
            "token_position": "after_residue"
          }
        },
        "modification_maps": {
          "basic_modification_map": {
            "+15.99": "UNIMOD:35",
            "+57.02": "UNIMOD:4",
            "+42.01": "UNIMOD:1",
            "+15.9949": "UNIMOD:35",
            "+57.02146": "UNIMOD:4",
            "+42.0106": "UNIMOD:1"
          }
        },
        "columns": {
          "var": [
            {"name": "apb_Decoy", "how": "unmarked"},
            {"name": "apb_Contaminant", "how": "unmarked"}
          ]
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Normalized_Area",
            "sample_layer": "Sample_Mz",
            "layers": [
              {
                "name": "Normalized_Area",
                "source": "{sample} Normalized Area",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "Sample_Mz", "source": "{sample} m/z", "missing_tokens": ["-"]},
              {"name": "Sample_RT_Mean", "source": "{sample} RT mean", "missing_tokens": ["-"]},
              {
                "name": "AScore",
                "source": "{sample} AScore",
                "value_pattern": {"mode": "regex", "pattern": ":(-?\\d+(?:\\.\\d+)?)(?:;|$)"}
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Peptide", "source": "Peptide", "type": "string"},
              {"name": "Charge", "source": "z", "type": "integer"},
              {"name": "Mz", "source": "m/z"},
              {
                "name": "RT_Mean",
                "source": "RT mean",
                "required": false,
                "note": "The feature's retention time across all samples, one value per feature; the per-sample values are the Sample_RT_Mean layer"
              },
              {"name": "RT_Range", "source": "RT range", "type": "string"},
              {"name": "Quality", "source": "Quality"},
              {"name": "Significance", "source": "Significance"},
              {"name": "Minus_10LgP", "source": "-10LgP"},
              {"name": "Avg_Area", "source": "Avg. Area"},
              {
                "name": "Accession",
                "source": "Accession",
                "type": "string",
                "roles": ["protein_assignment", "fasta_accessions"],
                "separator": ":"
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Peptide"],
                "case_sensitive": false,
                "unknown_policy": "preserve",
                "how": "proforma_sequence"
              },
              {"name": "ProForma_peptide", "inputs": ["Peptide"], "how": "stripped_sequence"},
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Charge"],
                "how": "proforma_ion"
              }
            ]
          }
        }
      }
    }
  ]
}
