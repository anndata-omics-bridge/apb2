{
  "schema_version": "0.3",
  "file_version": "2",
  "software_name": "PEAKS",
  "software_version_pattern": "^13(?:\\.|\\s|$)",
  "input": {
    "shape": "wide",
    "extensions": [
      ".csv"
    ]
  },
  "base": {
    "axis": {
      "obs_keys": [
        "sample"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    },
    "modifications": {
      "source_column": "Peptide",
      "parser": "token_regex",
      "token_pattern": "\\(([^()]+)\\)",
      "token_position": "after_residue",
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "+15.99",
          "accession": "UNIMOD:35"
        },
        {
          "token": "+57.02",
          "accession": "UNIMOD:4"
        },
        {
          "token": "+42.01",
          "accession": "UNIMOD:1"
        },
        {
          "token": "+15.9949",
          "accession": "UNIMOD:35"
        },
        {
          "token": "+57.02146",
          "accession": "UNIMOD:4"
        },
        {
          "token": "+42.0106",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Normalized_Area",
        "layers": [
          {
            "name": "Normalized_Area",
            "source": "^(?P<sample>LFQ_.+?)(?:\\.raw|_raw)? Normalized Area$",
            "missing_values": [
              0
            ]
          },
          {
            "name": "Sample_Mz",
            "source": "^(?P<sample>LFQ_.+?)(?:\\.raw|_raw)? m/z$"
          },
          {
            "name": "Sample_RT_Mean",
            "source": "^(?P<sample>LFQ_.+?)(?:\\.raw|_raw)? RT mean$"
          },
          {
            "name": "AScore",
            "source": "^(?P<sample>LFQ_.+?)(?:\\.raw|_raw)? AScore$",
            "value_pattern": {
              "mode": "regex",
              "pattern": ":(-?\\d+(?:\\.\\d+)?)(?:;|$)"
            }
          }
        ]
      },
      "columns": {
        "var": {
          "select": {
            "Peptide": "Peptide",
            "Charge": "z",
            "Mz": "m/z",
            "RT_Range": "RT range",
            "Quality": "Quality",
            "Significance": "Significance",
            "Avg_Area": "Avg. Area",
            "Accession": "Accession"
          },
          "types": {
            "Charge": "integer",
            "Mz": "number",
            "Quality": "number",
            "Significance": "number",
            "Avg_Area": "number"
          },
          "computed": [
            {
              "name": "ProForma_peptidoform",
              "inputs": [
                "Peptide"
              ],
              "how": "proforma_sequence"
            },
            {
              "name": "ProForma_peptide",
              "inputs": [
                "Peptide"
              ],
              "how": "stripped_sequence"
            },
            {
              "name": "ProForma_ion",
              "inputs": [
                "ProForma_peptidoform",
                "Charge"
              ],
              "how": "proforma_ion"
            }
          ]
        }
      },
      "column_roles": {
        "protein_assignment": "Accession",
        "fasta_accessions": "Accession"
      }
    }
  }
}
