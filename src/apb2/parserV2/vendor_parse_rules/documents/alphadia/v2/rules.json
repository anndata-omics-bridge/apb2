{
  "schema_version": "0.11",
  "file_version": "6",
  "software_name": "AlphaDIA",
  "software_version_pattern": "^2\\.",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "tables": [
    {
      "input": {"shape": "long", "extensions": [".parquet"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "obs": {"type": "string", "required": true},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "axis": {"obs_keys": ["raw_name"]},
        "columns": {
          "obs": [{"name": "raw_name", "source": "raw.name"}],
          "var": [
            {"name": "pg_master_protein", "source": "pg.master_protein"},
            {"name": "apb_Contaminant", "how": "unmarked"}
          ]
        },
        "sequence_syntax": {
          "vendor_sequence": {"parser": "site_list", "delimiter": ";", "site_base": 1},
          "plain_sequence": {"parser": "plain_sequence"}
        },
        "modification_map": {
          "Carbamidomethyl@C": "UNIMOD:4",
          "Oxidation@M": "UNIMOD:35",
          "Acetyl@Protein_N-term": "UNIMOD:1"
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "precursor_intensity",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {
                "name": "precursor_intensity",
                "source": "precursor.intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "precursor_qval", "source": "precursor.qval"},
              {"name": "precursor_proba", "source": "precursor.proba"},
              {"name": "precursor_rt_observed", "source": "precursor.rt.observed"},
              {
                "name": "precursor_rt_calibrated",
                "source": "precursor.rt.calibrated",
                "note": "Where AlphaDIA expects the precursor to elute in this run, not where it was observed"
              },
              {
                "name": "precursor_rt_library",
                "source": "precursor.rt.library",
                "note": "A layer: AlphaDIA writes the library RT with run-to-run differences of up to 0.03 s"
              },
              {
                "name": "precursor_rt_fwhm",
                "source": "precursor.rt.fwhm",
                "note": "Counted in DIA cycles, not time"
              },
              {"name": "precursor_mz_observed", "source": "precursor.mz.observed"},
              {"name": "precursor_mobility_observed", "source": "precursor.mobility.observed"}
            ]
          },
          "columns": {
            "var": [
              {"name": "precursor_sequence", "source": "precursor.sequence"},
              {"name": "precursor_charge", "source": "precursor.charge", "type": "integer"},
              {"name": "precursor_mods", "source": "precursor.mods"},
              {"name": "precursor_mod_sites", "source": "precursor.mod_sites"},
              {"name": "pg_genes", "source": "pg.genes"},
              {"name": "pg_proteins", "source": "pg.proteins", "roles": ["fasta_accessions"]},
              {"name": "pg_name", "source": "pg.name", "roles": ["protein_assignment"]},
              {"name": "precursor_decoy", "source": "precursor.decoy", "type": "boolean"},
              {"name": "precursor_channel", "source": "precursor.channel", "required": false},
              {
                "name": "ProForma_peptidoform",
                "inputs": ["precursor_sequence", "precursor_mods", "precursor_mod_sites"],
                "how": "proforma_sequence",
                "syntax": "vendor_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["precursor_sequence"],
                "how": "stripped_sequence",
                "syntax": "plain_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "precursor_charge"],
                "how": "proforma_ion"
              },
              {
                "name": "apb_Decoy",
                "inputs": ["precursor_decoy"],
                "how": "decoy",
                "equals": "true"
              }
            ]
          }
        },
        "protein": {
          "axis": {"var_keys": ["pg_name"]},
          "measurements": {
            "primary_layer": "pg_intensity",
            "repeated_cells": {"mode": "same"},
            "layers": [
              {
                "name": "pg_intensity",
                "source": "pg.intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "pg_name",
                "source": "pg.name",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "pg_qval", "source": "pg.qval", "type": "number", "required": false},
              {"name": "apb_Decoy", "how": "unmarked"}
            ]
          }
        }
      }
    }
  ]
}
