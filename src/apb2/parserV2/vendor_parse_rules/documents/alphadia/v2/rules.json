{
  "schema_version": "0.4",
  "file_version": "2",
  "software_name": "AlphaDIA",
  "software_version_pattern": "^2\\.",
  "input": {
    "shape": "long",
    "extensions": [
      ".parquet"
    ]
  },
  "base": {
    "axis": {
      "obs_keys": [
        "raw_name"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    },
    "columns": {
      "obs": [
        {
          "name": "raw_name",
          "source": "raw.name"
        }
      ]
    },
    "modifications": {
      "parser": "site_list",
      "sequence_column": "precursor.sequence",
      "modification_column": "precursor.mods",
      "site_column": "precursor.mod_sites",
      "delimiter": ";",
      "site_base": 1,
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "Carbamidomethyl@C",
          "accession": "UNIMOD:4"
        },
        {
          "token": "Oxidation@M",
          "accession": "UNIMOD:35"
        },
        {
          "token": "Acetyl@Protein_N-term",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Precursor_Intensity",
        "layers": [
          {
            "name": "Precursor_Intensity",
            "source": "precursor.intensity",
            "missing_values": [
              0
            ]
          },
          {
            "name": "QValue",
            "source": "precursor.qval"
          },
          {
            "name": "Proba",
            "source": "precursor.proba"
          },
          {
            "name": "RT_Observed",
            "source": "precursor.rt.observed"
          }
        ]
      },
      "columns": {
        "var": [
          {
            "name": "Sequence",
            "source": "precursor.sequence"
          },
          {
            "name": "Charge",
            "source": "precursor.charge",
            "type": "integer"
          },
          {
            "name": "Mods",
            "source": "precursor.mods"
          },
          {
            "name": "Mod_Sites",
            "source": "precursor.mod_sites"
          },
          {
            "name": "Genes",
            "source": "pg.genes"
          },
          {
            "name": "Proteins",
            "source": "pg.proteins",
            "roles": [
              "protein_assignment",
              "fasta_accessions"
            ]
          },
          {
            "name": "Protein_Group",
            "source": "pg.name"
          },
          {
            "name": "Protein_Group_Master",
            "source": "pg.master_protein"
          },
          {
            "name": "Decoy",
            "source": "precursor.decoy",
            "type": "boolean"
          },
          {
            "name": "Channel",
            "source": "precursor.channel",
            "required": false
          },
          {
            "name": "Protein_Group_QValue",
            "source": "pg.qval",
            "type": "number",
            "required": false
          },
          {
            "name": "Mz_Observed",
            "source": "precursor.mz.observed",
            "type": "number",
            "required": false
          },
          {
            "name": "Mobility_Observed",
            "source": "precursor.mobility.observed",
            "type": "number",
            "required": false
          },
          {
            "name": "ProForma_peptidoform",
            "inputs": [
              "Sequence"
            ],
            "how": "proforma_sequence"
          },
          {
            "name": "ProForma_peptide",
            "inputs": [
              "Sequence"
            ],
            "how": "stripped_sequence"
          },
          {
            "name": "ProForma_ion",
            "inputs": [
              "ProForma_peptidoform",
              "Charge"
            ],
            "how": "proforma_ion"
          }
        ]
      }
    }
  }
}
