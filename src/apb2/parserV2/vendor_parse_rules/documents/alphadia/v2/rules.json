{
  "schema_version": "0.8",
  "file_version": "2",
  "software_name": "AlphaDIA",
  "software_version_pattern": "^2\\.",
  "tables": [
    {
      "input": {
        "shape": "long",
        "extensions": [
          ".parquet"
        ]
      },
      "base": {
        "axis": {
          "obs_keys": [
            "raw_name"
          ]
        },
        "measurements": {
          "duplicates": {
            "mode": "error"
          }
        },
        "columns": {
          "obs": [
            {
              "name": "raw_name",
              "source": "raw.name"
            }
          ]
        },
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "site_list",
            "delimiter": ";",
            "site_base": 1
          },
          "plain_sequence": {
            "parser": "plain_sequence"
          }
        },
        "modification_maps": {
          "basic_modification_map": [
            {
              "token": "Carbamidomethyl@C",
              "accession": "UNIMOD:4"
            },
            {
              "token": "Oxidation@M",
              "accession": "UNIMOD:35"
            },
            {
              "token": "Acetyl@Protein_N-term",
              "accession": "UNIMOD:1"
            }
          ]
        }
      },
      "levels": {
