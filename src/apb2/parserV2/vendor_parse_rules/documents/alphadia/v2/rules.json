                  "abundance"
                ],
                "missing_values": [
                  0
                ]
              },
              {
                "name": "QValue",
                "source": "precursor.qval"
              },
              {
                "name": "Proba",
                "source": "precursor.proba"
              },
              {
                "name": "RT_Observed",
                "source": "precursor.rt.observed"
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Sequence",
                "source": "precursor.sequence"
              },
              {
                "name": "Charge",
                "source": "precursor.charge",
                "type": "integer"
              },
              {
                "name": "Mods",
                "source": "precursor.mods"
              },
              {
                "name": "Mod_Sites",
                "source": "precursor.mod_sites"
              },
              {
                "name": "Genes",
                "source": "pg.genes"
              },
              {
                "name": "Proteins",
                "source": "pg.proteins",
                "roles": [
                  "protein_assignment",
                  "fasta_accessions"
                ]
              },
              {
                "name": "Protein_Group",
                "source": "pg.name"
              },
              {
                "name": "Protein_Group_Master",
                "source": "pg.master_protein"
              },
              {
                "name": "Decoy",
                "source": "precursor.decoy",
                "type": "boolean"
              },
              {
                "name": "Channel",
                "source": "precursor.channel",
                "required": false
              },
              {
                "name": "Protein_Group_QValue",
                "source": "pg.qval",
                "type": "number",
                "required": false
              },
              {
                "name": "Mz_Observed",
                "source": "precursor.mz.observed",
                "type": "number",
                "required": false
              },
              {
                "name": "Mobility_Observed",
                "source": "precursor.mobility.observed",
                "type": "number",
                "required": false
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": [
                  "Sequence",
                  "Mods",
                  "Mod_Sites"
                ],
                "how": "proforma_sequence",
                "syntax": "vendor_sequence",
                "modification_map": "basic_modification_map",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": [
                  "Sequence"
                ],
                "how": "stripped_sequence",
                "syntax": "plain_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": [
                  "ProForma_peptidoform",
                  "Charge"
