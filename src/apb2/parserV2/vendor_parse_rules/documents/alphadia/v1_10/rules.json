{
  "schema_version": "0.4",
  "file_version": "2",
  "software_name": "AlphaDIA",
  "software_version_pattern": "^1\\.10(?:\\.|-|$)",
  "input": {
    "shape": "wide",
    "extensions": [
      ".tsv"
    ]
  },
  "base": {
    "axis": {
      "obs_keys": [
        "sample"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "keep_first"
      }
    },
    "modifications": {
      "parser": "site_list",
      "sequence_column": "sequence",
      "modification_column": "mods",
      "site_column": "mod_sites",
      "delimiter": ";",
      "site_base": 1,
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "Carbamidomethyl@C",
          "accession": "UNIMOD:4"
        },
        {
          "token": "Oxidation@M",
          "accession": "UNIMOD:35"
        },
        {
          "token": "Acetyl@Protein_N-term",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity",
        "layers": [
          {
            "name": "Intensity",
            "source": "^(?P<sample>(?!(?:mod_seq_charge_hash|genes|decoy|mods|mod_sites|sequence|charge|proteins|pg)$).+)$",
            "roles": [
              "abundance"
            ],
            "missing_values": [
              0
            ]
          }
        ]
      },
      "columns": {
        "var": [
          {
            "name": "Sequence",
            "source": "sequence"
          },
          {
            "name": "Charge",
            "source": "charge",
            "type": "integer"
          },
          {
            "name": "Mods",
            "source": "mods"
          },
          {
            "name": "Mod_Sites",
            "source": "mod_sites"
          },
          {
            "name": "Genes",
            "source": "genes",
            "roles": [
              "protein_assignment"
            ]
          },
          {
            "name": "Decoy",
            "source": "decoy",
            "type": "boolean"
          },
          {
            "name": "ProForma_peptidoform",
            "inputs": [
              "Sequence"
            ],
            "how": "proforma_sequence"
          },
          {
            "name": "ProForma_peptide",
            "inputs": [
              "Sequence"
            ],
            "how": "stripped_sequence"
          },
          {
            "name": "ProForma_ion",
            "inputs": [
              "ProForma_peptidoform",
              "Charge"
            ],
            "how": "proforma_ion"
          }
        ]
      }
    }
  }
}
