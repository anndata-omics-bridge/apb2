{
  "schema_version": "0.3",
  "file_version": "2",
  "software_name": "AlphaDIA",
  "software_version_pattern": "^1\\.12(?:\\.|-|$)",
  "input": {
    "shape": "long",
    "extensions": [
      ".tsv"
    ]
  },
  "base": {
    "axis": {
      "obs_keys": [
        "run"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    },
    "columns": {
      "obs": {
        "select": {
          "run": "run"
        }
      }
    },
    "modifications": {
      "parser": "site_list",
      "sequence_column": "sequence",
      "modification_column": "mods",
      "site_column": "mod_sites",
      "delimiter": ";",
      "site_base": 1,
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "Carbamidomethyl@C",
          "accession": "UNIMOD:4"
        },
        {
          "token": "Oxidation@M",
          "accession": "UNIMOD:35"
        },
        {
          "token": "Acetyl@Protein_N-term",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity",
        "layers": [
          {
            "name": "Intensity",
            "source": "intensity",
            "missing_values": [
              0
            ]
          },
          {
            "name": "QValue",
            "source": "qval"
          },
          {
            "name": "Proba",
            "source": "proba"
          },
          {
            "name": "RT_Observed",
            "source": "rt_observed"
          },
          {
            "name": "Mz_Observed",
            "source": "mz_observed"
          },
          {
            "name": "Mobility_Observed",
            "source": "mobility_observed"
          }
        ]
      },
      "columns": {
        "var": {
          "select": {
            "Sequence": "sequence",
            "Charge": "charge",
            "Mods": "mods",
            "Mod_Sites": "mod_sites",
            "Genes": "genes",
            "Proteins": "proteins",
            "Protein_Group": "pg",
            "Protein_Group_Master": "pg_master",
            "Decoy": "decoy"
          },
          "optional_select": {
            "Channel": "channel",
            "Protein_Group_QValue": "pg_qval"
          },
          "types": {
            "Charge": "integer",
            "Decoy": "boolean",
            "Protein_Group_QValue": "number"
          },
          "computed": [
            {
              "name": "ProForma_peptidoform",
              "inputs": [
                "Sequence"
              ],
              "how": "proforma_sequence"
            },
            {
              "name": "ProForma_peptide",
              "inputs": [
                "Sequence"
              ],
              "how": "stripped_sequence"
            },
            {
              "name": "ProForma_ion",
              "inputs": [
                "ProForma_peptidoform",
                "Charge"
              ],
              "how": "proforma_ion"
            }
          ]
        }
      },
      "column_roles": {
        "protein_assignment": "Proteins",
        "fasta_accessions": "Proteins"
      }
    }
  }
}
