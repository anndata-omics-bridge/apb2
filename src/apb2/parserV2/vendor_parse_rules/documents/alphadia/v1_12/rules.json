{
  "schema_version": "0.10",
  "file_version": "5",
  "software_name": "AlphaDIA",
  "software_version_pattern": "^1\\.12(?:\\.|-|$)",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "tables": [
    {
      "prepare": {"how": "alphadia"},
      "input": {"shape": "long", "extensions": [".tsv"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "obs": {"type": "string", "required": true},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "axis": {"obs_keys": ["run"]},
        "measurements": {"repeated_cells": {"mode": "error"}},
        "columns": {"obs": [{"name": "run", "source": "run"}]},
        "sequence_syntax": {
          "vendor_sequence": {"parser": "site_list", "delimiter": ";", "site_base": 1},
          "plain_sequence": {"parser": "plain_sequence"}
        },
        "modification_maps": {
          "basic_modification_map": {
            "Carbamidomethyl@C": "UNIMOD:4",
            "Oxidation@M": "UNIMOD:35",
            "Acetyl@Protein_N-term": "UNIMOD:1"
          }
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": "intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "QValue", "source": "qval"},
              {"name": "Proba", "source": "proba"},
              {"name": "RT_Observed", "source": "rt_observed"},
              {
                "name": "RT_Calibrated",
                "source": "rt_calibrated",
                "note": "The library RT calibrated into this run: where AlphaDIA expects the precursor to elute, not where it was observed"
              },
              {
                "name": "RT_Library",
                "source": "rt_library",
                "note": "The spectral library RT; a layer because AlphaDIA writes it with run-to-run differences of up to 0.03 s"
              },
              {
                "name": "Cycle_FWHM",
                "source": "cycle_fwhm",
                "note": "Peak width at half maximum, counted in DIA cycles rather than time"
              },
              {
                "name": "Mz_Observed",
                "source": "mz_observed",
                "note": "Measured in each run: differs across runs, unlike mz_library, so a layer."
              },
              {"name": "Mobility_Observed", "source": "mobility_observed"}
            ]
          },
          "columns": {
            "var": [
              {"name": "Sequence", "source": "sequence"},
              {"name": "Charge", "source": "charge", "type": "integer"},
              {"name": "Mods", "source": "mods"},
              {"name": "Mod_Sites", "source": "mod_sites"},
              {"name": "Genes", "source": "genes"},
              {
                "name": "Proteins",
                "source": "proteins",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Protein_Group", "source": "pg"},
              {"name": "Protein_Group_Master", "source": "pg_master"},
              {"name": "Decoy", "source": "decoy", "type": "boolean"},
              {"name": "Channel", "source": "channel", "required": false},
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Sequence", "Mods", "Mod_Sites"],
                "how": "proforma_sequence",
                "syntax": "vendor_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Sequence"],
                "how": "stripped_sequence",
                "syntax": "plain_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Charge"],
                "how": "proforma_ion"
              },
              {"name": "apb_Decoy", "inputs": ["Decoy"], "how": "decoy", "equals": "true"},
              {"name": "apb_Contaminant", "how": "unmarked"}
            ]
          }
        }
      }
    }
  ]
}
