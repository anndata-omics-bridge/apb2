    "RankRows": {
      "additionalProperties": false,
      "description": "The var column that ranks a feature's repeated rows, for its ``best_row`` columns.\n\nThe level keeps, per feature, the row whose ``by`` column is ``best`` before the feature\ntable and the layers are built, so the ``best_row`` columns and every layer describe the\nsame row, such as the protein set a shared peptide is assigned to.",
      "properties": {
        "by": {
          "description": "the numeric var column that ranks a feature's repeated rows",
          "title": "By",
          "type": "string"
        },
        "best": {
          "description": "which value of the 'by' column wins",
          "enum": [
            "highest",
            "lowest"
          ],
          "title": "Best",
          "type": "string"
        }
      },
      "required": [
        "by",
        "best"
      ],
      "title": "RankRows",
      "type": "object"
    },
    "RegexValuePattern": {
      "additionalProperties": false,
      "description": "Extract one numeric capture group from each structured layer value.",
      "properties": {
        "mode": {
          "const": "regex",
          "default": "regex",
          "title": "Mode",
          "type": "string"
        },
        "pattern": {
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "RegexValuePattern",
      "type": "object"
    },
    "RepeatedCells": {
      "additionalProperties": false,
      "description": "How repeated raw measurement cells are resolved: one row for every layer, or all rows.\n\n``error`` stops at a second row for a cell, whatever it holds. ``same`` takes the value\nthe rows share, for rows that are copies, such as a protein value repeated on each\nprecursor row, and stops where their values differ. ``sum`` adds up every layer over the\nrepeated rows, so it suits only levels whose layers are all additive.\n``keep_best`` keeps, in each cell, the repeated row whose ``by`` layer is ``best``, and\ntakes every layer's value from that one row, so one feature's intensity, score and\nq-value describe the same identification, such as one PSM. Layers listed in ``sum`` are\nadded up over the repeated rows instead, such as quantities split across several of them.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/DuplicateMode"
        },
        "by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "keep_best: the numeric layer that ranks repeated rows",
          "title": "By"
        },
        "best": {
          "anyOf": [
            {
              "enum": [
                "highest",
                "lowest"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "keep_best: which value of the 'by' layer wins",
          "title": "Best"
        },
        "sum": {
          "description": "keep_best: layers added up over the repeated rows, not taken from the winning row",
          "items": {
            "type": "string"
          },
          "title": "Sum",
          "type": "array"
        }
      },
      "required": [
        "mode"
      ],
      "title": "RepeatedCells",
      "type": "object"
    },
