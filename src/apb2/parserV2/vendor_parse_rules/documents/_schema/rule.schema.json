      "properties": {
        "when_search_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ConditionValue"
          },
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/SearchParameterField"
          },
          "title": "When Search Parameters",
          "type": "object"
        },
        "primary_layer": {
          "title": "Primary Layer",
          "type": "string"
        }
      },
      "required": [
        "when_search_parameters",
        "primary_layer"
      ],
      "title": "SearchParameterOverride",
      "type": "object"
    },
    "SemanticRole": {
      "enum": [
        "abundance",
        "fasta_accessions",
        "protein_assignment"
      ],
      "type": "string"
    },
    "SequenceSyntax": {
      "discriminator": {
        "mapping": {
          "embedded_site_list": "#/$defs/EmbeddedSiteListSyntax",
          "plain_sequence": "#/$defs/PlainSequenceSyntax",
          "site_list": "#/$defs/SiteListSyntax",
          "token_regex": "#/$defs/TokenRegexSyntax"
        },
        "propertyName": "parser"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PlainSequenceSyntax"
        },
        {
          "$ref": "#/$defs/TokenRegexSyntax"
        },
        {
          "$ref": "#/$defs/SiteListSyntax"
        },
        {
          "$ref": "#/$defs/EmbeddedSiteListSyntax"
        }
      ]
    },
    "SiteListSyntax": {
      "additionalProperties": false,
      "description": "Parallel modification-name and modification-site lists.",
      "properties": {
        "parser": {
          "const": "site_list",
          "title": "Parser",
          "type": "string"
        },
        "delimiter": {
          "default": ";",
          "minLength": 1,
          "title": "Delimiter",
          "type": "string"
        },
        "site_base": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Site Base",
          "type": "integer"
        }
      },
      "required": [
        "parser"
      ],
      "title": "SiteListSyntax",
      "type": "object"
    },
    "SourcedColumn": {
      "additionalProperties": false,
      "description": "One logical axis column read from one physical vendor column.",
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/AxisColumnType",
          "default": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "SourcedColumn",
      "type": "object"
    },
    "StrippedSequence": {
      "additionalProperties": false,
      "description": "Strip one logical sequence input using a named grammar, without a token map.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "type": {
          "$ref": "#/$defs/AxisColumnType",
          "default": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "how": {
          "const": "stripped_sequence",
          "title": "How",
          "type": "string"
        },
        "name": {
          "const": "ProForma_peptide",
          "default": "ProForma_peptide",
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "syntax": {
          "title": "Syntax",
          "type": "string"
        }
      },
      "required": [
        "how",
        "inputs",
        "syntax"
      ],
      "title": "StrippedSequence",
      "type": "object"
    },
    "TokenPosition": {
      "enum": [
        "before_residue",
        "after_residue",
        "n_term",
        "c_term",
        "embedded",
        "unknown"
      ],
      "type": "string"
    },
    "TokenRegexSyntax": {
      "additionalProperties": false,
      "description": "Inline modification tokens extracted by the declared pattern.",
      "properties": {
        "parser": {
          "const": "token_regex",
          "title": "Parser",
          "type": "string"
        },
        "token_pattern": {
          "title": "Token Pattern",
          "type": "string"
        },
        "token_position": {
          "$ref": "#/$defs/TokenPosition",
          "default": "after_residue"
        }
      },
      "required": [
        "parser",
        "token_pattern"
      ],
      "title": "TokenRegexSyntax",
      "type": "object"
    },
    "UnknownPolicy": {
      "enum": [
        "preserve",
        "drop",
        "error"
      ],
      "type": "string"
    },
    "ValuePattern": {
      "discriminator": {
        "mapping": {
          "none": "#/$defs/NoValuePattern",
          "regex": "#/$defs/RegexValuePattern"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NoValuePattern"
        },
        {
          "$ref": "#/$defs/RegexValuePattern"
        }
      ]
    },
    "WideColumns": {
      "additionalProperties": false,
      "description": "Variable declarations for a wide source.",
      "properties": {
        "var": {
          "$ref": "#/$defs/ColumnGroup"
        }
      },
      "required": [
        "var"
      ],
      "title": "WideColumns",
      "type": "object"
    },
    "WideRule": {
      "additionalProperties": false,
