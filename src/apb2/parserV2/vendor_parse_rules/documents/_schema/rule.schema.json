{
  "$defs": {
    "Axis": {
      "additionalProperties": false,
      "description": "The declared columns that identify observations and variables.",
      "properties": {
        "obs_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Obs Keys",
          "type": "array"
        },
        "var_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Var Keys",
          "type": "array"
        }
      },
      "required": [
        "obs_keys",
        "var_keys"
      ],
      "title": "Axis",
      "type": "object"
    },
    "AxisColumnType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean"
      ],
      "type": "string"
    },
    "Coalesce": {
      "additionalProperties": false,
      "description": "Take the first non-null input value in declaration order.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "note": {
          "$ref": "#/$defs/Note",
          "default": null
        },
        "how": {
          "const": "coalesce",
          "title": "How",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "how",
        "name",
        "inputs"
      ],
      "title": "Coalesce",
      "type": "object"
    },
    "ColumnEntry": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcedColumn"
        },
        {
          "$ref": "#/$defs/ComputedColumn"
        }
      ]
    },
    "ColumnLabeledFragments": {
      "additionalProperties": false,
      "description": "Packed fragment values with labels stored in a parallel packed column.",
      "properties": {
        "label_strategy": {
          "const": "column",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "label_column": {
          "title": "Label Column",
          "type": "string"
        },
        "label_required": {
          "title": "Label Required",
          "type": "boolean"
        },
        "delimiter": {
          "$ref": "#/$defs/Delimiter"
        },
        "label_output": {
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns",
        "label_column",
        "label_required",
        "delimiter",
        "label_output"
      ],
      "title": "ColumnLabeledFragments",
      "type": "object"
    },
    "ComputedColumn": {
      "discriminator": {
        "mapping": {
          "coalesce": "#/$defs/Coalesce",
          "contaminant": "#/$defs/ContaminantFlag",
          "decoy": "#/$defs/DecoyFlag",
          "join_nonempty": "#/$defs/JoinNonempty",
          "proforma_fragment": "#/$defs/ProformaFragment",
          "proforma_ion": "#/$defs/ProformaIon",
          "proforma_sequence": "#/$defs/ProformaSequence",
          "stripped_sequence": "#/$defs/StrippedSequence",
          "unmarked": "#/$defs/UnmarkedFlag"
        },
        "propertyName": "how"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Coalesce"
        },
        {
          "$ref": "#/$defs/JoinNonempty"
        },
        {
          "$ref": "#/$defs/StrippedSequence"
        },
        {
          "$ref": "#/$defs/ProformaSequence"
        },
        {
          "$ref": "#/$defs/ProformaIon"
        },
        {
          "$ref": "#/$defs/ProformaFragment"
        },
        {
          "$ref": "#/$defs/DecoyFlag"
        },
        {
          "$ref": "#/$defs/ContaminantFlag"
        },
        {
          "$ref": "#/$defs/UnmarkedFlag"
        }
      ]
    },
    "ConditionValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "ContaminantFlag": {
      "additionalProperties": false,
      "description": "``apb_Contaminant``: the rows the vendor marks as contaminants it flags or adds itself.",
      "properties": {
        "source": {
          "default": null,
          "title": "Source",
          "type": "null"
        },
        "type": {
          "const": "boolean",
          "default": "boolean",
          "title": "Type",
          "type": "string"
        },
        "required": {
          "const": true,
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "maxItems": 0,
          "title": "Roles",
          "type": "array"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "equals": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equals"
        },
        "prefix": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        },
        "separator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separator"
        },
        "note": {
          "$ref": "#/$defs/Note",
          "default": null
        },
        "how": {
          "const": "contaminant",
          "title": "How",
          "type": "string"
        },
        "name": {
          "const": "apb_Contaminant",
          "default": "apb_Contaminant",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "inputs",
        "how"
      ],
      "title": "ContaminantFlag",
      "type": "object"
    },
    "DecoyFlag": {
      "additionalProperties": false,
      "description": "``apb_Decoy``: the rows the vendor marks as decoys.",
      "properties": {
        "source": {
          "default": null,
          "title": "Source",
          "type": "null"
        },
        "type": {
          "const": "boolean",
          "default": "boolean",
          "title": "Type",
          "type": "string"
        },
        "required": {
          "const": true,
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "maxItems": 0,
          "title": "Roles",
          "type": "array"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "equals": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Equals"
        },
        "prefix": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Prefix"
        },
        "separator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Separator"
        },
        "note": {
          "$ref": "#/$defs/Note",
          "default": null
        },
        "how": {
          "const": "decoy",
          "title": "How",
          "type": "string"
        },
        "name": {
          "const": "apb_Decoy",
          "default": "apb_Decoy",
          "title": "Name",
          "type": "string"
        }
      },
      "required": [
        "inputs",
        "how"
      ],
      "title": "DecoyFlag",
      "type": "object"
    },
    "Delimiter": {
      "maxLength": 1,
      "minLength": 1,
      "type": "string"
    },
    "DuplicateMode": {
      "enum": [
        "error",
        "same",
        "sum",
        "keep_best"
      ],
      "type": "string"
    },
    "EmbeddedSiteListSyntax": {
      "additionalProperties": false,
      "description": "Modification-name list entries that also contain their localization.",
      "properties": {
        "parser": {
          "const": "embedded_site_list",
          "title": "Parser",
          "type": "string"
        },
        "delimiter": {
          "minLength": 1,
          "title": "Delimiter",
          "type": "string"
        },
        "entry_pattern": {
          "title": "Entry Pattern",
          "type": "string"
        },
        "site_base": {
          "maximum": 1,
          "minimum": 0,
          "title": "Site Base",
          "type": "integer"
        }
      },
      "required": [
        "parser",
        "delimiter",
        "entry_pattern",
        "site_base"
      ],
      "title": "EmbeddedSiteListSyntax",
      "type": "object"
    },
    "ExactSampleMatching": {
      "additionalProperties": false,
      "description": "Exact matching after an explicitly declared key normalization.",
      "properties": {
        "mode": {
          "const": "exact",
          "title": "Mode",
          "type": "string"
        },
        "normalize": {
          "$ref": "#/$defs/SampleKeyNormalization"
        }
      },
      "required": [
        "mode",
        "normalize"
      ],
      "title": "ExactSampleMatching",
      "type": "object"
    },
    "FactorLayer": {
      "additionalProperties": false,
      "description": "A categorical layer encoded through its declared category map.",
      "properties": {
        "encoding_mode": {
          "const": "factor",
          "title": "Encoding Mode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "categories": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Categories",
          "type": "object"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "note": {
          "$ref": "#/$defs/Note",
          "default": null
        }
      },
      "required": [
        "encoding_mode",
        "name",
        "source",
        "categories",
        "required"
      ],
      "title": "FactorLayer",
      "type": "object"
    },
    "Fragments": {
      "discriminator": {
        "mapping": {
          "column": "#/$defs/ColumnLabeledFragments",
          "positional": "#/$defs/PositionalFragments"
        },
        "propertyName": "label_strategy"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PositionalFragments"
        },
        {
          "$ref": "#/$defs/ColumnLabeledFragments"
        }
      ]
    },
    "FuzzySampleMatching": {
      "additionalProperties": false,
      "description": "Unambiguous mutual-best token matching after exact identifiers are reserved.",
      "properties": {
        "mode": {
          "const": "fuzzy",
          "title": "Mode",
          "type": "string"
        },
        "cutoff": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cutoff",
          "type": "number"
        },
        "margin": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Margin",
          "type": "number"
        },
        "near_miss_limit": {
          "maximum": 50,
          "minimum": 1,
          "title": "Near Miss Limit",
          "type": "integer"
        },
        "normalize": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleKeyNormalization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "cutoff",
        "margin",
        "near_miss_limit"
      ],
      "title": "FuzzySampleMatching",
      "type": "object"
    },
    "JoinNonempty": {
      "additionalProperties": false,
      "description": "Join non-empty input values with a separator.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "note": {
          "$ref": "#/$defs/Note",
          "default": null
        },
        "how": {
          "const": "join_nonempty",
          "title": "How",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        },
        "separator": {
          "minLength": 1,
          "title": "Separator",
          "type": "string"
        }
      },
      "required": [
        "how",
        "name",
        "inputs",
        "separator"
      ],
      "title": "JoinNonempty",
      "type": "object"
    },
    "Layer": {
      "discriminator": {
        "mapping": {
          "factor": "#/$defs/FactorLayer",
          "numeric": "#/$defs/NumericLayer"
        },
        "propertyName": "encoding_mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/NumericLayer"
        },
        {
          "$ref": "#/$defs/FactorLayer"
        }
      ]
    },
    "LongColumns": {
      "additionalProperties": false,
      "description": "Observation and variable declarations for a long source.",
      "properties": {
        "obs": {
          "items": {
            "$ref": "#/$defs/ColumnEntry"
          },
          "title": "Obs",
          "type": "array"
        },
        "var": {
          "items": {
            "$ref": "#/$defs/VarEntry"
          },
          "title": "Var",
          "type": "array"
        }
      },
      "required": [
        "obs",
        "var"
      ],
      "title": "LongColumns",
      "type": "object"
    },
    "LongRule": {
      "additionalProperties": false,
      "description": "One row per observation-variable pair with exact physical source names.",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "file_version": {
          "title": "File Version",
          "type": "string"
        },
        "software_name": {
          "title": "Software Name",
          "type": "string"
        },
        "software_version_pattern": {
          "title": "Software Version Pattern",
          "type": "string"
        },
        "quantification_level": {
          "$ref": "#/$defs/QuantificationLevel"
        },
        "hierarchy": {
          "title": "Hierarchy",
          "type": "string"
        },
        "forbidden_columns": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Columns",
          "type": "array"
        },
        "axis": {
          "$ref": "#/$defs/Axis"
        },
        "measurements": {
          "$ref": "#/$defs/Measurements"
        },
        "sequence_syntax": {
          "additionalProperties": {
            "$ref": "#/$defs/SequenceSyntax"
          },
          "title": "Sequence Syntax",
          "type": "object"
        },
        "modification_map": {
          "anyOf": [
            {
              "$ref": "#/$defs/ModificationMap"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "requires_search_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ConditionValue"
          },
          "propertyNames": {
            "$ref": "#/$defs/SearchParameterField"
          },
          "title": "Requires Search Parameters",
          "type": "object"
        },
        "search_parameter_overrides": {
          "items": {
            "$ref": "#/$defs/SearchParameterOverride"
          },
          "title": "Search Parameter Overrides",
          "type": "array"
        },
        "sample_annotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "rank_rows": {
          "anyOf": [
            {
              "$ref": "#/$defs/RankRows"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shape": {
          "const": "long",
          "title": "Shape",
          "type": "string"
        },
        "columns": {
          "$ref": "#/$defs/LongColumns"
        },
        "fragments": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fragments"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "file_version",
        "software_name",
        "software_version_pattern",
        "quantification_level",
        "hierarchy",
        "axis",
        "measurements",
        "shape",
        "columns"
      ],
      "title": "LongRule",
      "type": "object"
    },
    "Measurements": {
      "additionalProperties": false,
      "description": "Named measurements, their primary layer, and the policy for repeated raw cells.\n\n``sample_layer`` names the wide layer whose header captures are the sample names;\nomitted, the primary layer supplies them.",
      "properties": {
        "primary_layer": {
          "title": "Primary Layer",
          "type": "string"
        },
        "sample_layer": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Layer"
        },
        "repeated_cells": {
          "$ref": "#/$defs/RepeatedCells"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "minItems": 1,
          "title": "Layers",
          "type": "array"
        }
      },
      "required": [
        "primary_layer",
        "repeated_cells",
        "layers"
      ],
      "title": "Measurements",
      "type": "object"
    },
    "MissingBound": {
      "pattern": "^<=\\s*(-?\\d+(?:\\.\\d+)?)$",
      "type": "string"
    },
    "ModificationMap": {
      "additionalProperties": {
        "type": "string"
      },
      "minProperties": 1,
      "type": "object"
    },
    "NoValuePattern": {
      "additionalProperties": false,
      "description": "The layer already contains scalar values.",
      "properties": {
        "mode": {
          "const": "none",
          "default": "none",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "NoValuePattern",
      "type": "object"
    },
    "Note": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Why the entry is placed or read as it is, for the rule's readers; parsing ignores it"
    },
    "NumericLayer": {
      "additionalProperties": false,
      "description": "A quantitative layer encoded numerically only at an output boundary.\n\n``encoding_mode``, ``type`` and ``required`` come from the layer or its table's\n``defaults``.",
      "properties": {
        "encoding_mode": {
          "const": "numeric",
          "title": "Encoding Mode",
          "type": "string"
        },
        "type": {
          "enum": [
            "number",
            "integer"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "missing_values": {
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "$ref": "#/$defs/MissingBound"
              }
            ]
          },
          "title": "Missing Values",
          "type": "array"
        },
        "missing_tokens": {
          "items": {
            "type": "string"
          },
          "title": "Missing Tokens",
          "type": "array"
        },
        "value_pattern": {
          "$ref": "#/$defs/ValuePattern"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "note": {
          "$ref": "#/$defs/Note",
          "default": null
        }
      },
      "required": [
        "encoding_mode",
        "type",
        "name",
        "source",
        "required"
      ],
      "title": "NumericLayer",
      "type": "object"
    },
    "PerFeature": {
      "enum": [
        "first",
        "min",
        "max",
        "best_row"
      ],
      "type": "string"
    },
    "PlainSequenceSyntax": {
      "additionalProperties": false,
      "description": "An unmodified sequence: residue letters only, apart from terminal ``_``, ``-`` or ``.``.",
      "properties": {
        "parser": {
          "const": "plain_sequence",
          "title": "Parser",
          "type": "string"
        }
      },
      "required": [
        "parser"
      ],
      "title": "PlainSequenceSyntax",
      "type": "object"
    },
    "PositionalFragments": {
      "additionalProperties": false,
      "description": "Packed fragment values whose labels are synthesized by token position.",
      "properties": {
        "label_strategy": {
          "const": "positional",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "delimiter": {
          "$ref": "#/$defs/Delimiter"
        },
        "label_output": {
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns",
        "delimiter",
        "label_output"
      ],
      "title": "PositionalFragments",
      "type": "object"
    },
    "ProformaFragment": {
      "additionalProperties": false,
      "description": "Combine a ProForma ion and fragment label into a ProForma fragment.",
      "properties": {
