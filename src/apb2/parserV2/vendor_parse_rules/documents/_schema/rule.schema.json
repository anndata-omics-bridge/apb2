{
  "$defs": {
    "Axis": {
      "additionalProperties": false,
      "description": "The declared columns that identify observations and variables.",
      "properties": {
        "obs_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Obs Keys",
          "type": "array"
        },
        "var_keys": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Var Keys",
          "type": "array"
        }
      },
      "required": [
        "obs_keys",
        "var_keys"
      ],
      "title": "Axis",
      "type": "object"
    },
    "AxisColumnType": {
      "enum": [
        "string",
        "integer",
        "number",
        "boolean"
      ],
      "type": "string"
    },
    "Coalesce": {
      "additionalProperties": false,
      "description": "Take the first non-null input value in declaration order.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "type": {
          "$ref": "#/$defs/AxisColumnType",
          "default": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "how": {
          "const": "coalesce",
          "title": "How",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "how",
        "name",
        "inputs"
      ],
      "title": "Coalesce",
      "type": "object"
    },
    "ColumnEntry": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourcedColumn"
        },
        {
          "$ref": "#/$defs/ComputedColumn"
        }
      ]
    },
    "ColumnGroup": {
      "items": {
        "$ref": "#/$defs/ColumnEntry"
      },
      "type": "array"
    },
    "ColumnLabeledFragments": {
      "additionalProperties": false,
      "description": "Packed fragment values with labels stored in a parallel packed column.",
      "properties": {
        "label_strategy": {
          "const": "column",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "label_column": {
          "title": "Label Column",
          "type": "string"
        },
        "delimiter": {
          "$ref": "#/$defs/Delimiter",
          "default": ";"
        },
        "label_output": {
          "default": "fragment_label",
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns",
        "label_column"
      ],
      "title": "ColumnLabeledFragments",
      "type": "object"
    },
    "ComputedColumn": {
      "discriminator": {
        "mapping": {
          "coalesce": "#/$defs/Coalesce",
          "join_nonempty": "#/$defs/JoinNonempty",
          "proforma_fragment": "#/$defs/ProformaFragment",
          "proforma_ion": "#/$defs/ProformaIon",
          "proforma_sequence": "#/$defs/ProformaSequence",
          "stripped_sequence": "#/$defs/StrippedSequence"
        },
        "propertyName": "how"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/Coalesce"
        },
        {
          "$ref": "#/$defs/JoinNonempty"
        },
        {
          "$ref": "#/$defs/StrippedSequence"
        },
        {
          "$ref": "#/$defs/ProformaSequence"
        },
        {
          "$ref": "#/$defs/ProformaIon"
        },
        {
          "$ref": "#/$defs/ProformaFragment"
        }
      ]
    },
    "ConditionValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "Delimiter": {
      "maxLength": 1,
      "minLength": 1,
      "type": "string"
    },
    "DuplicateMode": {
      "enum": [
        "error",
        "aggregate",
        "keep_first"
      ],
      "type": "string"
    },
    "Duplicates": {
      "additionalProperties": false,
      "description": "How repeated raw measurement cells are resolved.",
      "properties": {
        "mode": {
          "$ref": "#/$defs/DuplicateMode",
          "default": "error"
        }
      },
      "title": "Duplicates",
      "type": "object"
    },
    "EmbeddedSiteListSyntax": {
      "additionalProperties": false,
      "description": "Modification-name list entries that also contain their localization.",
      "properties": {
        "parser": {
          "const": "embedded_site_list",
          "title": "Parser",
          "type": "string"
        },
        "delimiter": {
          "default": ";",
          "minLength": 1,
          "title": "Delimiter",
          "type": "string"
        },
        "entry_pattern": {
          "title": "Entry Pattern",
          "type": "string"
        },
        "site_base": {
          "default": 1,
          "maximum": 1,
          "minimum": 0,
          "title": "Site Base",
          "type": "integer"
        }
      },
      "required": [
        "parser",
        "entry_pattern"
      ],
      "title": "EmbeddedSiteListSyntax",
      "type": "object"
    },
    "ExactSampleMatching": {
      "additionalProperties": false,
      "description": "Exact matching after an explicitly declared key normalization.",
      "properties": {
        "mode": {
          "const": "exact",
          "title": "Mode",
          "type": "string"
        },
        "normalize": {
          "$ref": "#/$defs/SampleKeyNormalization"
        }
      },
      "required": [
        "mode",
        "normalize"
      ],
      "title": "ExactSampleMatching",
      "type": "object"
    },
    "FactorLayer": {
      "additionalProperties": false,
      "description": "A categorical layer encoded through its declared category map.",
      "properties": {
        "encoding_mode": {
          "const": "factor",
          "title": "Encoding Mode",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "categories": {
          "additionalProperties": {
            "type": "integer"
          },
          "minProperties": 1,
          "title": "Categories",
          "type": "object"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "encoding_mode",
        "name",
        "source",
        "categories"
      ],
      "title": "FactorLayer",
      "type": "object"
    },
    "Fragments": {
      "discriminator": {
        "mapping": {
          "column": "#/$defs/ColumnLabeledFragments",
          "positional": "#/$defs/PositionalFragments"
        },
        "propertyName": "label_strategy"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/PositionalFragments"
        },
        {
          "$ref": "#/$defs/ColumnLabeledFragments"
        }
      ]
    },
    "FuzzySampleMatching": {
      "additionalProperties": false,
      "description": "Unambiguous mutual-best token matching after exact identifiers are reserved.",
      "properties": {
        "mode": {
          "const": "fuzzy",
          "title": "Mode",
          "type": "string"
        },
        "cutoff": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Cutoff",
          "type": "number"
        },
        "margin": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Margin",
          "type": "number"
        },
        "near_miss_limit": {
          "maximum": 50,
          "minimum": 1,
          "title": "Near Miss Limit",
          "type": "integer"
        },
        "normalize": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleKeyNormalization"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "mode",
        "cutoff",
        "margin",
        "near_miss_limit"
      ],
      "title": "FuzzySampleMatching",
      "type": "object"
    },
    "JoinNonempty": {
      "additionalProperties": false,
      "description": "Join non-empty input values with a separator.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "type": {
          "$ref": "#/$defs/AxisColumnType",
          "default": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "how": {
          "const": "join_nonempty",
          "title": "How",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        },
        "separator": {
          "minLength": 1,
          "title": "Separator",
          "type": "string"
        }
      },
      "required": [
        "how",
        "name",
        "inputs",
        "separator"
      ],
      "title": "JoinNonempty",
      "type": "object"
    },
    "Layer": {
      "oneOf": [
        {
          "$ref": "#/$defs/NumericLayer"
        },
        {
          "$ref": "#/$defs/FactorLayer"
        }
      ]
    },
    "LongColumns": {
      "additionalProperties": false,
      "description": "Observation and variable declarations for a long source.",
      "properties": {
        "obs": {
          "$ref": "#/$defs/ColumnGroup"
        },
        "var": {
          "$ref": "#/$defs/ColumnGroup"
        }
      },
      "required": [
        "obs",
        "var"
      ],
      "title": "LongColumns",
      "type": "object"
    },
    "LongRule": {
      "additionalProperties": false,
      "description": "One row per observation-variable pair with exact physical source names.",
      "properties": {
        "schema_version": {
          "$ref": "#/$defs/SchemaVersion"
        },
        "file_version": {
          "title": "File Version",
          "type": "string"
        },
        "software_name": {
          "title": "Software Name",
          "type": "string"
        },
        "software_version_pattern": {
          "title": "Software Version Pattern",
          "type": "string"
        },
        "quantification_level": {
          "$ref": "#/$defs/QuantificationLevel"
        },
        "axis": {
          "$ref": "#/$defs/Axis"
        },
        "measurements": {
          "$ref": "#/$defs/Measurements"
        },
        "sequence_syntax": {
          "additionalProperties": {
            "$ref": "#/$defs/SequenceSyntax"
          },
          "title": "Sequence Syntax",
          "type": "object"
        },
        "modification_maps": {
          "additionalProperties": {
            "$ref": "#/$defs/ModificationMap"
          },
          "title": "Modification Maps",
          "type": "object"
        },
        "requires_search_parameters": {
          "additionalProperties": {
            "$ref": "#/$defs/ConditionValue"
          },
          "propertyNames": {
            "$ref": "#/$defs/SearchParameterField"
          },
          "title": "Requires Search Parameters",
          "type": "object"
        },
        "search_parameter_overrides": {
          "items": {
            "$ref": "#/$defs/SearchParameterOverride"
          },
          "title": "Search Parameter Overrides",
          "type": "array"
        },
        "sample_annotation": {
          "anyOf": [
            {
              "$ref": "#/$defs/SampleAnnotation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "shape": {
          "const": "long",
          "title": "Shape",
          "type": "string"
        },
        "columns": {
          "$ref": "#/$defs/LongColumns"
        },
        "fragments": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fragments"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "schema_version",
        "file_version",
        "software_name",
        "software_version_pattern",
        "quantification_level",
        "axis",
        "measurements",
        "shape",
        "columns"
      ],
      "title": "LongRule",
      "type": "object"
    },
    "Measurements": {
      "additionalProperties": false,
      "description": "Named measurements, their primary layer, and raw duplicate policy.",
      "properties": {
        "primary_layer": {
          "title": "Primary Layer",
          "type": "string"
        },
        "duplicates": {
          "$ref": "#/$defs/Duplicates"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/Layer"
          },
          "minItems": 1,
          "title": "Layers",
          "type": "array"
        }
      },
      "required": [
        "primary_layer",
        "layers"
      ],
      "title": "Measurements",
      "type": "object"
    },
    "ModificationMap": {
      "items": {
        "$ref": "#/$defs/ModificationMapEntry"
      },
      "minItems": 1,
      "type": "array"
    },
    "ModificationMapEntry": {
      "additionalProperties": false,
      "description": "One vendor token and the Unimod accession it denotes.",
      "properties": {
        "token": {
          "title": "Token",
          "type": "string"
        },
        "accession": {
          "title": "Accession",
          "type": "string"
        }
      },
      "required": [
        "token",
        "accession"
      ],
      "title": "ModificationMapEntry",
      "type": "object"
    },
    "NoValuePattern": {
      "additionalProperties": false,
      "description": "The layer already contains scalar values.",
      "properties": {
        "mode": {
          "const": "none",
          "default": "none",
          "title": "Mode",
          "type": "string"
        }
      },
      "title": "NoValuePattern",
      "type": "object"
    },
    "NumericLayer": {
      "additionalProperties": false,
      "description": "A quantitative layer encoded numerically only at an output boundary.",
      "properties": {
        "encoding_mode": {
          "const": "numeric",
          "default": "numeric",
          "title": "Encoding Mode",
          "type": "string"
        },
        "type": {
          "default": "number",
          "enum": [
            "number",
            "integer"
          ],
          "title": "Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "missing_values": {
          "items": {
            "type": "number"
          },
          "title": "Missing Values",
          "type": "array"
        },
        "value_pattern": {
          "$ref": "#/$defs/ValuePattern"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "title": "NumericLayer",
      "type": "object"
    },
    "PlainSequenceSyntax": {
      "additionalProperties": false,
      "description": "An unmodified sequence whose alphabetic characters are residues.",
      "properties": {
        "parser": {
          "const": "plain_sequence",
          "title": "Parser",
          "type": "string"
        }
      },
      "required": [
        "parser"
      ],
      "title": "PlainSequenceSyntax",
      "type": "object"
    },
    "PositionalFragments": {
      "additionalProperties": false,
      "description": "Packed fragment values whose labels are synthesized by token position.",
      "properties": {
        "label_strategy": {
          "const": "positional",
          "title": "Label Strategy",
          "type": "string"
        },
        "value_columns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Value Columns",
          "type": "array"
        },
        "delimiter": {
          "$ref": "#/$defs/Delimiter",
          "default": ";"
        },
        "label_output": {
          "default": "fragment_label",
          "title": "Label Output",
          "type": "string"
        }
      },
      "required": [
        "label_strategy",
        "value_columns"
      ],
      "title": "PositionalFragments",
      "type": "object"
    },
    "ProformaFragment": {
      "additionalProperties": false,
      "description": "Combine a ProForma ion and fragment label into a ProForma fragment.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "type": {
          "$ref": "#/$defs/AxisColumnType",
          "default": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "how": {
          "const": "proforma_fragment",
          "title": "How",
          "type": "string"
        },
        "name": {
          "const": "ProForma_fragment",
          "default": "ProForma_fragment",
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "how",
        "inputs"
      ],
      "title": "ProformaFragment",
      "type": "object"
    },
    "ProformaIon": {
      "additionalProperties": false,
      "description": "Combine a peptidoform and charge into a ProForma ion.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "type": {
          "$ref": "#/$defs/AxisColumnType",
          "default": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "how": {
          "const": "proforma_ion",
          "title": "How",
          "type": "string"
        },
        "name": {
          "const": "ProForma_ion",
          "default": "ProForma_ion",
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Inputs",
          "type": "array"
        }
      },
      "required": [
        "how",
        "inputs"
      ],
      "title": "ProformaIon",
      "type": "object"
    },
    "ProformaSequence": {
      "additionalProperties": false,
      "description": "Normalize all declared logical inputs using named syntax and a token map.",
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "type": {
          "$ref": "#/$defs/AxisColumnType",
          "default": "string"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/SemanticRole"
          },
          "title": "Roles",
          "type": "array"
        },
        "how": {
          "const": "proforma_sequence",
          "title": "How",
          "type": "string"
        },
        "name": {
          "const": "ProForma_peptidoform",
          "default": "ProForma_peptidoform",
          "title": "Name",
          "type": "string"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Inputs",
          "type": "array"
        },
        "syntax": {
          "title": "Syntax",
          "type": "string"
        },
        "modification_map": {
          "title": "Modification Map",
          "type": "string"
        },
        "case_sensitive": {
          "default": false,
          "title": "Case Sensitive",
          "type": "boolean"
        },
        "unknown_policy": {
          "$ref": "#/$defs/UnknownPolicy",
          "default": "preserve"
        }
      },
      "required": [
        "how",
        "inputs",
        "syntax",
        "modification_map"
      ],
      "title": "ProformaSequence",
      "type": "object"
    },
    "QuantificationLevel": {
      "enum": [
        "ion",
        "peptidoform",
        "peptide",
        "protein",
        "fragment"
      ],
      "type": "string"
    },
    "RegexValuePattern": {
      "additionalProperties": false,
      "description": "Extract one numeric capture group from each structured layer value.",
      "properties": {
        "mode": {
          "const": "regex",
          "default": "regex",
          "title": "Mode",
          "type": "string"
        },
        "pattern": {
          "minLength": 1,
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "pattern"
      ],
      "title": "RegexValuePattern",
      "type": "object"
    },
    "SampleAnnotation": {
      "additionalProperties": false,
      "description": "Document-level policy used when later matching sample annotations.",
      "properties": {
        "matching": {
          "$ref": "#/$defs/SampleMatching"
        }
      },
      "required": [
        "matching"
      ],
      "title": "SampleAnnotation",
      "type": "object"
    },
    "SampleKeyNormalization": {
      "const": "mass_spec_basename",
      "type": "string"
    },
    "SampleMatching": {
      "discriminator": {
        "mapping": {
          "exact": "#/$defs/ExactSampleMatching",
          "fuzzy": "#/$defs/FuzzySampleMatching"
        },
        "propertyName": "mode"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/ExactSampleMatching"
        },
        {
          "$ref": "#/$defs/FuzzySampleMatching"
        }
      ]
    },
    "SchemaVersion": {
      "const": "0.8",
      "type": "string"
    },
    "SearchParameterField": {
      "enum": [
        "acquisition_method",
        "combine_charge_states"
      ],
      "type": "string"
    },
