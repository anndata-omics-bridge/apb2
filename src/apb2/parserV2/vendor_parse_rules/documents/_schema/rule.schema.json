        },
        "shape": {
          "const": "wide",
          "title": "Shape",
          "type": "string"
        },
        "columns": {
          "$ref": "#/$defs/WideColumns"
        },
        "fragments": {
          "default": null,
          "title": "Fragments",
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "file_version",
        "software_name",
        "software_version_pattern",
        "quantification_level",
        "axis",
        "measurements",
        "shape",
        "columns"
      ],
      "title": "WideRule",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "long": "#/$defs/LongRule",
      "wide": "#/$defs/WideRule"
    },
    "propertyName": "shape"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/LongRule"
    },
    {
      "$ref": "#/$defs/WideRule"
    }
  ]
