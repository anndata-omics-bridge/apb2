{
  "hierarchy": "lfq",
  "schema_version": "0.8",
  "file_version": "1",
  "software_name": "i2MassChroQ",
  "software_version_pattern": "^1\\..*",
  "sample_annotation": {
    "matching": {
      "mode": "exact",
      "normalize": "mass_spec_basename"
    }
  },
  "tables": [
    {
      "input": {
        "shape": "long",
        "extensions": [
          ".tsv",
          ".txt"
        ]
      },
      "base": {
        "axis": {
          "obs_keys": [
            "Raw_File"
          ]
        },
        "measurements": {
          "duplicates": {
            "mode": "error"
          }
        },
        "columns": {
          "obs": [
            {
              "name": "Raw_File",
              "source": "rawfile"
            }
          ],
          "var": [
            {
              "name": "apb_Decoy",
              "how": "decoy"
            },
            {
              "name": "apb_Contaminant",
              "how": "contaminant"
            }
          ]
        }
      },
      "levels": {
        "ion": {
          "axis": {
            "var_keys": [
              "ProForma_ion"
            ]
          },
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": "area",
                "roles": [
                  "abundance"
                ],
                "missing_values": [
                  "<=0"
                ]
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Sequence",
                "source": "sequence"
              },
              {
                "name": "ProForma_peptide",
                "inputs": [
                  "Sequence"
                ],
                "how": "stripped_sequence",
                "syntax": "vendor_sequence"
              },
              {
                "name": "ProForma_peptidoform",
                "source": "ProForma"
              },
              {
                "name": "Charge",
                "source": "charge",
                "type": "integer"
              },
              {
                "name": "Proteins",
                "source": "proteins",
                "roles": [
                  "protein_assignment",
                  "fasta_accessions"
                ]
              },
              {
                "name": "ProForma_ion",
                "inputs": [
                  "ProForma_peptidoform",
                  "Charge"
                ],
                "how": "proforma_ion"
              }
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "^\\[(?P<nterm>[^\\]]+)\\]-|-\\[(?P<cterm>[^\\]]+)\\]$|\\[(?P<residue>[^\\]]+)\\]",
              "token_position": "after_residue"
            }
          }
        }
      }
    }
  ]
}
