{
  "schema_version": "0.11",
  "file_version": "4",
  "software_name": "i2MassChroQ",
  "software_version_pattern": "^1\\..*",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "sample_annotation": {"matching": {"mode": "exact", "normalize": "mass_spec_basename"}},
  "tables": [
    {
      "input": {"shape": "long", "extensions": [".tsv", ".txt"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "obs": {"type": "string", "required": true},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"obs_keys": ["rawfile"], "var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "area",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {"name": "area", "source": "area", "roles": ["abundance"], "missing_values": ["<=0"]}
            ]
          },
          "columns": {
            "obs": [{"name": "rawfile", "source": "rawfile"}],
            "var": [
              {"name": "sequence", "source": "sequence"},
              {"name": "ProForma_peptidoform", "source": "ProForma"},
              {"name": "charge", "source": "charge", "type": "integer"},
              {
                "name": "proteins",
                "source": "proteins",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "apb_Decoy", "how": "unmarked"},
              {"name": "apb_Contaminant", "how": "unmarked"},
              {"name": "ProForma_peptide", "inputs": ["sequence"], "how": "stripped_sequence"},
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "charge"],
                "how": "proforma_ion"
              }
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "^\\[(?P<nterm>[^\\]]+)\\]-|-\\[(?P<cterm>[^\\]]+)\\]$|\\[(?P<residue>[^\\]]+)\\]",
              "token_position": "after_residue"
            }
          }
        }
      }
    }
  ]
}
