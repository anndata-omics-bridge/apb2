{
  "schema_version": "0.4",
  "file_version": "2",
  "software_name": "FragPipe",
  "software_version_pattern": "^2[23]\\.",
  "input": {
    "shape": "wide",
    "extensions": [
      ".tsv"
    ]
  },
  "base": {
    "axis": {
      "obs_keys": [
        "sample"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    },
    "modifications": {
      "source_column": "Modified Sequence",
      "parser": "token_regex",
      "token_pattern": "\\[([^\\]]+)\\]",
      "token_position": "after_residue",
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "57.0215",
          "accession": "UNIMOD:4"
        },
        {
          "token": "15.9949",
          "accession": "UNIMOD:35"
        },
        {
          "token": "42.0106",
          "accession": "UNIMOD:1"
        },
        {
          "token": "-17.026548",
          "accession": "UNIMOD:28"
        },
        {
          "token": "-18.010565",
          "accession": "UNIMOD:27"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity",
        "layers": [
          {
            "name": "Intensity",
            "source": "^(?P<sample>.+) Intensity$",
            "roles": [
              "abundance"
            ],
            "missing_values": [
              0
            ]
          },
          {
            "name": "Spectral_Count",
            "source": "^(?P<sample>.+?)(?:_[12])? Spectral Count$"
          },
          {
            "name": "Apex_Retention_Time",
            "source": "^(?P<sample>.+?)(?:_[12])? Apex Retention Time$"
          },
          {
            "name": "Match_Type",
            "source": "^(?P<sample>.+?)(?:_[12])? Match Type$",
            "encoding_mode": "factor",
            "categories": {
              "unmatched": 0,
              "MS/MS": 1,
              "MBR": 2
            }
          }
        ]
      },
      "columns": {
        "var": [
          {
            "name": "Peptide_Sequence",
            "source": "Peptide Sequence"
          },
          {
            "name": "Modified_Sequence",
            "source": "Modified Sequence"
          },
          {
            "name": "Charge",
            "source": "Charge",
            "type": "integer"
          },
          {
            "name": "M_Z",
            "source": "M/Z",
            "type": "number"
          },
          {
            "name": "Protein",
            "source": "Protein",
            "roles": [
              "protein_assignment",
              "fasta_accessions"
            ],
            "inputs": [
              "Protein",
              "Mapped_Proteins"
            ],
            "how": "join_nonempty",
            "separator": ","
          },
          {
            "name": "Mapped_Proteins",
            "source": "Mapped Proteins"
          },
          {
            "name": "Protein_ID",
            "source": "Protein ID"
          },
          {
            "name": "Gene",
            "source": "Gene"
          },
          {
            "name": "Assigned_Modifications",
            "source": "Assigned Modifications"
          },
          {
            "name": "ProForma_peptidoform",
            "inputs": [
              "Modified_Sequence"
            ],
            "how": "proforma_sequence"
          },
          {
            "name": "ProForma_peptide",
            "inputs": [
              "Modified_Sequence"
            ],
            "how": "stripped_sequence"
          },
          {
            "name": "ProForma_ion",
            "inputs": [
              "ProForma_peptidoform",
              "Charge"
            ],
            "how": "proforma_ion"
          }
        ]
      }
    }
  }
}
