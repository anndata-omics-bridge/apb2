{
  "schema_version": "0.10",
  "file_version": "3",
  "software_name": "FragPipe",
  "software_version_pattern": "^2[23]\\.",
  "tables": [
    {
      "input": {"shape": "wide", "extensions": [".tsv"]},
      "base": {
        "sample_pattern": "(?P<sample>.+?)(?:_[12])?",
        "axis": {"obs_keys": ["sample"]},
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "token_regex",
            "token_pattern": "^n\\[(?P<nterm>[^\\]]+)\\]|c\\[(?P<cterm>[^\\]]+)\\]$|\\[(?P<residue>[^\\]]+)\\]"
          }
        },
        "modification_maps": {
          "basic_modification_map": {
            "57.0215": "UNIMOD:4",
            "15.9949": "UNIMOD:35",
            "42.0106": "UNIMOD:1",
            "-17.026548": "UNIMOD:28",
            "-18.010565": "UNIMOD:27"
          }
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": "{sample} Intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "Spectral_Count", "source": "{sample} Spectral Count", "type": "integer"},
              {"name": "Apex_Retention_Time", "source": "{sample} Apex Retention Time"},
              {"name": "Retention_Time_Start", "source": "{sample} Retention Time Start"},
              {"name": "Retention_Time_End", "source": "{sample} Retention Time End"},
              {"name": "Retention_Time_FWHM", "source": "{sample} Retention Time FWHM"},
              {
                "name": "Match_Type",
                "source": "{sample} Match Type",
                "encoding_mode": "factor",
                "categories": {"unmatched": 0, "MS/MS": 1, "MBR": 2}
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Peptide_Sequence", "source": "Peptide Sequence"},
              {"name": "Modified_Sequence", "source": "Modified Sequence"},
              {"name": "Charge", "source": "Charge", "type": "integer"},
              {"name": "M_Z", "source": "M/Z", "type": "number"},
              {
                "name": "Protein",
                "source": "Protein",
                "roles": ["protein_assignment", "fasta_accessions"],
                "inputs": ["Protein", "Mapped_Proteins"],
                "how": "join_nonempty",
                "separator": ";"
              },
              {"name": "Mapped_Proteins", "source": "Mapped Proteins"},
              {"name": "Protein_ID", "source": "Protein ID"},
              {"name": "Gene", "source": "Gene"},
              {"name": "Assigned_Modifications", "source": "Assigned Modifications"},
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Modified_Sequence"],
                "how": "proforma_sequence"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Modified_Sequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Charge"],
                "how": "proforma_ion"
              },
              {
                "name": "apb_Decoy",
                "inputs": ["Protein"],
                "how": "decoy",
                "prefix": "rev_",
                "separator": ","
              },
              {
                "name": "apb_Contaminant",
                "inputs": ["Protein"],
                "how": "contaminant",
                "prefix": "contam_",
                "separator": ","
              }
            ]
          }
        }
      }
    }
  ]
}
