{
  "schema_version": "0.11",
  "file_version": "4",
  "software_name": "pb_custom",
  "software_version_pattern": "^.*$",
  "hierarchy": "lfq",
  "parameter_file": "none",
  "sample_annotation": {"matching": {"mode": "exact", "normalize": "mass_spec_basename"}},
  "tables": [
    {
      "input": {"shape": "wide", "extensions": [".txt", ".tsv"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"obs_keys": ["sample"], "var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Intensity",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {
                "name": "Intensity",
                "source": "^(?P<sample>.+)$",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Sequence", "source": "Sequence"},
              {
                "name": "Proteins",
                "source": "Proteins",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Charge", "source": "Charge", "type": "integer"},
              {"name": "ProForma_peptidoform", "source": "Modified sequence"},
              {"name": "apb_Decoy", "how": "unmarked"},
              {"name": "apb_Contaminant", "how": "unmarked"},
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Charge"],
                "how": "proforma_ion"
              },
              {"name": "ProForma_peptide", "inputs": ["Sequence"], "how": "stripped_sequence"}
            ]
          },
          "sequence_syntax": {"plain_sequence": {"parser": "plain_sequence"}}
        }
      }
    }
  ]
}
