{
  "schema_version": "0.8",
  "file_version": "1",
  "software_name": "DIA-NN",
  "software_version_pattern": "^1\\.[0-7](\\.|$)",
  "sample_annotation": {
    "matching": {
      "mode": "exact",
      "normalize": "mass_spec_basename"
    }
