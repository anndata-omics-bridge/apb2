              {
                "name": "Protein_Group",
                "source": "Protein.Group",
                "roles": [
                  "protein_assignment"
                ]
              },
              {
                "name": "Protein_Ids",
                "source": "Protein.Ids",
                "roles": [
                  "fasta_accessions"
                ]
              },
              {
                "name": "Protein_Names",
                "source": "Protein.Names"
              },
              {
                "name": "Genes",
