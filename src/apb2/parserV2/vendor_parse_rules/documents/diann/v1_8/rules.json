{
  "schema_version": "0.11",
  "file_version": "6",
  "software_name": "DIA-NN",
  "software_version_pattern": "^1\\.[89](\\.|$)",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "sample_annotation": {"matching": {"mode": "exact", "normalize": "mass_spec_basename"}},
  "tables": [
    {
      "input": {
        "shape": "long",
        "extensions": [".tsv", ".txt", ".parquet"],
        "without_parameter_file": {
          "required_columns": ["PG.Normalised", "Lib.PG.Q.Value"],
          "acquisition_method": {"otherwise": "unknown"}
        }
      },
      "base": {
        "defaults": {
          "var": {"type": "string", "required": false, "per_feature": "first"},
          "obs": {"type": "string", "required": false},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "axis": {"obs_keys": ["Run"]},
        "columns": {
          "obs": [
            {"name": "Run", "source": "Run", "required": true},
            {"name": "File_Name", "source": "File.Name"},
            {"name": "Run_Index", "source": "Run.Index", "type": "integer"}
          ],
          "var": [
            {"name": "Decoy", "source": "Decoy", "type": "boolean"},
            {"name": "apb_Decoy", "inputs": ["Decoy"], "how": "decoy", "equals": "true"},
            {"name": "apb_Contaminant", "how": "unmarked"}
          ]
        },
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "token_regex",
            "token_pattern": "^\\((?P<nterm>[^()]*)\\)|\\((?P<residue>[^()]*)\\)",
            "token_position": "after_residue"
          }
        },
        "modification_map": {
          "UniMod:1": "UNIMOD:1",
          "UniMod:4": "UNIMOD:4",
          "UniMod:35": "UNIMOD:35",
          "UniMod:21": "UNIMOD:21",
          "UniMod:121": "UNIMOD:121"
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Precursor_Normalised",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {
                "name": "Precursor_Normalised",
                "source": "Precursor.Normalised",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Ms1_Normalised",
                "source": "Ms1.Normalised",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Precursor_Quantity",
                "source": "Precursor.Quantity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Ms1_Area",
                "source": "Ms1.Area",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "Q_Value", "source": "Q.Value"},
              {"name": "PEP", "source": "PEP"},
              {"name": "RT", "source": "RT"},
              {"name": "Averagine", "source": "Averagine"},
              {"name": "CScore", "source": "CScore"},
              {"name": "Channel_Q_Value", "source": "Channel.Q.Value"},
              {"name": "Decoy_CScore", "source": "Decoy.CScore"},
              {"name": "Decoy_Evidence", "source": "Decoy.Evidence"},
              {"name": "Empirical_Quality", "source": "Empirical.Quality"},
              {"name": "Evidence", "source": "Evidence"},
              {"name": "FWHM", "source": "FWHM"},
              {"name": "GG_Q_Value", "source": "GG.Q.Value"},
              {"name": "IM", "source": "IM"},
              {"name": "MS2_Scan", "source": "MS2.Scan"},
              {"name": "Mass_Evidence", "source": "Mass.Evidence"},
              {"name": "Ms1_Apex_Area", "source": "Ms1.Apex.Area"},
              {"name": "Ms1_Apex_Mz_Delta", "source": "Ms1.Apex.Mz.Delta"},
              {"name": "Ms1_Profile_Corr", "source": "Ms1.Profile.Corr"},
              {"name": "Ms1_Total_Signal_After", "source": "Ms1.Total.Signal.After"},
              {"name": "Ms1_Total_Signal_Before", "source": "Ms1.Total.Signal.Before"},
              {"name": "Ms1_Translated", "source": "Ms1.Translated"},
              {"name": "Normalisation_Factor", "source": "Normalisation.Factor"},
              {"name": "Normalisation_Noise", "source": "Normalisation.Noise"},
              {"name": "PTM_Informative", "source": "PTM.Informative"},
              {"name": "PTM_Localising", "source": "PTM.Localising"},
              {"name": "PTM_Q_Value", "source": "PTM.Q.Value"},
              {"name": "PTM_Site_Confidence", "source": "PTM.Site.Confidence"},
              {"name": "PTM_Specific", "source": "PTM.Specific"},
              {"name": "Peptidoform_Q_Value", "source": "Peptidoform.Q.Value"},
              {"name": "Precursor_Translated", "source": "Precursor.Translated"},
              {
                "name": "Predicted_IM",
                "source": "Predicted.IM",
                "note": "A layer: calibrated per run, so it differs across runs on timsTOF"
              },
              {"name": "Predicted_RT", "source": "Predicted.RT"},
              {
                "name": "Predicted_iIM",
                "source": "Predicted.iIM",
                "note": "A layer: differs across runs on timsTOF, like Predicted_IM"
              },
              {"name": "Predicted_iRT", "source": "Predicted.iRT"},
              {"name": "Protein_Q_Value", "source": "Protein.Q.Value"},
              {"name": "Quantity_Quality", "source": "Quantity.Quality"},
              {"name": "RT_Start", "source": "RT.Start"},
              {"name": "RT_Stop", "source": "RT.Stop"},
              {"name": "Spectrum_Similarity", "source": "Spectrum.Similarity"},
              {"name": "Translated_Q_Value", "source": "Translated.Q.Value"},
              {"name": "Translated_Quality", "source": "Translated.Quality"}
            ]
          },
          "columns": {
            "var": [
              {"name": "Modified_Sequence", "source": "Modified.Sequence", "required": true},
              {"name": "Stripped_Sequence", "source": "Stripped.Sequence", "required": true},
              {
                "name": "Precursor_Charge",
                "source": "Precursor.Charge",
                "type": "integer",
                "required": true
              },
              {"name": "Precursor_Id", "source": "Precursor.Id", "required": true},
              {
                "name": "Protein_Group",
                "source": "Protein.Group",
                "required": true,
                "roles": ["protein_assignment"]
              },
              {
                "name": "Protein_Ids",
                "source": "Protein.Ids",
                "required": true,
                "roles": ["fasta_accessions"]
              },
              {"name": "Protein_Names", "source": "Protein.Names", "required": true},
              {"name": "Genes", "source": "Genes", "required": true},
              {"name": "Proteotypic", "source": "Proteotypic", "type": "boolean"},
              {"name": "Channel", "source": "Channel"},
              {"name": "Lib_Q_Value", "source": "Lib.Q.Value", "type": "number"},
              {"name": "Global_Q_Value", "source": "Global.Q.Value", "type": "number"},
              {
                "name": "Lib_PTM_Site_Confidence",
                "source": "Lib.PTM.Site.Confidence",
                "type": "number"
              },
              {
                "name": "Lib_Peptidoform_Q_Value",
                "source": "Lib.Peptidoform.Q.Value",
                "type": "number"
              },
              {
                "name": "Global_Peptidoform_Q_Value",
                "source": "Global.Peptidoform.Q.Value",
                "type": "number"
              },
              {"name": "Precursor_Channels_Group", "source": "Precursor.Channels.Group"},
              {"name": "Precursor_Lib_Index", "source": "Precursor.Lib.Index", "type": "integer"},
              {"name": "Precursor_Mz", "source": "Precursor.Mz", "type": "number"},
              {"name": "Protein_Sites", "source": "Protein.Sites"},
              {"name": "Site_Occupancy_Probabilities", "source": "Site.Occupancy.Probabilities"},
              {"name": "iIM", "source": "iIM", "type": "number"},
              {"name": "iRT", "source": "iRT", "type": "number"},
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Modified_Sequence"],
                "how": "proforma_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Modified_Sequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Precursor_Charge"],
                "how": "proforma_ion"
              }
            ]
          }
        },
        "peptidoform_fragment": {
          "axis": {"var_keys": ["ProForma_fragment"]},
          "measurements": {
            "primary_layer": "Fragment_Quant_Raw",
            "repeated_cells": {"mode": "error"},
            "layers": [
              {
                "name": "Fragment_Quant_Raw",
                "source": "Fragment.Quant.Raw",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "Fragment_Correlations", "source": "Fragment.Correlations"}
            ]
          },
          "columns": {
            "var": [
              {"name": "Modified_Sequence", "source": "Modified.Sequence", "required": true},
              {
                "name": "Precursor_Charge",
                "source": "Precursor.Charge",
                "type": "integer",
                "required": true
              },
              {
                "name": "Protein_Group",
                "source": "Protein.Group",
                "required": true,
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Modified_Sequence"],
                "how": "proforma_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Modified_Sequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Precursor_Charge"],
                "how": "proforma_ion"
              },
              {
                "name": "ProForma_fragment",
                "inputs": ["ProForma_ion", "fragment_label"],
                "how": "proforma_fragment"
              }
            ]
          },
          "fragments": {
            "label_strategy": "column",
            "value_columns": ["Fragment.Quant.Raw", "Fragment.Correlations"],
            "label_column": "Fragment.Info",
            "label_required": false,
            "delimiter": ";",
            "label_output": "fragment_label"
          }
        },
        "protein": {
          "axis": {"var_keys": ["Protein_Group"]},
          "measurements": {
            "primary_layer": "PG_MaxLFQ",
            "repeated_cells": {"mode": "same"},
            "layers": [
              {
                "name": "PG_MaxLFQ",
                "source": "PG.MaxLFQ",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "PG_Normalised",
                "source": "PG.Normalised",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "PG_Quantity",
                "source": "PG.Quantity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Genes_MaxLFQ",
                "source": "Genes.MaxLFQ",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "PG_Q_Value", "source": "PG.Q.Value"},
              {"name": "Genes_MaxLFQ_Unique", "source": "Genes.MaxLFQ.Unique"},
              {"name": "Genes_Normalised", "source": "Genes.Normalised"},
              {"name": "Genes_Quantity", "source": "Genes.Quantity"},
              {"name": "PG_MaxLFQ_Quality", "source": "PG.MaxLFQ.Quality"},
              {"name": "PG_PEP", "source": "PG.PEP"}
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Protein_Group",
                "source": "Protein.Group",
                "required": true,
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Protein_Names", "source": "Protein.Names", "required": true},
              {"name": "Genes", "source": "Genes", "required": true},
              {"name": "First_Protein_Description", "source": "First.Protein.Description"},
              {
                "name": "Lib_PG_Q_Value",
                "source": "Lib.PG.Q.Value",
                "type": "number",
                "per_feature": "min",
                "note": "The smallest per group, as for Global_PG_Q_Value"
              },
              {
                "name": "Global_PG_Q_Value",
                "source": "Global.PG.Q.Value",
                "type": "number",
                "per_feature": "min",
                "note": "DIA-NN writes 1.0 into the rows of precursors without a global q-value, so a group takes its smallest"
              }
            ]
          }
        }
      }
    }
  ]
}
