{
  "schema_version": "0.4",
  "file_version": "4",
  "software_name": "DIA-NN",
  "software_version_pattern": "^2\\..*",
  "input": {
    "shape": "long",
    "extensions": [
      ".parquet"
    ]
  },
  "base": {
    "axis": {
      "obs_keys": [
        "Run"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    },
    "columns": {
      "obs": [
        {
          "name": "Run",
          "source": "Run"
        }
      ]
    },
    "modifications": {
      "source_column": "Modified.Sequence",
      "parser": "token_regex",
      "token_pattern": "\\(([^()]*)\\)",
      "token_position": "after_residue",
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "UniMod:1",
          "accession": "UNIMOD:1"
        },
        {
          "token": "UniMod:4",
          "accession": "UNIMOD:4"
        },
        {
          "token": "UniMod:35",
          "accession": "UNIMOD:35"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Precursor_Normalised",
        "layers": [
          {
            "name": "Ms1_Normalised",
            "source": "Ms1.Normalised",
            "roles": [
              "abundance"
            ]
          },
          {
            "name": "Precursor_Normalised",
            "source": "Precursor.Normalised",
            "roles": [
              "abundance"
            ]
          },
          {
            "name": "Precursor_Quantity",
            "source": "Precursor.Quantity"
          },
          {
            "name": "Ms1_Area",
            "source": "Ms1.Area"
          },
          {
            "name": "Q_Value",
            "source": "Q.Value"
          },
          {
            "name": "RT",
            "source": "RT"
          }
        ]
      },
      "search_parameter_overrides": [
        {
          "when_search_parameters": {
            "acquisition_method": "DDA"
          },
          "primary_layer": "Ms1_Normalised"
        }
      ],
      "columns": {
        "var": [
          {
            "name": "Modified_Sequence",
            "source": "Modified.Sequence"
          },
          {
            "name": "Stripped_Sequence",
            "source": "Stripped.Sequence"
          },
          {
            "name": "Precursor_Charge",
            "source": "Precursor.Charge",
            "type": "integer"
          },
          {
            "name": "Precursor_Id",
            "source": "Precursor.Id"
          },
          {
            "name": "Protein_Group",
            "source": "Protein.Group",
            "roles": [
              "protein_assignment"
            ]
          },
          {
            "name": "Protein_Ids",
            "source": "Protein.Ids",
            "roles": [
              "fasta_accessions"
            ]
          },
          {
            "name": "Protein_Names",
            "source": "Protein.Names"
          },
          {
            "name": "Genes",
            "source": "Genes"
          },
          {
            "name": "ProForma_peptidoform",
            "inputs": [
              "Modified_Sequence"
            ],
            "how": "proforma_sequence"
          },
          {
            "name": "ProForma_peptide",
            "inputs": [
              "Modified_Sequence"
            ],
            "how": "stripped_sequence"
          },
          {
            "name": "ProForma_ion",
            "inputs": [
              "ProForma_peptidoform",
              "Precursor_Charge"
            ],
            "how": "proforma_ion"
          }
        ]
      }
    },
    "protein": {
      "axis": {
        "var_keys": [
          "Protein_Group"
        ]
      },
      "measurements": {
        "primary_layer": "PG_MaxLFQ",
        "duplicates": {
          "mode": "keep_first"
        },
        "layers": [
          {
            "name": "PG_MaxLFQ",
            "source": "PG.MaxLFQ",
            "roles": [
              "abundance"
            ]
          },
          {
            "name": "Genes_MaxLFQ",
            "source": "Genes.MaxLFQ"
          }
        ]
      },
      "columns": {
        "var": [
          {
            "name": "Protein_Group",
            "source": "Protein.Group",
            "roles": [
              "protein_assignment"
            ]
          },
          {
            "name": "Protein_Ids",
            "source": "Protein.Ids",
            "roles": [
              "fasta_accessions"
            ]
          },
          {
            "name": "Protein_Names",
            "source": "Protein.Names"
          },
          {
            "name": "Genes",
            "source": "Genes"
          }
        ]
      }
    }
  }
}
