{
  "schema_version": "0.10",
  "file_version": "3",
  "software_name": "MaxQuant",
  "software_version_pattern": "^(1\\.5|1\\.6|2\\.)",
  "tables": [
    {
      "prepare": {"how": "maxquant_evidence"},
      "input": {"shape": "long", "extensions": [".txt"]},
      "base": {
        "axis": {"obs_keys": ["Raw_File"]},
        "columns": {
          "obs": [
            {"name": "Raw_File", "source": "Raw file"},
            {"name": "Experiment", "source": "Experiment", "required": false},
            {"name": "Fraction", "source": "Fraction", "required": false}
          ]
        },
        "measurements": {
          "repeated_cells": {
            "mode": "keep_best",
            "by": "PEP",
            "best": "lowest",
            "sum": ["Intensity", "MS_MS_Count"]
          },
          "primary_layer": "Intensity"
        }
      },
      "levels": {
        "peptidoform_ion": {
          "source_prefix": "evidence.",
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "MS_MS_Count", "source": "MS/MS count", "type": "integer"},
              {"name": "Retention_Time", "source": "Retention time"},
              {"name": "Retention_Length", "source": "Retention length"},
              {
                "name": "Calibrated_Retention_Time",
                "source": "Calibrated retention time",
                "note": "Retention time after MaxQuant aligns the runs for matching between runs; equal to Retention_Time when no calibration was applied"
              },
              {
                "name": "Calibrated_Retention_Time_Start",
                "source": "Calibrated retention time start"
              },
              {
                "name": "Calibrated_Retention_Time_Finish",
                "source": "Calibrated retention time finish"
              },
              {"name": "Score", "source": "Score"},
              {"name": "PEP", "source": "PEP", "required": true},
              {
                "name": "Type",
                "source": "Type",
                "encoding_mode": "factor",
                "categories": {
                  "MSMS": 0,
                  "ISO-MSMS": 1,
                  "MULTI-MSMS": 2,
                  "ISO-SECPEP": 3,
                  "MULTI-SECPEP": 4,
                  "MULTI-MATCH": 5,
                  "MULTI-MATCH-MSMS": 6
                },
                "note": "How MaxQuant identified the evidence row: MULTI-MATCH by matching between runs, the MSMS kinds by MS/MS. Categories from the MaxQuant output-table documentation, plus MULTI-MATCH-MSMS, which reports write but the documentation omits, and ISO-SECPEP"
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Sequence", "source": "Sequence"},
              {"name": "Modified_Sequence", "source": "Modified sequence"},
              {"name": "Modifications", "source": "Modifications"},
              {"name": "Charge", "source": "Charge", "type": "integer"},
              {"name": "Mass", "source": "Mass", "type": "number"},
              {
                "name": "Proteins",
                "source": "Proteins",
                "roles": ["fasta_accessions"],
                "inputs": ["Proteins", "Leading_Proteins", "Leading_Proteins_Legacy"],
                "how": "coalesce"
              },
              {"name": "Leading_Proteins", "source": "Leading proteins", "required": false},
              {
                "name": "Leading_Razor_Protein",
                "source": "Leading razor protein",
                "required": false
              },
              {"name": "Leading_Proteins_Legacy", "source": "Leading Proteins", "required": false},
              {
                "name": "Leading_Razor_Protein_Legacy",
                "source": "Leading Razor Protein",
                "required": false
              },
              {
                "name": "Razor_Protein_Group",
                "source": "Protein IDs",
                "source_prefix": "protein.",
                "required": false
              },
              {
                "name": "Protein_IDs",
                "roles": ["protein_assignment"],
                "inputs": ["Razor_Protein_Group", "Proteins"],
                "how": "coalesce"
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Modified_Sequence"],
                "how": "proforma_sequence"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Modified_Sequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Charge"],
                "how": "proforma_ion"
              },
              {"name": "Reverse", "source": "Reverse", "required": false},
              {"name": "Decoy", "source": "Decoy", "required": false},
              {
                "name": "Potential_Contaminant",
                "source": "Potential contaminant",
                "required": false
              },
              {"name": "apb_Decoy", "inputs": ["Reverse", "Decoy"], "how": "decoy", "equals": "+"},
              {
                "name": "apb_Contaminant",
                "inputs": ["Potential_Contaminant"],
                "how": "contaminant",
                "equals": "+"
              }
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "^\\((?P<nterm>[^()]*(?:\\([^()]*\\)[^()]*)*)\\)|\\((?P<residue>[^()]*(?:\\([^()]*\\)[^()]*)*)\\)"
            }
          },
          "modification_maps": {
            "basic_modification_map": {
              "ac": "UNIMOD:1",
              "ox": "UNIMOD:35",
              "Acetyl (Protein N-term)": "UNIMOD:1",
              "Oxidation (M)": "UNIMOD:35",
              "Carbamidomethyl (C)": "UNIMOD:4"
            }
          }
        }
      }
    },
    {
      "prepare": {"how": "maxquant_wide"},
      "input": {"shape": "wide", "extensions": [".txt"]},
      "base": {
        "axis": {"obs_keys": ["Experiment"]},
        "measurements": {"repeated_cells": {"mode": "same"}, "primary_layer": "Intensity"},
        "columns": {
          "var": [
            {"name": "apb_Decoy", "inputs": ["Reverse", "Decoy"], "how": "decoy", "equals": "+"},
            {
              "name": "apb_Contaminant",
              "inputs": ["Potential_Contaminant"],
              "how": "contaminant",
              "equals": "+"
            },
            {"name": "Score", "source": "Score", "required": false},
            {"name": "Reverse", "source": "Reverse", "required": false},
            {"name": "Decoy", "source": "Decoy", "required": false},
            {"name": "Potential_Contaminant", "source": "Potential contaminant", "required": false}
          ]
        }
      },
      "levels": {
        "peptidoform": {
          "source_prefix": "peptidoform.",
          "axis": {"var_keys": ["ProForma_peptidoform_unlocalized"]},
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_Type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1},
                "note": "Whether the feature was identified by MS/MS in this sample or only transferred by matching between runs"
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "ProForma_peptide", "source": "Sequence"},
              {"name": "Modifications", "source": "Modifications"},
              {
                "name": "Proteins",
                "source": "Proteins",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Protein_Groups", "source": "Protein Groups", "required": false},
              {"name": "Mass", "source": "Mass", "required": false},
              {
                "name": "Missed_Cleavages",
                "source": "Missed cleavages",
                "type": "integer",
                "required": false
              },
              {"name": "Charges", "source": "Charges", "required": false},
              {"name": "PEP", "source": "PEP", "required": false},
              {"name": "Delta_Score", "source": "Delta score", "required": false},
              {
                "name": "Retention_Time",
                "source": "Retention time",
                "type": "number",
                "required": false
              },
              {
                "name": "Calibrated_Retention_Time",
                "source": "Calibrated retention time",
                "type": "number",
                "required": false
              },
              {"name": "Unique_Groups", "source": "Unique (Groups)", "required": false},
              {"name": "Unique_Proteins", "source": "Unique (Proteins)", "required": false},
              {
                "name": "ProForma_peptidoform_unlocalized",
                "inputs": ["ProForma_peptide", "Modifications"],
                "how": "proforma_sequence",
                "note": "Modifications names each modification with its count and candidate residues, such as '2 Oxidation (M)', never a position, so positional isomers share a row; this string identifies the row"
              }
            ]
          },
          "sequence_syntax": {
            "modification_names": {
              "parser": "embedded_site_list",
              "delimiter": ",",
              "entry_pattern": "^(?:(?P<count>\\d+) )?(?P<token>.+ \\((?P<site>[^()]+)\\))$|^Unmodified$"
            }
          },
          "modification_maps": {
            "modification_names_map": {
              "Acetyl (Protein N-term)": "UNIMOD:1",
              "Oxidation (M)": "UNIMOD:35",
              "Carbamidomethyl (C)": "UNIMOD:4"
            }
          }
        },
        "peptide": {
          "source_prefix": "peptide.",
          "axis": {"var_keys": ["ProForma_peptide"]},
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "LFQ_Intensity",
                "source": "LFQ intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_Type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1},
                "note": "Whether the feature was identified by MS/MS in this sample or only transferred by matching between runs"
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "ProForma_peptide", "source": "Sequence"},
              {"name": "Proteins", "source": "Proteins", "roles": ["fasta_accessions"]},
              {"name": "Leading_Razor_Protein", "source": "Leading razor protein"},
              {
                "name": "Razor_Protein_Group",
                "source": "Protein IDs",
                "source_prefix": "protein.",
                "required": false,
                "note": "proteinGroups.txt lists only razor evidence, so each peptide joins the one group its leading razor protein belongs to"
              },
              {
                "name": "Protein_IDs",
                "roles": ["protein_assignment"],
                "inputs": ["Razor_Protein_Group", "Leading_Razor_Protein"],
                "how": "coalesce"
              },
              {"name": "Gene_Names", "source": "Gene names", "required": false},
              {"name": "Protein_Names", "source": "Protein names", "required": false},
              {"name": "Length", "source": "Length", "type": "integer", "required": false},
              {
                "name": "Missed_Cleavages",
                "source": "Missed cleavages",
                "type": "integer",
                "required": false
              },
              {"name": "Mass", "source": "Mass", "required": false},
              {"name": "Charges", "source": "Charges", "required": false},
              {"name": "PEP", "source": "PEP", "required": false},
              {"name": "Start_Position", "source": "Start position", "required": false},
              {"name": "End_Position", "source": "End position", "required": false},
              {"name": "Unique_Groups", "source": "Unique (Groups)", "required": false},
              {"name": "Unique_Proteins", "source": "Unique (Proteins)", "required": false}
            ]
          }
        },
        "protein": {
          "source_prefix": "protein.",
          "axis": {"var_keys": ["Protein_IDs"]},
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "LFQ_Intensity",
                "source": "LFQ intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "iBAQ",
                "source": "iBAQ {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_Type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1},
                "note": "Whether the feature was identified by MS/MS in this sample or only transferred by matching between runs"
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Protein_IDs",
                "source": "Protein IDs",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Majority_Protein_IDs", "source": "Majority protein IDs", "required": false},
              {"name": "Fasta_Headers", "source": "Fasta headers", "required": false},
              {"name": "Gene_Names", "source": "Gene names", "required": false},
              {"name": "Protein_Names", "source": "Protein names", "required": false},
              {
                "name": "Number_Of_Proteins",
                "source": "Number of proteins",
                "type": "integer",
                "required": false
              },
              {"name": "Peptides", "source": "Peptides", "type": "integer", "required": false},
              {
                "name": "Razor_Unique_Peptides",
                "source": "Razor + unique peptides",
                "type": "integer",
                "required": false
              },
              {
                "name": "Unique_Peptides",
                "source": "Unique peptides",
                "type": "integer",
                "required": false
              },
              {
                "name": "Sequence_Coverage_Percent",
                "source": "Sequence coverage [%]",
                "required": false
              },
              {"name": "Mol_Weight_kDa", "source": "Mol. weight [kDa]", "required": false},
              {"name": "Q_Value", "source": "Q-value", "required": false},
              {
                "name": "Only_Identified_By_Site",
                "source": "Only identified by site",
                "required": false
              }
            ]
          }
        }
      }
    }
  ]
}
