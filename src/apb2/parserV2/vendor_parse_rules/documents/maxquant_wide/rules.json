{
  "schema_version": "0.11",
  "file_version": "6",
  "software_name": "MaxQuant",
  "software_version_pattern": "^(1\\.5|1\\.6|2\\.)",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "tables": [
    {
      "prepare": {"how": "maxquant_evidence"},
      "input": {"shape": "long", "extensions": [".txt"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": false, "per_feature": "first"},
          "obs": {"type": "string", "required": false},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        }
      },
      "levels": {
        "peptidoform_ion": {
          "source_prefix": "evidence.",
          "axis": {"obs_keys": ["Raw_file"], "var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "Intensity",
            "repeated_cells": {
              "mode": "keep_best",
              "by": "PEP",
              "best": "lowest",
              "sum": ["Intensity", "MS_MS_count"]
            },
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "MS_MS_count",
                "source": "MS/MS Count",
                "version": "^1\\.5\\.[0-7](\\.|$)",
                "type": "integer"
              },
              {
                "name": "MS_MS_count",
                "source": "MS/MS count",
                "version": "^(1\\.5\\.([89]|\\d{2,})|1\\.6|2\\.)",
                "type": "integer"
              },
              {"name": "Retention_time", "source": "Retention time"},
              {"name": "Retention_length", "source": "Retention length"},
              {"name": "Calibrated_retention_time", "source": "Calibrated retention time"},
              {
                "name": "Calibrated_retention_time_start",
                "source": "Calibrated retention time start"
              },
              {
                "name": "Calibrated_retention_time_finish",
                "source": "Calibrated retention time finish"
              },
              {"name": "Score", "source": "Score"},
              {"name": "PEP", "source": "PEP"},
              {
                "name": "Type",
                "source": "Type",
                "encoding_mode": "factor",
                "categories": {
                  "MSMS": 0,
                  "ISO-MSMS": 1,
                  "MULTI-MSMS": 2,
                  "ISO-SECPEP": 3,
                  "MULTI-SECPEP": 4,
                  "MULTI-MATCH": 5,
                  "MULTI-MATCH-MSMS": 6
                },
                "note": "MaxQuant writes MULTI-MATCH-MSMS and ISO-SECPEP, which its documentation omits"
              }
            ]
          },
          "columns": {
            "obs": [
              {"name": "Raw_file", "source": "Raw file", "required": true},
              {"name": "Experiment", "source": "Experiment"},
              {"name": "Fraction", "source": "Fraction"}
            ],
            "var": [
              {"name": "Sequence", "source": "Sequence", "required": true},
              {"name": "Modified_sequence", "source": "Modified sequence", "required": true},
              {"name": "Modifications", "source": "Modifications", "required": true},
              {"name": "Charge", "source": "Charge", "type": "integer", "required": true},
              {"name": "Mass", "source": "Mass", "type": "number", "required": true},
              {
                "name": "Proteins",
                "source": "Proteins",
                "inputs": ["Proteins", "Leading_proteins"],
                "how": "coalesce",
                "roles": ["fasta_accessions"]
              },
              {
                "name": "Leading_proteins",
                "source": "Leading Proteins",
                "version": "^1\\.5\\.[0-2](\\.|$)"
              },
              {
                "name": "Leading_proteins",
                "source": "Leading proteins",
                "version": "^(1\\.5\\.([3-9]|\\d{2,})|1\\.6|2\\.)"
              },
              {
                "name": "Leading_razor_protein",
                "source": "Leading Razor Protein",
                "version": "^1\\.5\\.[0-2](\\.|$)"
              },
              {
                "name": "Leading_razor_protein",
                "source": "Leading razor protein",
                "version": "^(1\\.5\\.([3-9]|\\d{2,})|1\\.6|2\\.[0-7](\\.|$))"
              },
              {
                "name": "Leading_razor_protein",
                "source": "Leading razor proteins",
                "version": "^2\\.([89]|\\d{2,})(\\.|$)"
              },
              {"name": "protein_Protein_IDs", "source": "Protein IDs", "source_prefix": "protein."},
              {
                "name": "Protein_IDs",
                "inputs": ["protein_Protein_IDs", "Proteins"],
                "how": "coalesce",
                "roles": ["protein_assignment"]
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Modified_sequence"],
                "how": "proforma_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Modified_sequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Charge"],
                "how": "proforma_ion"
              },
              {"name": "Reverse", "source": "Reverse", "version": "^(1\\.|2\\.[0-7](\\.|$))"},
              {"name": "Reverse", "source": "Decoy", "version": "^2\\.([89]|\\d{2,})(\\.|$)"},
              {"name": "Potential_contaminant", "source": "Potential contaminant"},
              {"name": "apb_Decoy", "inputs": ["Reverse"], "how": "decoy", "equals": "+"},
              {
                "name": "apb_Contaminant",
                "inputs": ["Potential_contaminant"],
                "how": "contaminant",
                "equals": "+"
              }
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "^\\((?P<nterm>[^()]*(?:\\([^()]*\\)[^()]*)*)\\)|\\((?P<residue>[^()]*(?:\\([^()]*\\)[^()]*)*)\\)",
              "token_position": "after_residue"
            }
          },
          "modification_map": {
            "ac": "UNIMOD:1",
            "ox": "UNIMOD:35",
            "Acetyl (Protein N-term)": "UNIMOD:1",
            "Oxidation (M)": "UNIMOD:35",
            "Carbamidomethyl (C)": "UNIMOD:4"
          }
        }
      }
    },
    {
      "prepare": {"how": "maxquant_wide"},
      "input": {"shape": "wide", "extensions": [".txt"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": false, "per_feature": "first"},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "sample_pattern": "(?P<sample>.+)",
        "axis": {"obs_keys": ["Experiment"]},
        "measurements": {"repeated_cells": {"mode": "same"}},
        "columns": {
          "var": [
            {"name": "Score", "source": "Score", "type": "number", "missing_tokens": ["NaN"]},
            {"name": "Reverse", "source": "Reverse", "version": "^(1\\.|2\\.[0-7](\\.|$))"},
            {"name": "Reverse", "source": "Decoy", "version": "^2\\.([89]|\\d{2,})(\\.|$)"},
            {"name": "Potential_contaminant", "source": "Potential contaminant"},
            {"name": "apb_Decoy", "inputs": ["Reverse"], "how": "decoy", "equals": "+"},
            {
              "name": "apb_Contaminant",
              "inputs": ["Potential_contaminant"],
              "how": "contaminant",
              "equals": "+"
            }
          ]
        }
      },
      "levels": {
        "peptidoform": {
          "source_prefix": "peptidoform.",
          "axis": {"var_keys": ["ProForma_peptidoform_unlocalized"]},
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1}
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Sequence", "source": "Sequence", "required": true},
              {"name": "Modifications", "source": "Modifications", "required": true},
              {
                "name": "Proteins",
                "source": "Proteins",
                "required": true,
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Protein_Groups", "source": "Protein Groups"},
              {"name": "Mass", "source": "Mass", "type": "number"},
              {"name": "Missed_cleavages", "source": "Missed cleavages", "type": "integer"},
              {"name": "Charges", "source": "Charges"},
              {"name": "PEP", "source": "PEP", "type": "number"},
              {
                "name": "Delta_score",
                "source": "Delta score",
                "type": "number",
                "missing_tokens": ["NaN"]
              },
              {"name": "Retention_time", "source": "Retention time", "type": "number"},
              {
                "name": "Calibrated_retention_time",
                "source": "Calibrated retention time",
                "type": "number"
              },
              {"name": "Unique_Groups", "source": "Unique (Groups)"},
              {"name": "Unique_Proteins", "source": "Unique (Proteins)"},
              {
                "name": "ProForma_peptidoform_unlocalized",
                "inputs": ["Sequence", "Modifications"],
                "how": "proforma_sequence",
                "case_sensitive": false,
                "unknown_policy": "preserve",
                "syntax": "modification_names"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Sequence"],
                "how": "stripped_sequence",
                "syntax": "plain_sequence"
              }
            ]
          },
          "sequence_syntax": {
            "modification_names": {
              "parser": "embedded_site_list",
              "delimiter": ",",
              "entry_pattern": "^(?:(?P<count>\\d+) )?(?P<token>.+ \\((?P<site>[^()]+)\\))$|^Unmodified$",
              "site_base": 1
            },
            "plain_sequence": {"parser": "plain_sequence"}
          },
          "modification_map": {
            "Acetyl (Protein N-term)": "UNIMOD:1",
            "Oxidation (M)": "UNIMOD:35",
            "Carbamidomethyl (C)": "UNIMOD:4"
          }
        },
        "peptide": {
          "source_prefix": "peptide.",
          "axis": {"var_keys": ["ProForma_peptide"]},
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "LFQ_intensity",
                "source": "LFQ intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1}
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Sequence", "source": "Sequence", "required": true},
              {
                "name": "Proteins",
                "source": "Proteins",
                "required": true,
                "roles": ["fasta_accessions"]
              },
              {
                "name": "Leading_razor_protein",
                "source": "Leading razor protein",
                "required": true
              },
              {
                "name": "protein_Protein_IDs",
                "source": "Protein IDs",
                "source_prefix": "protein.",
                "note": "The group of the peptide's leading razor protein only"
              },
              {
                "name": "Protein_IDs",
                "inputs": ["protein_Protein_IDs", "Leading_razor_protein"],
                "how": "coalesce",
                "roles": ["protein_assignment"]
              },
              {"name": "Gene_names", "source": "Gene names"},
              {"name": "Protein_names", "source": "Protein names"},
              {"name": "Length", "source": "Length", "type": "integer"},
              {"name": "Missed_cleavages", "source": "Missed cleavages", "type": "integer"},
              {"name": "Mass", "source": "Mass", "type": "number"},
              {"name": "Charges", "source": "Charges"},
              {"name": "PEP", "source": "PEP", "type": "number"},
              {"name": "Start_position", "source": "Start position", "type": "integer"},
              {"name": "End_position", "source": "End position", "type": "integer"},
              {"name": "Unique_Groups", "source": "Unique (Groups)"},
              {"name": "Unique_Proteins", "source": "Unique (Proteins)"},
              {"name": "ProForma_peptide", "inputs": ["Sequence"], "how": "stripped_sequence"}
            ]
          },
          "sequence_syntax": {"plain_sequence": {"parser": "plain_sequence"}}
        },
        "protein": {
          "source_prefix": "protein.",
          "axis": {"var_keys": ["Protein_IDs"]},
          "measurements": {
            "primary_layer": "Intensity",
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "LFQ_intensity",
                "source": "LFQ intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "iBAQ",
                "source": "iBAQ {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1}
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Protein_IDs",
                "source": "Protein IDs",
                "required": true,
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Majority_protein_IDs", "source": "Majority protein IDs"},
              {"name": "Fasta_headers", "source": "Fasta headers"},
              {"name": "Gene_names", "source": "Gene names"},
              {"name": "Protein_names", "source": "Protein names"},
              {"name": "Number_of_proteins", "source": "Number of proteins", "type": "integer"},
              {"name": "Peptides", "source": "Peptides", "type": "integer"},
              {
                "name": "Razor_unique_peptides",
                "source": "Razor + unique peptides",
                "type": "integer"
              },
              {"name": "Unique_peptides", "source": "Unique peptides", "type": "integer"},
              {
                "name": "Sequence_coverage_percent",
                "source": "Sequence coverage [%]",
                "type": "number"
              },
              {"name": "Mol_weight_kDa", "source": "Mol. weight [kDa]", "type": "number"},
              {"name": "Q_value", "source": "Q-value", "type": "number"},
              {"name": "Only_identified_by_site", "source": "Only identified by site"}
            ]
          }
        }
      }
    }
  ]
}
