{
  "schema_version": "0.10",
  "file_version": "4",
  "software_name": "MaxQuant",
  "software_version_pattern": "^(1\\.5|1\\.6|2\\.)",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "tables": [
    {
      "prepare": {"how": "maxquant_evidence"},
      "input": {"shape": "long", "extensions": [".txt"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": false, "per_feature": "first"},
          "obs": {"type": "string", "required": false},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "axis": {"obs_keys": ["Raw_File"]},
        "columns": {
          "obs": [
            {"name": "Raw_File", "source": "Raw file", "required": true},
            {"name": "Experiment", "source": "Experiment"},
            {"name": "Fraction", "source": "Fraction"}
          ]
        },
        "measurements": {
          "repeated_cells": {
            "mode": "keep_best",
            "by": "PEP",
            "best": "lowest",
            "sum": ["Intensity", "MS_MS_Count"]
          },
          "primary_layer": "Intensity"
        }
      },
      "levels": {
        "peptidoform_ion": {
          "source_prefix": "evidence.",
          "axis": {"var_keys": ["ProForma_ion"]},
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "MS_MS_Count", "source": "MS/MS count", "type": "integer"},
              {"name": "Retention_Time", "source": "Retention time"},
              {"name": "Retention_Length", "source": "Retention length"},
              {
                "name": "Calibrated_Retention_Time",
                "source": "Calibrated retention time",
                "note": "Retention time after MaxQuant aligns the runs for matching between runs; equal to Retention_Time when no calibration was applied"
              },
              {
                "name": "Calibrated_Retention_Time_Start",
                "source": "Calibrated retention time start"
              },
              {
                "name": "Calibrated_Retention_Time_Finish",
                "source": "Calibrated retention time finish"
              },
              {"name": "Score", "source": "Score"},
              {"name": "PEP", "source": "PEP", "required": true},
              {
                "name": "Type",
                "source": "Type",
                "encoding_mode": "factor",
                "categories": {
                  "MSMS": 0,
                  "ISO-MSMS": 1,
                  "MULTI-MSMS": 2,
                  "ISO-SECPEP": 3,
                  "MULTI-SECPEP": 4,
                  "MULTI-MATCH": 5,
                  "MULTI-MATCH-MSMS": 6
                },
                "note": "How MaxQuant identified the evidence row: MULTI-MATCH by matching between runs, the MSMS kinds by MS/MS. Categories from the MaxQuant output-table documentation, plus MULTI-MATCH-MSMS, which reports write but the documentation omits, and ISO-SECPEP"
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "Sequence", "source": "Sequence", "required": true},
              {"name": "Modified_Sequence", "source": "Modified sequence", "required": true},
              {"name": "Modifications", "source": "Modifications", "required": true},
              {"name": "Charge", "source": "Charge", "type": "integer", "required": true},
              {"name": "Mass", "source": "Mass", "type": "number", "required": true},
              {
                "name": "Proteins",
                "source": "Proteins",
                "roles": ["fasta_accessions"],
                "inputs": ["Proteins", "Leading_Proteins", "Leading_Proteins_Legacy"],
                "how": "coalesce"
              },
              {"name": "Leading_Proteins", "source": "Leading proteins"},
              {"name": "Leading_Razor_Protein", "source": "Leading razor protein"},
              {"name": "Leading_Proteins_Legacy", "source": "Leading Proteins"},
              {"name": "Leading_Razor_Protein_Legacy", "source": "Leading Razor Protein"},
              {"name": "Razor_Protein_Group", "source": "Protein IDs", "source_prefix": "protein."},
              {
                "name": "Protein_IDs",
                "roles": ["protein_assignment"],
                "inputs": ["Razor_Protein_Group", "Proteins"],
                "how": "coalesce"
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": ["Modified_Sequence"],
                "case_sensitive": false,
                "unknown_policy": "preserve",
                "how": "proforma_sequence"
              },
              {
                "name": "ProForma_peptide",
                "inputs": ["Modified_Sequence"],
                "how": "stripped_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "Charge"],
                "how": "proforma_ion"
              },
              {"name": "Reverse", "source": "Reverse"},
              {"name": "Decoy", "source": "Decoy"},
              {"name": "Potential_Contaminant", "source": "Potential contaminant"},
              {"name": "apb_Decoy", "inputs": ["Reverse", "Decoy"], "how": "decoy", "equals": "+"},
              {
                "name": "apb_Contaminant",
                "inputs": ["Potential_Contaminant"],
                "how": "contaminant",
                "equals": "+"
              }
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "^\\((?P<nterm>[^()]*(?:\\([^()]*\\)[^()]*)*)\\)|\\((?P<residue>[^()]*(?:\\([^()]*\\)[^()]*)*)\\)",
              "token_position": "after_residue"
            }
          },
          "modification_maps": {
            "basic_modification_map": {
              "ac": "UNIMOD:1",
              "ox": "UNIMOD:35",
              "Acetyl (Protein N-term)": "UNIMOD:1",
              "Oxidation (M)": "UNIMOD:35",
              "Carbamidomethyl (C)": "UNIMOD:4"
            }
          }
        }
      }
    },
    {
      "prepare": {"how": "maxquant_wide"},
      "input": {"shape": "wide", "extensions": [".txt"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": false, "per_feature": "first"},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "sample_pattern": "(?P<sample>.+)",
        "axis": {"obs_keys": ["Experiment"]},
        "measurements": {"repeated_cells": {"mode": "same"}, "primary_layer": "Intensity"},
        "columns": {
          "var": [
            {"name": "apb_Decoy", "inputs": ["Reverse", "Decoy"], "how": "decoy", "equals": "+"},
            {
              "name": "apb_Contaminant",
              "inputs": ["Potential_Contaminant"],
              "how": "contaminant",
              "equals": "+"
            },
            {"name": "Score", "source": "Score"},
            {"name": "Reverse", "source": "Reverse"},
            {"name": "Decoy", "source": "Decoy"},
            {"name": "Potential_Contaminant", "source": "Potential contaminant"}
          ]
        }
      },
      "levels": {
        "peptidoform": {
          "source_prefix": "peptidoform.",
          "axis": {"var_keys": ["ProForma_peptidoform_unlocalized"]},
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_Type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1},
                "note": "Whether the feature was identified by MS/MS in this sample or only transferred by matching between runs"
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "ProForma_peptide", "source": "Sequence", "required": true},
              {"name": "Modifications", "source": "Modifications", "required": true},
              {
                "name": "Proteins",
                "source": "Proteins",
                "required": true,
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Protein_Groups", "source": "Protein Groups"},
              {"name": "Mass", "source": "Mass"},
              {"name": "Missed_Cleavages", "source": "Missed cleavages", "type": "integer"},
              {"name": "Charges", "source": "Charges"},
              {"name": "PEP", "source": "PEP"},
              {"name": "Delta_Score", "source": "Delta score"},
              {"name": "Retention_Time", "source": "Retention time", "type": "number"},
              {
                "name": "Calibrated_Retention_Time",
                "source": "Calibrated retention time",
                "type": "number"
              },
              {"name": "Unique_Groups", "source": "Unique (Groups)"},
              {"name": "Unique_Proteins", "source": "Unique (Proteins)"},
              {
                "name": "ProForma_peptidoform_unlocalized",
                "inputs": ["ProForma_peptide", "Modifications"],
                "case_sensitive": false,
                "unknown_policy": "preserve",
                "how": "proforma_sequence",
                "note": "Modifications names each modification with its count and candidate residues, such as '2 Oxidation (M)', never a position, so positional isomers share a row; this string identifies the row"
              }
            ]
          },
          "sequence_syntax": {
            "modification_names": {
              "parser": "embedded_site_list",
              "delimiter": ",",
              "entry_pattern": "^(?:(?P<count>\\d+) )?(?P<token>.+ \\((?P<site>[^()]+)\\))$|^Unmodified$",
              "site_base": 1
            }
          },
          "modification_maps": {
            "modification_names_map": {
              "Acetyl (Protein N-term)": "UNIMOD:1",
              "Oxidation (M)": "UNIMOD:35",
              "Carbamidomethyl (C)": "UNIMOD:4"
            }
          }
        },
        "peptide": {
          "source_prefix": "peptide.",
          "axis": {"var_keys": ["ProForma_peptide"]},
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "LFQ_Intensity",
                "source": "LFQ intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_Type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1},
                "note": "Whether the feature was identified by MS/MS in this sample or only transferred by matching between runs"
              }
            ]
          },
          "columns": {
            "var": [
              {"name": "ProForma_peptide", "source": "Sequence", "required": true},
              {
                "name": "Proteins",
                "source": "Proteins",
                "required": true,
                "roles": ["fasta_accessions"]
              },
              {
                "name": "Leading_Razor_Protein",
                "source": "Leading razor protein",
                "required": true
              },
              {
                "name": "Razor_Protein_Group",
                "source": "Protein IDs",
                "source_prefix": "protein.",
                "note": "proteinGroups.txt lists only razor evidence, so each peptide joins the one group its leading razor protein belongs to"
              },
              {
                "name": "Protein_IDs",
                "roles": ["protein_assignment"],
                "inputs": ["Razor_Protein_Group", "Leading_Razor_Protein"],
                "how": "coalesce"
              },
              {"name": "Gene_Names", "source": "Gene names"},
              {"name": "Protein_Names", "source": "Protein names"},
              {"name": "Length", "source": "Length", "type": "integer"},
              {"name": "Missed_Cleavages", "source": "Missed cleavages", "type": "integer"},
              {"name": "Mass", "source": "Mass"},
              {"name": "Charges", "source": "Charges"},
              {"name": "PEP", "source": "PEP"},
              {"name": "Start_Position", "source": "Start position"},
              {"name": "End_Position", "source": "End position"},
              {"name": "Unique_Groups", "source": "Unique (Groups)"},
              {"name": "Unique_Proteins", "source": "Unique (Proteins)"}
            ]
          }
        },
        "protein": {
          "source_prefix": "protein.",
          "axis": {"var_keys": ["Protein_IDs"]},
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "Intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "LFQ_Intensity",
                "source": "LFQ intensity {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "iBAQ",
                "source": "iBAQ {sample}",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "Identification_Type",
                "source": "Identification type {sample}",
                "encoding_mode": "factor",
                "categories": {"By MS/MS": 0, "By matching": 1},
                "note": "Whether the feature was identified by MS/MS in this sample or only transferred by matching between runs"
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Protein_IDs",
                "source": "Protein IDs",
                "required": true,
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {"name": "Majority_Protein_IDs", "source": "Majority protein IDs"},
              {"name": "Fasta_Headers", "source": "Fasta headers"},
              {"name": "Gene_Names", "source": "Gene names"},
              {"name": "Protein_Names", "source": "Protein names"},
              {"name": "Number_Of_Proteins", "source": "Number of proteins", "type": "integer"},
              {"name": "Peptides", "source": "Peptides", "type": "integer"},
              {
                "name": "Razor_Unique_Peptides",
                "source": "Razor + unique peptides",
                "type": "integer"
              },
              {"name": "Unique_Peptides", "source": "Unique peptides", "type": "integer"},
              {"name": "Sequence_Coverage_Percent", "source": "Sequence coverage [%]"},
              {"name": "Mol_Weight_kDa", "source": "Mol. weight [kDa]"},
              {"name": "Q_Value", "source": "Q-value"},
              {"name": "Only_Identified_By_Site", "source": "Only identified by site"}
            ]
          }
        }
      }
    }
  ]
}
