{
  "hierarchy": "lfq",
  "schema_version": "0.8",
  "file_version": "1",
  "software_name": "MaxQuant",
  "software_version_pattern": "^(1\\.5|1\\.6|2\\.)",
  "tables": [
    {
      "prepare": {
        "how": "maxquant_evidence"
      },
      "input": {
        "shape": "long",
        "extensions": [
          ".txt"
        ]
      },
      "base": {
        "axis": {
          "obs_keys": [
            "Raw_File"
          ]
        },
        "columns": {
          "obs": [
            {
              "name": "Raw_File",
              "source": "evidence.Raw file"
            },
            {
              "name": "Experiment",
              "source": "evidence.Experiment",
              "required": false
            },
            {
              "name": "Fraction",
              "source": "evidence.Fraction",
              "required": false
            }
          ]
        },
        "measurements": {
          "duplicates": {
            "mode": "keep_best",
            "by": "PEP",
            "best": "lowest",
            "sum": [
              "Intensity",
              "MS_MS_Count"
            ]
          },
          "primary_layer": "Intensity"
        }
      },
      "levels": {
        "ion": {
          "axis": {
            "var_keys": [
              "ProForma_ion"
            ]
          },
          "measurements": {
            "layers": [
              {
                "name": "Intensity",
                "source": "evidence.Intensity",
                "roles": [
                  "abundance"
                ],
                "missing_values": [
                  "<=0"
                ]
              },
              {
                "name": "MS_MS_Count",
                "source": "evidence.MS/MS count",
                "type": "integer"
              },
              {
                "name": "Retention_Time",
                "source": "evidence.Retention time"
              },
              {
                "name": "Score",
                "source": "evidence.Score"
              },
              {
                "name": "PEP",
                "source": "evidence.PEP",
                "required": true
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "Sequence",
                "source": "evidence.Sequence"
              },
              {
                "name": "Modified_Sequence",
                "source": "evidence.Modified sequence"
              },
              {
                "name": "Modifications",
                "source": "evidence.Modifications"
              },
              {
                "name": "Charge",
                "source": "evidence.Charge",
                "type": "integer"
              },
              {
                "name": "Mass",
                "source": "evidence.Mass",
                "type": "number"
              },
              {
                "name": "Proteins",
                "source": "evidence.Proteins",
                "roles": [
                  "fasta_accessions"
                ],
                "inputs": [
                  "Proteins",
                  "Leading_Proteins",
                  "Leading_Proteins_Legacy"
                ],
                "how": "coalesce"
              },
              {
                "name": "Leading_Proteins",
                "source": "evidence.Leading proteins",
                "required": false
              },
              {
                "name": "Leading_Razor_Protein",
                "source": "evidence.Leading razor protein",
                "required": false
              },
              {
                "name": "Leading_Proteins_Legacy",
                "source": "evidence.Leading Proteins",
                "required": false
              },
              {
                "name": "Leading_Razor_Protein_Legacy",
                "source": "evidence.Leading Razor Protein",
                "required": false
              },
              {
                "name": "Razor_Protein_Group",
                "source": "protein.Protein IDs",
                "required": false
              },
              {
                "name": "Protein_IDs",
                "roles": [
                  "protein_assignment"
                ],
                "inputs": [
                  "Razor_Protein_Group",
                  "Proteins"
                ],
                "how": "coalesce"
              },
              {
                "name": "ProForma_peptidoform",
                "inputs": [
                  "Modified_Sequence"
                ],
                "how": "proforma_sequence",
                "syntax": "vendor_sequence",
                "modification_map": "basic_modification_map",
                "case_sensitive": false,
                "unknown_policy": "preserve"
              },
              {
                "name": "ProForma_peptide",
                "inputs": [
                  "Modified_Sequence"
                ],
                "how": "stripped_sequence",
                "syntax": "vendor_sequence"
              },
              {
                "name": "ProForma_ion",
                "inputs": [
                  "ProForma_peptidoform",
                  "Charge"
                ],
                "how": "proforma_ion"
              },
              {
                "name": "Reverse",
                "source": "evidence.Reverse",
                "required": false
              },
              {
                "name": "Decoy",
                "source": "evidence.Decoy",
                "required": false
              },
              {
                "name": "Potential_Contaminant",
                "source": "evidence.Potential contaminant",
                "required": false
              },
              {
                "name": "apb_Decoy",
                "inputs": [
                  "Reverse",
                  "Decoy"
                ],
                "how": "decoy",
                "equals": "+"
              },
              {
                "name": "apb_Contaminant",
                "inputs": [
                  "Potential_Contaminant"
                ],
                "how": "contaminant",
                "equals": "+"
              }
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "^\\((?P<nterm>[^()]*(?:\\([^()]*\\)[^()]*)*)\\)|\\((?P<residue>[^()]*(?:\\([^()]*\\)[^()]*)*)\\)",
              "token_position": "after_residue"
            }
          },
          "modification_maps": {
            "basic_modification_map": [
              {
                "token": "ac",
                "accession": "UNIMOD:1"
              },
              {
                "token": "ox",
                "accession": "UNIMOD:35"
              },
              {
                "token": "Acetyl (Protein N-term)",
                "accession": "UNIMOD:1"
              },
              {
                "token": "Oxidation (M)",
                "accession": "UNIMOD:35"
              },
              {
                "token": "Carbamidomethyl (C)",
                "accession": "UNIMOD:4"
              }
            ]
          }
        }
      }
    },
    {
