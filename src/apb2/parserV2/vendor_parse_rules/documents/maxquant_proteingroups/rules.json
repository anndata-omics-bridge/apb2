{
  "schema_version": "0.4",
  "file_version": "1",
  "software_name": "MaxQuant",
  "software_version_pattern": "^(1\\.5|1\\.6|2\\.)",
  "input": {
    "shape": "wide",
    "extensions": [
      ".txt"
    ],
    "file_name": "proteinGroups.txt"
  },
  "base": {
    "axis": {
      "obs_keys": [
        "sample"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    }
  },
  "levels": {
    "protein": {
      "axis": {
        "var_keys": [
          "Protein_IDs"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity",
        "layers": [
          {
            "name": "Intensity",
            "source": "^Intensity (?P<sample>.+)$",
            "roles": [
              "abundance"
            ],
            "missing_values": [
              0
            ]
          },
          {
            "name": "LFQ_Intensity",
            "source": "^LFQ intensity (?P<sample>.+)$",
            "roles": [
              "abundance"
            ],
            "missing_values": [
              0
            ]
          },
          {
            "name": "iBAQ",
            "source": "^iBAQ (?P<sample>.+)$",
            "roles": [
              "abundance"
            ],
            "missing_values": [
              0
            ]
          }
        ]
      },
      "columns": {
        "var": [
          {
            "name": "Protein_IDs",
            "source": "Protein IDs",
            "roles": [
              "protein_assignment",
              "fasta_accessions"
            ]
          },
          {
            "name": "Majority_Protein_IDs",
            "source": "Majority protein IDs",
            "required": false
          },
          {
            "name": "Fasta_Headers",
            "source": "Fasta headers",
            "required": false
          },
          {
            "name": "Gene_Names",
            "source": "Gene names",
            "required": false
          },
          {
            "name": "Protein_Names",
            "source": "Protein names",
            "required": false
          },
          {
            "name": "Number_Of_Proteins",
            "source": "Number of proteins",
            "type": "integer",
            "required": false
          },
          {
            "name": "Peptides",
            "source": "Peptides",
            "type": "integer",
            "required": false
          },
          {
            "name": "Razor_Unique_Peptides",
            "source": "Razor + unique peptides",
            "type": "integer",
            "required": false
          },
          {
            "name": "Unique_Peptides",
            "source": "Unique peptides",
            "type": "integer",
            "required": false
          },
          {
            "name": "Sequence_Coverage_Percent",
            "source": "Sequence coverage [%]",
            "required": false
          },
          {
            "name": "Mol_Weight_kDa",
            "source": "Mol. weight [kDa]",
            "required": false
          },
          {
            "name": "Q_Value",
            "source": "Q-value",
            "required": false
          },
          {
            "name": "Score",
            "source": "Score",
            "required": false
          },
          {
            "name": "Only_Identified_By_Site",
            "source": "Only identified by site",
            "required": false
          },
          {
            "name": "Reverse",
            "source": "Reverse",
            "required": false
          },
          {
            "name": "Decoy",
            "source": "Decoy",
            "required": false
          },
          {
            "name": "Potential_Contaminant",
            "source": "Potential contaminant",
            "required": false
          }
        ]
      }
    }
  }
}
