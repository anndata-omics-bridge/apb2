{
  "schema_version": "0.11",
  "file_version": "7",
  "software_name": "WOMBAT-P",
  "software_version_pattern": "^0\\.9\\.11$",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "tables": [
    {
      "prepare": {"how": "wombat"},
      "input": {"shape": "wide", "extensions": [".csv"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        },
        "sample_pattern": "(?P<sample>.+)",
        "axis": {"obs_keys": ["sample"]},
        "measurements": {
          "primary_layer": "abundance",
          "repeated_cells": {"mode": "same"},
          "layers": [
            {
              "name": "abundance",
              "source": "abundance_{sample}",
              "roles": ["abundance"],
              "missing_values": ["<=0"],
              "missing_tokens": ["NA"]
            }
          ]
        },
        "columns": {
          "var": [
            {"name": "modified_peptide", "source": "modified_peptide"},
            {
              "name": "protein_group",
              "source": "protein_group",
              "roles": ["protein_assignment", "fasta_accessions"]
            },
            {
              "name": "ProForma_peptidoform",
              "inputs": ["modified_peptide"],
              "how": "proforma_sequence",
              "case_sensitive": false,
              "unknown_policy": "preserve"
            },
            {
              "name": "ProForma_peptide",
              "inputs": ["modified_peptide"],
              "how": "stripped_sequence"
            },
            {"name": "apb_Decoy", "how": "unmarked"},
            {
              "name": "apb_Contaminant",
              "inputs": ["protein_group"],
              "how": "contaminant",
              "prefix": "CON__",
              "separator": ";"
            }
          ]
        },
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "token_regex",
            "token_pattern": "^\\[(?P<nterm>[^\\[\\]]+)\\]-|-\\[(?P<cterm>[^\\[\\]]+)\\]$|\\[(?P<residue>[^\\[\\]]+)\\]",
            "token_position": "after_residue"
          }
        },
        "modification_map": {
          "Acetyl": "UNIMOD:1",
          "Oxidation": "UNIMOD:35",
          "Carbamidomethyl": "UNIMOD:4"
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"var_keys": ["ProForma_ion"]},
          "columns": {
            "var": [
              {"name": "charge", "source": "charge", "type": "integer"},
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "charge"],
                "how": "proforma_ion"
              }
            ]
          }
        },
        "peptidoform": {
          "forbidden_columns": ["charge"],
          "axis": {"var_keys": ["ProForma_peptidoform"]},
          "measurements": {
            "layers": [
              {
                "name": "number_of_psms",
                "source": "number_of_psms_{sample}",
                "type": "integer",
                "missing_tokens": ["NA"]
              }
            ]
          }
        }
      }
    }
  ]
}
