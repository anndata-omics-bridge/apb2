{
  "hierarchy": "lfq",
  "schema_version": "0.8",
  "file_version": "3",
  "software_name": "WOMBAT",
  "software_version_pattern": "^0\\.9\\.11$",
  "tables": [
    {
      "prepare": {
        "how": "wombat"
      },
      "input": {
        "shape": "wide",
        "extensions": [
          ".csv"
        ]
      },
      "base": {
        "axis": {
          "obs_keys": [
            "sample"
          ]
        },
        "measurements": {
          "duplicates": {
            "mode": "keep_first"
          }
        },
        "columns": {
          "var": [
            {
              "name": "modified_peptide",
              "source": "modified_peptide"
            },
            {
              "name": "protein_group",
              "source": "protein_group",
              "roles": [
                "protein_assignment",
                "fasta_accessions"
              ]
            },
            {
              "name": "ProForma_peptidoform",
              "inputs": [
                "modified_peptide"
              ],
              "how": "proforma_sequence",
              "syntax": "vendor_sequence",
              "modification_map": "basic_modification_map",
              "case_sensitive": false,
              "unknown_policy": "preserve"
            },
            {
              "name": "ProForma_peptide",
              "inputs": [
                "modified_peptide"
              ],
              "how": "stripped_sequence",
              "syntax": "vendor_sequence"
            },
            {
              "name": "apb_Decoy",
              "how": "decoy"
            },
            {
              "name": "apb_Contaminant",
              "inputs": [
                "protein_group"
              ],
              "how": "contaminant",
              "prefix": "CON__",
              "separator": ";"
            }
          ]
        },
        "sequence_syntax": {
          "vendor_sequence": {
            "parser": "token_regex",
            "token_pattern": "^\\[([^\\[\\]]+)\\]-|-\\[([^\\[\\]]+)\\]$|\\[([^\\[\\]]+)\\]",
            "token_position": "after_residue"
          }
        },
        "modification_maps": {
          "basic_modification_map": [
            {
              "token": "Acetyl",
              "accession": "UNIMOD:1"
            },
            {
              "token": "Oxidation",
              "accession": "UNIMOD:35"
            },
            {
              "token": "Carbamidomethyl",
              "accession": "UNIMOD:4"
            }
          ]
        }
      },
      "levels": {
        "ion": {
          "axis": {
            "var_keys": [
              "ProForma_ion"
            ]
          },
          "measurements": {
            "primary_layer": "Abundance",
            "layers": [
              {
                "name": "Abundance",
                "source": "^abundance_(?P<sample>.+)$",
                "roles": [
                  "abundance"
                ],
                "missing_values": [
                  "<=0"
                ]
              }
            ]
          },
          "columns": {
            "var": [
              {
                "name": "charge",
                "source": "charge",
                "type": "integer"
              },
              {
                "name": "ProForma_ion",
                "inputs": [
                  "ProForma_peptidoform",
                  "charge"
                ],
                "how": "proforma_ion"
              }
            ]
          }
        },
        "peptidoform": {
          "axis": {
            "var_keys": [
              "ProForma_peptidoform"
            ]
          },
          "measurements": {
            "primary_layer": "Abundance",
            "layers": [
              {
                "name": "Abundance",
                "source": "^abundance_(?P<sample>.+)$",
                "roles": [
                  "abundance"
                ],
                "missing_values": [
                  "<=0"
                ]
              },
              {
                "name": "Number_Of_Psms",
                "source": "^number_of_psms_(?P<sample>.+)$",
                "type": "integer",
                "required": false
              }
            ]
          }
        }
      }
    }
  ]
}
