{
  "schema_version": "0.4",
  "file_version": "1",
  "software_name": "MaxQuant",
  "software_version_pattern": "^(1\\.5|1\\.6|2\\.)",
  "input": {
    "shape": "wide",
    "extensions": [
      ".txt"
    ],
    "file_name": "peptides.txt"
  },
  "base": {
    "axis": {
      "obs_keys": [
        "sample"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    }
  },
  "levels": {
    "peptide": {
      "axis": {
        "var_keys": [
          "ProForma_peptide"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity",
        "layers": [
          {
            "name": "Intensity",
            "source": "^Intensity (?P<sample>.+)$",
            "roles": [
              "abundance"
            ],
            "missing_values": [
              0
            ]
          },
          {
            "name": "LFQ_Intensity",
            "source": "^LFQ intensity (?P<sample>.+)$",
            "missing_values": [
              0
            ]
          }
        ]
      },
      "columns": {
        "var": [
          {
            "name": "ProForma_peptide",
            "source": "Sequence"
          },
          {
            "name": "Proteins",
            "source": "Proteins",
            "roles": [
              "fasta_accessions"
            ]
          },
          {
            "name": "Leading_Razor_Protein",
            "source": "Leading razor protein",
            "roles": [
              "protein_assignment"
            ]
          },
          {
            "name": "Gene_Names",
            "source": "Gene names",
            "required": false
          },
          {
            "name": "Protein_Names",
            "source": "Protein names",
            "required": false
          },
          {
            "name": "Length",
            "source": "Length",
            "type": "integer",
            "required": false
          },
          {
            "name": "Missed_Cleavages",
            "source": "Missed cleavages",
            "type": "integer",
            "required": false
          },
          {
            "name": "Mass",
            "source": "Mass",
            "required": false
          },
          {
            "name": "Charges",
            "source": "Charges",
            "required": false
          },
          {
            "name": "PEP",
            "source": "PEP",
            "required": false
          },
          {
            "name": "Score",
            "source": "Score",
            "required": false
          },
          {
            "name": "Start_Position",
            "source": "Start position",
            "required": false
          },
          {
            "name": "End_Position",
            "source": "End position",
            "required": false
          },
          {
            "name": "Unique_Groups",
            "source": "Unique (Groups)",
            "required": false
          },
          {
            "name": "Unique_Proteins",
            "source": "Unique (Proteins)",
            "required": false
          }
        ]
      }
    }
  }
}
