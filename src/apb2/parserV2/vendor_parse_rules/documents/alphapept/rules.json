{
  "schema_version": "0.11",
  "file_version": "5",
  "software_name": "AlphaPept",
  "software_version_pattern": "^0\\.5\\.",
  "hierarchy": "lfq",
  "parameter_file": "required",
  "tables": [
    {
      "input": {"shape": "long", "extensions": [".csv"]},
      "base": {
        "defaults": {
          "var": {"type": "string", "required": true, "per_feature": "first"},
          "obs": {"type": "string", "required": true},
          "layers": {"encoding_mode": "numeric", "type": "number", "required": false}
        }
      },
      "levels": {
        "peptidoform_ion": {
          "axis": {"obs_keys": ["shortname"], "var_keys": ["ProForma_ion"]},
          "measurements": {
            "primary_layer": "ms1_int_sum_apex_dn",
            "repeated_cells": {"mode": "keep_best", "by": "score", "best": "highest"},
            "layers": [
              {
                "name": "ms1_int_sum_apex_dn",
                "source": "ms1_int_sum_apex_dn",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "ms1_int_sum_apex",
                "source": "ms1_int_sum_apex",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "ms1_int_sum_area",
                "source": "ms1_int_sum_area",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "ms1_int_max_apex",
                "source": "ms1_int_max_apex",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {
                "name": "ms1_int_max_area",
                "source": "ms1_int_max_area",
                "roles": ["abundance"],
                "missing_values": ["<=0"]
              },
              {"name": "score", "source": "score"},
              {"name": "q_value", "source": "q_value"},
              {"name": "rt", "source": "rt"},
              {"name": "rt_start", "source": "rt_start"},
              {"name": "rt_end", "source": "rt_end"},
              {"name": "rt_calib", "source": "rt_calib"},
              {"name": "fwhm", "source": "fwhm"},
              {"name": "n_fragments_matched", "source": "n_fragments_matched"}
            ]
          },
          "columns": {
            "obs": [
              {"name": "shortname", "source": "shortname"},
              {"name": "sample_group", "source": "sample_group"},
              {"name": "filename", "source": "filename"}
            ],
            "var": [
              {"name": "sequence", "source": "sequence"},
              {"name": "sequence_naked", "source": "sequence_naked"},
              {"name": "charge", "source": "charge", "type": "integer"},
              {"name": "precursor", "source": "precursor"},
              {"name": "protein", "source": "protein"},
              {
                "name": "protein_group",
                "source": "protein_group",
                "roles": ["protein_assignment", "fasta_accessions"]
              },
              {
                "name": "n_possible_proteins",
                "source": "n_possible_proteins",
                "type": "integer",
                "required": false
              },
              {"name": "decoy", "source": "decoy", "type": "boolean"},
              {
                "name": "ProForma_peptidoform",
                "inputs": ["sequence"],
                "how": "proforma_sequence",
                "case_sensitive": true,
                "unknown_policy": "preserve"
              },
              {"name": "ProForma_peptide", "inputs": ["sequence"], "how": "stripped_sequence"},
              {
                "name": "ProForma_ion",
                "inputs": ["ProForma_peptidoform", "charge"],
                "how": "proforma_ion"
              },
              {"name": "apb_Decoy", "inputs": ["decoy"], "how": "decoy", "equals": "true"},
              {"name": "apb_Contaminant", "how": "unmarked"}
            ]
          },
          "sequence_syntax": {
            "vendor_sequence": {
              "parser": "token_regex",
              "token_pattern": "^(?P<nterm>a)|(?P<residue>[a-z]+)",
              "token_position": "before_residue",
              "marker_pattern": "_decoy$"
            }
          },
          "modification_map": {"c": "UNIMOD:4", "ox": "UNIMOD:35", "a": "UNIMOD:1"}
        }
      }
    }
  ]
}
