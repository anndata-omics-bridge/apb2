{
  "schema_version": "0.3",
  "file_version": "2",
  "software_name": "AlphaPept",
  "software_version_pattern": "^0\\.5\\.",
  "input": {
    "shape": "long",
    "extensions": [
      ".csv"
    ]
  },
  "base": {
    "axis": {
      "obs_keys": [
        "Raw_File"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "keep_first"
      }
    },
    "columns": {
      "obs": {
        "select": {
          "Raw_File": "shortname",
          "Sample_Group": "sample_group",
          "File_Path": "filename"
        }
      }
    },
    "modifications": {
      "source_column": "sequence",
      "parser": "token_regex",
      "token_pattern": "[a-z]+",
      "token_position": "before_residue",
      "case_sensitive": true,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "c",
          "accession": "UNIMOD:4"
        },
        {
          "token": "ox",
          "accession": "UNIMOD:35"
        },
        {
          "token": "a",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity",
        "layers": [
          {
            "name": "Intensity",
            "source": "ms1_int_sum_apex_dn"
          },
          {
            "name": "MS1_Int_Sum_Apex",
            "source": "ms1_int_sum_apex"
          },
          {
            "name": "MS1_Int_Sum_Area",
            "source": "ms1_int_sum_area"
          },
          {
            "name": "MS1_Int_Max_Apex",
            "source": "ms1_int_max_apex"
          },
          {
            "name": "MS1_Int_Max_Area",
            "source": "ms1_int_max_area"
          },
          {
            "name": "Score",
            "source": "score"
          },
          {
            "name": "Q_Value",
            "source": "q_value"
          },
          {
            "name": "Retention_Time",
            "source": "rt"
          },
          {
            "name": "FWHM",
            "source": "fwhm"
          },
          {
            "name": "N_Fragments_Matched",
            "source": "n_fragments_matched"
          }
        ]
      },
      "columns": {
        "var": {
          "select": {
            "Sequence": "sequence",
            "Sequence_Naked": "sequence_naked",
            "Charge": "charge",
            "Precursor": "precursor",
            "Protein": "protein",
            "Protein_Group": "protein_group",
            "Decoy": "decoy"
          },
          "types": {
            "Charge": "integer",
            "Decoy": "boolean"
          },
          "computed": [
            {
              "name": "ProForma_peptidoform",
              "inputs": [
                "Sequence"
              ],
              "how": "proforma_sequence"
            },
            {
              "name": "ProForma_peptide",
              "inputs": [
                "Sequence"
              ],
              "how": "stripped_sequence"
            },
            {
              "name": "ProForma_ion",
              "inputs": [
                "ProForma_peptidoform",
                "Charge"
              ],
              "how": "proforma_ion"
            }
          ]
        }
      },
      "column_roles": {
        "protein_assignment": "Protein_Group",
        "fasta_accessions": "Protein_Group"
      }
    }
  }
}
