{
  "schema_version": "0.4",
  "file_version": "1",
  "software_name": "MaxQuant",
  "software_version_pattern": "^(1\\.5|1\\.6|2\\.)",
  "input": {
    "shape": "wide",
    "extensions": [
      ".txt"
    ],
    "file_name": "modificationSpecificPeptides.txt"
  },
  "base": {
    "axis": {
      "obs_keys": [
        "sample"
      ]
    },
    "measurements": {
      "duplicates": {
        "mode": "error"
      }
    }
  },
  "levels": {
    "peptidoform": {
      "axis": {
        "var_keys": [
          "ProForma_peptide",
          "Modifications"
        ]
      },
      "measurements": {
        "primary_layer": "Intensity",
        "layers": [
          {
            "name": "Intensity",
            "source": "^Intensity (?P<sample>.+)$",
            "roles": [
              "abundance"
            ],
            "missing_values": [
              0
            ]
          }
        ]
      },
      "columns": {
        "var": [
          {
            "name": "ProForma_peptide",
            "source": "Sequence"
          },
          {
            "name": "Modifications",
            "source": "Modifications"
          },
          {
            "name": "Proteins",
            "source": "Proteins",
            "roles": [
              "protein_assignment",
              "fasta_accessions"
            ]
          },
          {
            "name": "Protein_Groups",
            "source": "Protein Groups",
            "required": false
          },
          {
            "name": "Mass",
            "source": "Mass",
            "required": false
          },
          {
            "name": "Missed_Cleavages",
            "source": "Missed cleavages",
            "type": "integer",
            "required": false
          },
          {
            "name": "Charges",
            "source": "Charges",
            "required": false
          },
          {
            "name": "PEP",
            "source": "PEP",
            "required": false
          },
          {
            "name": "Score",
            "source": "Score",
            "required": false
          },
          {
            "name": "Delta_Score",
            "source": "Delta score",
            "required": false
          },
          {
            "name": "Retention_Time",
            "source": "Retention time",
            "required": false
          },
          {
            "name": "Unique_Groups",
            "source": "Unique (Groups)",
            "required": false
          },
          {
            "name": "Unique_Proteins",
            "source": "Unique (Proteins)",
            "required": false
          },
          {
            "name": "Reverse",
            "source": "Reverse",
            "required": false
          },
          {
            "name": "Decoy",
            "source": "Decoy",
            "required": false
          },
          {
            "name": "Potential_Contaminant",
            "source": "Potential contaminant",
            "required": false
          }
        ]
      }
    }
  }
}
