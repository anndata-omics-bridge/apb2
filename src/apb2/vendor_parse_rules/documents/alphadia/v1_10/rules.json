{
  "schema_version": "0.2",
  "file_version": "2",
  "software_name": "AlphaDIA",
  "software_version_pattern": "^1\\.10(?:\\.|-|$)",
  "input": {
    "shape": "wide"
  },
  "base": {
    "axis": {
      "obs_keys": [
        "sample"
      ],
      "duplicates": {
        "mode": "keep_first"
      }
    },
    "modifications": {
      "parser": "site_list",
      "sequence_column": "sequence",
      "modification_column": "mods",
      "site_column": "mod_sites",
      "delimiter": ";",
      "site_base": 1,
      "case_sensitive": false,
      "unknown_policy": "preserve",
      "output_column": "proforma_sequence",
      "map": [
        {
          "token": "Carbamidomethyl@C",
          "accession": "UNIMOD:4"
        },
        {
          "token": "Oxidation@M",
          "accession": "UNIMOD:35"
        },
        {
          "token": "Acetyl@Protein_N-term",
          "accession": "UNIMOD:1"
        }
      ]
    }
  },
  "levels": {
    "ion": {
      "axis": {
        "var_keys": [
          "ProForma_ion"
        ],
        "x_layer": "Intensity"
      },
      "columns": {
        "var": {
          "select": {
            "Sequence": "sequence",
            "Charge": "charge",
            "Mods": "mods",
            "Mod_Sites": "mod_sites",
            "Genes": "genes",
            "Decoy": "decoy"
          },
          "types": {
            "Charge": "integer",
            "Decoy": "boolean"
          },
          "computed": [
            {
              "name": "ProForma_peptidoform",
              "inputs": [
                "Sequence"
              ],
              "how": "proforma_sequence"
            },
            {
              "name": "ProForma_peptide",
              "inputs": [
                "Sequence"
              ],
              "how": "stripped_sequence"
            },
            {
              "name": "ProForma_ion",
              "inputs": [
                "ProForma_peptidoform",
                "Charge"
              ],
              "how": "proforma_ion"
            }
          ]
        }
      },
      "column_roles": {
        "protein_assignment": "Genes"
      },
      "layers": [
        {
          "name": "Intensity",
          "source": "^(?P<sample>(?!(?:mod_seq_charge_hash|genes|decoy|mods|mod_sites|sequence|charge|proteins|pg)$).+)$",
          "missing_values": [
            0
          ]
        }
      ]
    }
  }
}
